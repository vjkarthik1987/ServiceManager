<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= appName %></title><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= appName %></title><link rel="stylesheet" href="/css/app.css"></head>
<body class="setup-page">
  <main class="setup-shell single-setup-shell">
    <section class="card setup-card">
      <p class="eyebrow">Account recovery</p>
      <h2>Forgot password</h2>
      <p class="muted">Enter your account details. For privacy, the response is the same whether or not the email exists.</p>
      <% if (errorMessage) { %><div class="alert error"><%= errorMessage %></div><% } %>
      <% if (successMessage) { %><div class="alert success"><%= successMessage %></div><% } %>
      <form class="form" method="post" action="<%= action %>">
        <% if (isAdmin) { %><label><span>Tenant</span><input name="tenant" required value="<%= form.tenant || '' %>" placeholder="suntec"></label><% } %>
        <label><span>Email</span><input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="email"></label>
        <button class="btn primary full" type="submit">Send reset link</button>
      </form>
      <a class="text-link" href="<%= backUrl %>">Back to sign in</a>
    </section>
  </main>
</body>
</html>
