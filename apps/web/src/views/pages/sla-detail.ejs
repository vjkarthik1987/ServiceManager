<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= appName %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body>
    <% const timeLabel = (value, unit) => unit === 'none' || value === null || value === undefined ? 'NA' : `${value} ${String(unit || '').replace('_', ' ')}`; %>
    <div class="app-shell">
      <%- include('../partials/sidebar') %>
      <main class="main">
        <%- include('../partials/topbar', { organization }) %>

        <section class="page-head unified-page-head">
          <div>
            <p class="eyebrow">SLA policy rules</p>
            <h2><%= slaPolicy.name %></h2>
            <p><%= slaPolicy.description %></p>
          </div>
          <div class="actions">
            <a class="btn secondary" href="/admin/sla">Back to SLA Studio</a>
            <button class="btn secondary" type="button" data-open-modal="editPolicyModal">Edit policy</button>
            <button class="btn primary" type="button" data-open-modal="ruleModal">Add rule</button>
          </div>
        </section>

        <section class="metrics">
          <article class="metric card"><span>Rules</span><strong><%= (slaPolicy.rules || []).length %></strong><p>Severity or priority based</p></article>
          <article class="metric card"><span>Support window</span><strong class="metric-word"><%= String(slaPolicy.supportWindow || 'business_hours').replace('_', ' ') %></strong><p>Policy-level window</p></article>
          <article class="metric card"><span>Clock start</span><strong class="metric-word"><%= String(slaPolicy.clockStartTrigger || 'severity_selected').replace('_', ' ') %></strong><p>When the timer begins</p></article>
          <article class="metric card"><span>Clients</span><strong><%= (clients || []).filter((client) => String(client.defaultSlaPolicyId || '') === String(slaPolicy._id) || (client.familySlaAssignments || []).some((assignment) => assignment.isActive !== false && String(assignment.slaPolicyId || '') === String(slaPolicy._id))).length %></strong><p>Default or family assignment</p></article>
        </section>

        <section class="card pad">
          
            <div class="section-head">
              <div>
                <p class="eyebrow">Commitment matrix</p>
                <h3>Rules</h3>
              </div>
              <button class="btn secondary small" type="button" data-open-modal="ruleModal">Add / replace rule</button>
            </div>

            <% if (!(slaPolicy.rules || []).length) { %>
              <div class="empty-box">
                <strong>No rules yet.</strong>
                <p>Add rules based on severity or priority. Adding a rule for the same severity/priority replaces the old one.</p>
              </div>
            <% } else { %>
              <div class="sla-rule-list">
                <% slaPolicy.rules.forEach((rule) => { %>
                  <% const basisItem = rule.ruleBasis === 'priority' ? rule.priority : rule.severity; %>
                  <article class="sla-rule-row">
                    <div>
                      <span class="code-badge"><%= basisItem ? basisItem.code : rule.ruleBasis %></span>
                    </div>
                    <div>
                      <strong><%= basisItem ? `${basisItem.name}` : 'Unmapped rule' %></strong>
                      <p><%= rule.ruleBasis === 'priority' ? 'Priority-based' : 'Severity-based' %> · <%= rule.clockType.replace('_', ' ') %></p>
                    </div>
                    <div><span>Response</span><strong><%= timeLabel(rule.responseTimeValue, rule.responseTimeUnit) %></strong></div>
                    <div><span>Resolution</span><strong><%= timeLabel(rule.resolutionTimeValue, rule.resolutionTimeUnit) %></strong></div>
                    <div><span>Update</span><strong><%= timeLabel(rule.updateFrequencyValue, rule.updateFrequencyUnit) %></strong></div>
                  </article>
                  <% if (rule.notes) { %><p class="rule-note"><%= rule.notes %></p><% } %>
                <% }) %>
              </div>
            <% } %>
          <div class="plain-applicability"><p><strong>Applicability:</strong> Clock starts by policy trigger, usually when severity is selected. L2/L3 and environment applicability are stored on the policy and used when the SLA engine is added.</p></div>
        </section>
              <%- include('../partials/footer', { organization }) %>
      </main>
    </div>


    <dialog class="modal" id="editPolicyModal">
      <form method="post" action="/admin/sla/<%= slaPolicy._id %>/edit" class="modal-card form compact-form">
        <div class="modal-head"><div><p class="eyebrow">Edit SLA</p><h3><%= slaPolicy.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div>
        <label><span>Name</span><input name="name" value="<%= slaPolicy.name %>" required /></label>
        <label><span>Description</span><textarea name="description" rows="3" required><%= slaPolicy.description %></textarea></label>
        <div class="two-col"><label><span>Support window</span><select name="supportWindow"><option value="business_hours" <%= slaPolicy.supportWindow === 'business_hours' ? 'selected' : '' %>>Business hours</option><option value="24x7" <%= slaPolicy.supportWindow === '24x7' ? 'selected' : '' %>>24x7</option><option value="mixed" <%= slaPolicy.supportWindow === 'mixed' ? 'selected' : '' %>>Mixed</option></select></label><label><span>Status</span><select name="status"><option value="active" <%= slaPolicy.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= slaPolicy.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></label></div>
        <div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary" type="submit">Save policy</button></div>
      </form>
    </dialog>

    <dialog class="modal wide" id="ruleModal">
      <form method="post" action="/admin/sla/<%= slaPolicy._id %>/rules" class="modal-card form compact-form">
        <div class="modal-head">
          <div>
            <p class="eyebrow">Add SLA rule</p>
            <h3>Severity or priority commitment</h3>
          </div>
          <button class="icon-btn" type="button" data-close-modal aria-label="Close">×</button>
        </div>

        <div class="two-col">
          <label>
            <span>Rule basis</span>
            <select name="ruleBasis" data-rule-basis>
              <option value="severity">Severity</option>
              <option value="priority">Priority</option>
            </select>
          </label>
          <label data-severity-field>
            <span>Severity</span>
            <select name="severityId">
              <% severities.forEach((severity) => { %><option value="<%= severity._id %>"><%= severity.code %> - <%= severity.name %></option><% }) %>
            </select>
          </label>
          <label data-priority-field hidden>
            <span>Priority</span>
            <select name="priorityId">
              <% priorities.forEach((priority) => { %><option value="<%= priority._id %>"><%= priority.code %> - <%= priority.name %></option><% }) %>
            </select>
          </label>
        </div>

        <div class="two-col">
          <label><span>Response value</span><input name="responseTimeValue" type="number" step="0.5" min="0" placeholder="1" /></label>
          <label><span>Response unit</span><select name="responseTimeUnit"><option value="minutes">minutes</option><option value="hours">hours</option><option value="business_hours">business hours</option><option value="days">days</option><option value="business_days">business days</option><option value="none">NA</option></select></label>
        </div>

        <div class="two-col">
          <label><span>Resolution value</span><input name="resolutionTimeValue" type="number" step="0.5" min="0" placeholder="24" /></label>
          <label><span>Resolution unit</span><select name="resolutionTimeUnit"><option value="hours">hours</option><option value="business_hours">business hours</option><option value="days">days</option><option value="business_days">business days</option><option value="minutes">minutes</option><option value="none">NA</option></select></label>
        </div>

        <div class="two-col">
          <label><span>Update frequency value</span><input name="updateFrequencyValue" type="number" step="0.5" min="0" placeholder="4" /></label>
          <label><span>Update frequency unit</span><select name="updateFrequencyUnit"><option value="hours">hours</option><option value="business_hours">business hours</option><option value="daily">daily</option><option value="twice_daily">twice daily</option><option value="periodic">periodic</option><option value="none">NA</option></select></label>
        </div>

        <label><span>Clock type</span><select name="clockType"><option value="working_hours">Working hours</option><option value="calendar">Calendar time</option></select></label>
        <label><span>Notes</span><input name="notes" placeholder="Every 4 hours, if required" /></label>

        <div class="modal-actions">
          <button class="btn secondary" type="button" data-close-modal>Cancel</button>
          <button class="btn primary" type="submit">Save rule</button>
        </div>
      </form>
    </dialog>

    <script src="/js/app.js"></script>
  </body>
</html>
