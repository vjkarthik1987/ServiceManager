<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %> · <%= appName %></title><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %> · <%= appName %></title><link rel="stylesheet" href="/css/app.css" /></head>
<body><div class="app-shell"><%- include('../partials/sidebar', { portal: 'admin' }) %><main class="main"><%- include('../partials/topbar', { organization }) %>
<section class="page-head unified-page-head thin-head"><div><p class="eyebrow">Product operating map</p><h2>Products & Modules</h2><p>Define products and the modules that can be enabled for clients.</p></div><div class="actions"><button class="btn primary" type="button" data-open-modal="productModal">Add product</button><button class="btn secondary" type="button" data-open-modal="moduleModal" <%= products.length ? '' : 'disabled' %>>Add module</button><button class="btn secondary" type="button" data-open-modal="bulkModuleModal" <%= products.length ? '' : 'disabled' %>>Quick add modules</button><form method="post" action="/config/seed"><input type="hidden" name="next" value="/admin/products-modules" /><button class="btn secondary" type="submit">Seed defaults</button></form></div></section>
<section class="card client-table-card"><div class="table-wrap"><table class="clean-table compact-table product-module-table"><thead><tr><th>Product / Module</th><th>Code</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach((product) => { %><tr class="family-row"><td><strong><%= product.name %></strong><small><%= (product.modules || []).length %> modules</small></td><td><%= product.code %></td><td><%= product.description %></td><td><%= product.status %></td><td><div class="table-actions"><button class="table-link-button" type="button" data-open-modal="editProduct_<%= product._id %>">Edit</button><form method="post" action="/config/products/<%= product._id %>/edit" class="inline-action-form"><input type="hidden" name="code" value="<%= product.code %>"><input type="hidden" name="name" value="<%= product.name %>"><input type="hidden" name="description" value="<%= product.description %>"><input type="hidden" name="status" value="<%= product.status === 'active' ? 'inactive' : 'active' %>"><button class="table-link-button <%= product.status === 'active' ? 'danger-text' : '' %>" type="submit"><%= product.status === 'active' ? 'Deactivate' : 'Reactivate' %></button></form></div></td></tr><% (product.modules || []).forEach((module) => { %><tr class="module-row"><td class="module-name-cell"><span class="tree-line"></span><strong><%= module.name %></strong></td><td><%= module.code %></td><td><%= module.description %></td><td><%= module.status %></td><td><button class="table-link-button" type="button" data-open-modal="editModule_<%= module._id %>">Edit</button></td></tr><% }) %><% }) %><% if (!products.length) { %><tr><td colspan="5"><div class="empty-box"><strong>No products yet.</strong><p>Add your first product, then add modules under it.</p></div></td></tr><% } %></tbody></table></div></section><%- include('../partials/footer', { organization }) %></main></div>
<dialog class="modal" id="productModal"><form method="post" action="/config/products" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Add product</p><h3>Product</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" placeholder="XELERATE" /></label><label><span>Name</span><input name="name" required /></label></div><label><span>Description</span><textarea name="description" required rows="3"></textarea></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save product</button></div></form></dialog>
<dialog class="modal" id="moduleModal"><form method="post" action="/config/modules" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Add module</p><h3>Module</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><label><span>Product</span><select name="productId" required><% products.forEach((product) => { %><option value="<%= product._id %>"><%= product.name %></option><% }) %></select></label><div class="two-col narrow"><label><span>Code</span><input name="code" /></label><label><span>Name</span><input name="name" required /></label></div><label><span>Description</span><textarea name="description" required rows="3"></textarea></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save module</button></div></form></dialog>
<dialog class="modal" id="bulkModuleModal"><form method="post" action="/config/modules/bulk" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Quick add modules</p><h3>Add several modules at once</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><label><span>Product</span><select name="productId" required><% products.filter((product) => product.status === 'active').forEach((product) => { %><option value="<%= product._id %>"><%= product.name %></option><% }) %></select></label><label><span>Module names</span><textarea name="names" rows="8" required placeholder="Billing
Pricing
Customer Management
Deal Management"></textarea><small class="field-hint">Enter one per line or separate names with commas. Existing modules are skipped.</small></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary" type="submit">Add modules</button></div></form></dialog>
<% products.forEach((product) => { %><dialog class="modal" id="editProduct_<%= product._id %>"><form method="post" action="/config/products/<%= product._id %>/edit" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Edit product</p><h3><%= product.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" value="<%= product.code %>" /></label><label><span>Name</span><input name="name" value="<%= product.name %>" required /></label></div><label><span>Description</span><textarea name="description" required rows="3"><%= product.description %></textarea></label><label><span>Status</span><select name="status"><option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save</button></div></form></dialog><% (product.modules || []).forEach((module) => { %><dialog class="modal" id="editModule_<%= module._id %>"><form method="post" action="/config/modules/<%= module._id %>/edit" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Edit module</p><h3><%= module.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" value="<%= module.code %>" /></label><label><span>Name</span><input name="name" value="<%= module.name %>" required /></label></div><label><span>Description</span><textarea name="description" required rows="3"><%= module.description %></textarea></label><label><span>Status</span><select name="status"><option value="active" <%= module.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= module.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save</button></div></form></dialog><% }) %><% }) %>
<script src="/js/app.js"></script></body></html>
