<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= appName %></title><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= appName %></title><link rel="stylesheet" href="/css/app.css"></head>
<body><div class="app-shell"><%- include('../partials/sidebar', { portal: 'admin' }) %><main class="main"><%- include('../partials/topbar', { organization }) %>
<section class="page-head unified-page-head thin-head"><div><p class="eyebrow">Operating geography</p><h2>Regions & Subregions</h2><p>Define broad operating regions and optional subregions. Each can provide a preferred timezone for client context.</p></div><div class="actions region-page-actions"><button class="btn primary" type="button" data-open-modal="regionModal">Add region</button><button class="btn secondary" type="button" data-open-modal="subregionModal" <%= regions.length ? '' : 'disabled' %>>Add subregion</button><details class="action-menu"><summary class="btn secondary">More</summary><div class="action-menu-panel"><form method="post" action="/config/seed"><input type="hidden" name="next" value="/admin/regions"><button class="menu-action" type="submit">Seed default geography</button></form></div></details></div></section>
<section class="config-anchor-row card pad compact-anchor-row"><a href="/admin/sla">SLA Policies</a><a href="/admin/severities-priorities">Severities & Priorities</a><a href="/admin/products-modules">Products & Modules</a><a class="active-soft" href="/admin/regions">Regions & Subregions</a><a href="/admin/environments">Environments</a></section>
<section class="card client-table-card"><div class="section-head"><div><p class="eyebrow">Geography library</p><h3>Configured regions</h3></div><button class="btn secondary small" type="button" data-open-modal="regionModal">Add</button></div><div class="table-wrap"><table class="clean-table compact-table"><thead><tr><th>Code</th><th>Region</th><th>Preferred timezone</th><th>Subregions</th><th>Status</th><th></th></tr></thead><tbody>
<% regions.forEach((region) => { const children=(subregions||[]).filter((s)=>String(s.regionId)===String(region._id)); %><tr><td><span class="code-badge"><%= region.code %></span></td><td><strong><%= region.name %></strong><small><%= region.description %></small></td><td><%= region.timezone %></td><td><%= children.length %></td><td><span class="inline-status"><span class="status-dot <%= region.status==='active'?'active':'' %>"></span><span><%= region.status %></span></span></td><td><button class="table-link-button" type="button" data-open-modal="editRegion<%= region._id %>">Edit</button></td></tr><% }) %>
<% if(!regions.length){ %><tr><td colspan="6"><div class="empty-box">No regions yet. Add a region first.</div></td></tr><% } %></tbody></table></div></section>
<div class="geography-layer-divider"><span>Optional geography layer</span><small>Add subregions only where a region needs a more specific operating layer.</small></div><section class="card client-table-card geography-subregion-card"><div class="section-head"><div><p class="eyebrow">Optional layer</p><h3>Subregions</h3></div><button class="btn secondary small" type="button" data-open-modal="subregionModal" <%= regions.length ? '' : 'disabled' %>>Add</button></div><div class="table-wrap"><table class="clean-table compact-table"><thead><tr><th>Code</th><th>Subregion</th><th>Region</th><th>Preferred timezone</th><th>Status</th><th></th></tr></thead><tbody>
<% (subregions||[]).forEach((subregion)=>{ const parent=regions.find((r)=>String(r._id)===String(subregion.regionId)); %><tr><td><span class="code-badge"><%= subregion.code %></span></td><td><strong><%= subregion.name %></strong><small><%= subregion.description || 'Optional client geography layer' %></small></td><td><%= parent?.name || '—' %></td><td><%= subregion.timezone || parent?.timezone || '—' %></td><td><span class="inline-status"><span class="status-dot <%= subregion.status==='active'?'active':'' %>"></span><span><%= subregion.status %></span></span></td><td><button class="table-link-button" type="button" data-open-modal="editSubregion<%= subregion._id %>">Edit</button></td></tr><% }) %>
<% if(!(subregions||[]).length){ %><tr><td colspan="6"><div class="empty-box">No subregions yet. This layer is optional.</div></td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer', { organization }) %></main></div>
<dialog class="modal" id="regionModal"><form method="post" action="/config/regions" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Add region</p><h3>Region</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" minlength="2" maxlength="20" required placeholder="AFRICA"></label><label><span>Name</span><input name="name" required placeholder="Africa"></label></div><label><span>Preferred timezone</span><select name="timezone" required data-timezone-select data-selected-timezone=""><option value="">Choose timezone</option></select><small class="muted">Search by city name in the list. This becomes the default timezone when no subregion is selected.</small></label><label><span>Description</span><textarea name="description" minlength="2" required rows="3"></textarea></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save region</button></div></form></dialog>
<dialog class="modal" id="subregionModal"><form method="post" action="/config/subregions" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Add subregion</p><h3>Optional subregion</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><label><span>Region</span><select name="regionId" required><option value="">Choose region</option><% regions.forEach((region)=>{ %><option value="<%= region._id %>"><%= region.name %></option><% }) %></select></label><div class="two-col narrow"><label><span>Code</span><input name="code" minlength="2" maxlength="20" required placeholder="SA"></label><label><span>Name</span><input name="name" required placeholder="South Africa"></label></div><label><span>Preferred timezone <small>(optional)</small></span><select name="timezone" data-timezone-select data-selected-timezone=""><option value="">Use region timezone</option></select></label><label><span>Description <small>(optional)</small></span><textarea name="description" rows="3"></textarea></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save subregion</button></div></form></dialog>
<% regions.forEach((region)=>{ %><dialog class="modal" id="editRegion<%= region._id %>"><form method="post" action="/config/regions/<%= region._id %>/edit" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Edit region</p><h3><%= region.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" value="<%= region.code %>" required></label><label><span>Name</span><input name="name" value="<%= region.name %>" required></label></div><label><span>Preferred timezone</span><select name="timezone" required data-timezone-select data-selected-timezone="<%= region.timezone %>"><option value="<%= region.timezone %>"><%= region.timezone %></option></select></label><label><span>Description</span><textarea name="description" rows="3" required><%= region.description %></textarea></label><label><span>Status</span><select name="status"><option value="active" <%= region.status==='active'?'selected':'' %>>Active</option><option value="inactive" <%= region.status==='inactive'?'selected':'' %>>Inactive</option></select></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save</button></div></form></dialog><% }) %>
<% (subregions||[]).forEach((subregion)=>{ %><dialog class="modal" id="editSubregion<%= subregion._id %>"><form method="post" action="/config/subregions/<%= subregion._id %>/edit" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Edit subregion</p><h3><%= subregion.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><label><span>Region</span><select name="regionId" required><% regions.forEach((region)=>{ %><option value="<%= region._id %>" <%= String(region._id)===String(subregion.regionId)?'selected':'' %>><%= region.name %></option><% }) %></select></label><div class="two-col narrow"><label><span>Code</span><input name="code" value="<%= subregion.code %>" required></label><label><span>Name</span><input name="name" value="<%= subregion.name %>" required></label></div><label><span>Preferred timezone</span><select name="timezone" data-timezone-select data-selected-timezone="<%= subregion.timezone || '' %>"><option value="<%= subregion.timezone || '' %>"><%= subregion.timezone || 'Use region timezone' %></option></select></label><label><span>Description</span><textarea name="description" rows="3"><%= subregion.description || '' %></textarea></label><label><span>Status</span><select name="status"><option value="active" <%= subregion.status==='active'?'selected':'' %>>Active</option><option value="inactive" <%= subregion.status==='inactive'?'selected':'' %>>Inactive</option></select></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save</button></div></form></dialog><% }) %>
<script src="/js/app.js"></script></body></html>
