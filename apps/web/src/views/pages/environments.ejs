<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %> · <%= appName %></title><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= title %> · <%= appName %></title><link rel="stylesheet" href="/css/app.css" /></head>
  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar') %>
      <main class="main">
        <%- include('../partials/topbar', { organization }) %>
        <section class="page-head unified-page-head thin-head"><div><p class="eyebrow">Runtime context</p><h2>Environments</h2><p>Define where requests happen and whether SLA applies by default.</p></div><div class="actions"><button class="btn primary" type="button" data-open-modal="environmentModal">Add environment</button><form method="post" action="/config/seed"><input type="hidden" name="next" value="/admin/environments" /><button class="btn secondary" type="submit">Seed defaults</button></form></div></section>
        <section class="config-anchor-row card pad compact-anchor-row"><a href="/admin/sla">SLA Policies</a><a href="/admin/severities-priorities">Severities & Priorities</a><a href="/admin/products-modules">Products & Modules</a><a href="/admin/regions">Regions &amp; Subregions</a><a class="active-soft" href="/admin/environments">Environments</a></section>
        <section class="card client-table-card"><div class="section-head"><div><p class="eyebrow">Environment library</p><h3>Configured environments</h3></div><button class="btn secondary small" type="button" data-open-modal="environmentModal">Add</button></div><div class="table-wrap"><table class="clean-table compact-table"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>SLA default</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody><% environments.forEach((environment) => { %><tr><td><span class="code-badge"><%= environment.code %></span></td><td><strong><%= environment.name %></strong></td><td><%= String(environment.environmentType || environment.type || 'non_production').replace('_', ' ') %></td><td><%= environment.slaApplicableByDefault ? 'Yes' : 'No' %></td><td><%= environment.description %></td><td><%= environment.status %></td><td><button class="table-link-button" type="button" data-open-modal="editEnvironment<%= environment._id %>">Edit</button></td></tr><% }) %><% if (!environments.length) { %><tr><td colspan="7"><div class="empty-box">No environments yet. Seed defaults or add one.</div></td></tr><% } %></tbody></table></div></section>
        <%- include('../partials/footer', { organization }) %>
      </main>
    </div>
    <dialog class="modal" id="environmentModal"><form method="post" action="/config/environments" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Add environment</p><h3>Runtime environment</h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" minlength="2" maxlength="20" required placeholder="PROD" /></label><label><span>Name</span><input name="name" required placeholder="Production" /></label></div><label><span>Type</span><select name="environmentType"><option value="non_production">Non-production</option><option value="production_like">Production-like</option><option value="production">Production</option><option value="dr">DR</option></select></label><label class="inline-check"><input type="checkbox" name="slaApplicableByDefault" /> <span>SLA applicable by default</span></label><label><span>Description <em>required</em></span><textarea name="description" minlength="2" required rows="3"></textarea></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary" type="submit">Save environment</button></div></form></dialog>
    <% environments.forEach((environment) => { %><dialog class="modal" id="editEnvironment<%= environment._id %>"><form method="post" action="/config/environments/<%= environment._id %>/edit" class="modal-card form compact-form"><div class="modal-head"><div><p class="eyebrow">Edit environment</p><h3><%= environment.name %></h3></div><button class="icon-btn" type="button" data-close-modal>×</button></div><div class="two-col narrow"><label><span>Code</span><input name="code" value="<%= environment.code %>" minlength="2" maxlength="20" required /></label><label><span>Name</span><input name="name" value="<%= environment.name %>" required /></label></div><label><span>Type</span><select name="environmentType"><option value="non_production" <%= (environment.environmentType || environment.type) === 'non_production' ? 'selected' : '' %>>Non-production</option><option value="production_like" <%= (environment.environmentType || environment.type) === 'production_like' ? 'selected' : '' %>>Production-like</option><option value="production" <%= (environment.environmentType || environment.type) === 'production' ? 'selected' : '' %>>Production</option><option value="dr" <%= (environment.environmentType || environment.type) === 'dr' ? 'selected' : '' %>>DR</option></select></label><label class="inline-check"><input type="checkbox" name="slaApplicableByDefault" <%= environment.slaApplicableByDefault ? 'checked' : '' %> /> <span>SLA applicable by default</span></label><label><span>Description</span><textarea name="description" minlength="2" rows="3" required><%= environment.description %></textarea></label><label><span>Status</span><select name="status"><option value="active" <%= environment.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= environment.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></label><div class="modal-actions"><button class="btn secondary" type="button" data-close-modal>Cancel</button><button class="btn primary">Save</button></div></form></dialog><% }) %>
    <script src="/js/app.js"></script>
  </body>
</html>
