<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="setup-page simple-setup-page">
  <main class="setup-shell single-setup-shell setup-centered-shell">
    <section class="card setup-card setup-centered-card">
      <div class="setup-card-brand"><span class="brand-mark">SD</span><div><strong>Service Desk</strong><small>v19.8.3 workspace setup</small></div></div>
      <p class="eyebrow">Workspace setup</p>
      <h2>Create your organization</h2>
      <p class="muted">Create a pending workspace and send a one-time activation link to the first administrator.</p>

      <% if (errorMessage) { %>
        <div class="alert <%= serviceIssue ? 'warn' : 'error' %>"><strong><%= serviceIssue ? 'Services unavailable' : 'Could not continue' %></strong><span><%= errorMessage %></span></div>
      <% } %>

      <form method="post" action="/setup" class="form" autocomplete="off">
        <label><span>Organization name</span><input id="organizationName" name="organizationName" value="<%= form.organizationName || '' %>" required placeholder="SunTec Business Solutions" /></label>
        <div class="two-col setup-code-row">
          <label><span>Short code</span><input id="shortCode" name="shortCode" value="<%= form.shortCode || '' %>" minlength="2" maxlength="12" pattern="[A-Za-z0-9]{2,12}" required placeholder="SBS" /></label>
          <label><span>Workspace slug</span><input id="workspaceSlug" name="workspaceSlug" value="<%= form.workspaceSlug || '' %>" minlength="2" maxlength="48" pattern="[a-z0-9-]{2,48}" required placeholder="suntec" /></label>
        </div>
        <p class="field-hint setup-slug-hint">Tenant login will be available at <strong>/<span data-slug-preview><%= form.workspaceSlug || 'suntec' %></span>/login</strong>. Enter the slug without a leading slash.</p>
        <label><span>Primary domain</span><input name="primaryDomain" value="<%= form.primaryDomain || '' %>" placeholder="suntecgroup.com" /></label>
        <div class="two-col">
          <label><span>Admin name</span><input name="adminName" value="<%= form.adminName || '' %>" required placeholder="Karthik VJ" /></label>
          <label><span>Admin email</span><input type="email" name="adminEmail" value="<%= form.adminEmail || '' %>" required placeholder="admin@company.com" /></label>
        </div>
        <button class="btn primary full" type="submit" data-submitting-label="Creating workspace…">Send activation link</button>
      </form>
    </section>
    <%- include('../partials/footer', { organization: null }) %>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
