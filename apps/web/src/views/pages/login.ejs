<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · <%= appName %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/app.css">
  </head>
  <body class="minimal-login-page">
    <main class="minimal-login-stage">
      <section class="minimal-login-wrap" aria-labelledby="loginHeading">
        <header class="minimal-login-heading">
          <h1 id="loginHeading">SunTec Service Desk</h1>
        </header>

        <div class="minimal-login-card">
          <% if (typeof globalFormNotice !== 'undefined' && globalFormNotice) { %><div class="alert success"><%= globalFormNotice %></div><% } %>
          <% if (errorMessage) { %><div class="alert error"><%= errorMessage %></div><% } %>
          <form class="form minimal-login-form" method="post" action="<%= loginAction %>">
            <% if (isAdminLogin) { %>
              <label><span>Tenant</span><input name="tenant" required value="<%= form.tenant || '' %>" placeholder="Workspace slug" autocomplete="organization"></label>
            <% } %>
            <label><span>Email</span><input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="email" placeholder="name@company.com"></label>
            <label><span>Password</span><div class="password-field"><input type="password" name="password" required autocomplete="current-password" placeholder="Enter your password"><button type="button" class="password-toggle" data-toggle-password aria-label="Show password">👁</button></div></label>
            <button class="btn primary full minimal-login-submit" type="submit">Sign in</button>
          </form>
          <a class="text-link minimal-forgot-link" href="<%= isAdminLogin ? '/admin/forgot-password' : `/${tenantSlug}/forgot-password` %>">Forgot password?</a>
        </div>
      </section>
    </main>
    <script src="/js/app.js"></script>
  </body>
</html>
