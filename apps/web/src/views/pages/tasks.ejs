<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <div class="app-shell <%= portal !== 'admin' ? 'slim-shell' : '' %>">
    <%- include('../partials/sidebar', { portal }) %>
    <main class="main">
      <% if (portal === 'admin') { %><%- include('../partials/topbar', { organization, portal }) %><% } else { %><header class="topbar simple-topbar page-brand-header compact-brand-header"><div><p class="eyebrow"><%= portal === 'client' ? 'Client Portal' : 'Agent Portal' %></p><h1><%= organization.name %></h1></div></header><% } %>

      <section class="page-head unified-page-head thin-head">
        <div><p class="eyebrow">Operational work queue</p><h2>Tasks</h2><p>Search task IDs, parent requests, queues and workflow stages.</p></div>
        <div class="task-summary-pills"><span><strong><%= tasks.filter((task) => !['done','cancelled'].includes(task.status)).length %></strong> open</span><span><strong><%= tasks.filter((task) => task.isBlocking && !['done','cancelled'].includes(task.status)).length %></strong> blocking</span></div>
      </section>

      <section class="card pad task-filter-card">
        <form method="get" action="<%= listPath %>" class="task-filter-grid">
          <label class="wide"><span>Search</span><input type="search" name="search" value="<%= filters.search %>" placeholder="Task ID, request, client, title or queue" /></label>
          <label><span>Status</span><select name="status"><option value="">All statuses</option><option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>To Do</option><option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In Progress</option><option value="blocked" <%= filters.status === 'blocked' ? 'selected' : '' %>>Waiting</option><option value="done" <%= filters.status === 'done' ? 'selected' : '' %>>Completed</option><option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option></select></label>
          <label><span>Stage</span><select name="supportLevel"><option value="">All stages</option><option value="L1" <%= filters.supportLevel === 'L1' ? 'selected' : '' %>>L1</option><option value="L2" <%= filters.supportLevel === 'L2' ? 'selected' : '' %>>L2</option><option value="L3" <%= filters.supportLevel === 'L3' ? 'selected' : '' %>>L3</option></select></label>
          <label><span>Client</span><select name="clientId"><option value="">All clients</option><% (clients || []).forEach((client) => { %><option value="<%= client._id %>" <%= filters.clientId === String(client._id) ? 'selected' : '' %>><%= client.name %></option><% }) %></select></label>
          <label><span>Blocking</span><select name="blocking"><option value="">All tasks</option><option value="true" <%= filters.blocking === 'true' ? 'selected' : '' %>>Blocking only</option><option value="false" <%= filters.blocking === 'false' ? 'selected' : '' %>>Non-blocking only</option></select></label>
          <div class="actions task-filter-actions"><button class="btn primary" type="submit">Apply</button><a class="btn secondary" href="<%= listPath %>">Clear</a></div>
        </form>
      </section>

      <section class="card client-table-card task-table-card">
        <% if (!tasks.length) { %><div class="empty-box roomy"><strong>No matching tasks.</strong><p>Tasks are created when requests enter workflow statuses that contain task templates.</p></div><% } else { %>
          <div class="table-wrap"><table class="clean-table compact-table task-library-table">
            <thead><tr><th>Task</th><th>Parent request</th><th>Client</th><th>Stage</th><th>Owner / queue</th><th>Status</th><th>Due</th></tr></thead>
            <tbody>
              <% tasks.forEach((task) => { %>
                <tr>
                  <td><a class="task-id-link" href="<%= listPath %>/<%= encodeURIComponent(task.taskId) %>"><strong><%= task.taskId %></strong><span><%= task.title %></span></a><div class="task-inline-tags"><% if (task.isBlocking) { %><span class="compact-tag warn">Blocking</span><% } %><span class="compact-tag neutral"><%= task.priority || 'normal' %></span></div></td>
                  <td><a class="text-link" href="<%= requestBase %>/<%= task.requestId %>"><%= task.requestNumber %></a><small><%= task.requestSubject %></small></td>
                  <td><strong><%= task.client?.name || '—' %></strong><small><%= task.client?.code || '' %></small></td>
                  <td><span class="level-badge"><%= task.sourceStageId || '—' %></span><small><%= task.sourceStatusName || '' %></small></td>
                  <td><strong><%= task.assignedTo?.name || task.queue || (task.ownerSide || 'Unassigned') %></strong><small><%= task.assignedTo?.email || task.queue || '' %></small></td>
                  <td><span class="task-status-pill status-<%= task.status %>"><%= task.statusLabel %></span></td>
                  <td><%= task.dueLabel || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } %>
      </section>
      <%- include('../partials/footer', { organization }) %>
    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
