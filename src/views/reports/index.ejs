<%
  const selected = reports.filters;
  const hasDateRange = reports.filterMode === 'date_range';
  const queryString = reports.reportQueryString || `days=${reports.appliedDays}`;
  const isSelected = (bucket, value) => Array.isArray(bucket) && bucket.includes(String(value));
  const cardExportHref = (type) => `${basePath}/reports/export/card.csv?${queryString}&type=${type}`;
  const issuesExportHref = `${basePath}/reports/export/issues.csv?${queryString}`;
  const isClientAudience = reports.audience === 'client';
%>

<section class="hero gradient-quirky dashboard-hero">
  <div>
    <div class="section-kicker">Reporting hub</div>
    <h1>Reports</h1>
    <p class="muted"><%= isClientAudience ? 'Issue and SLA reporting within your visible client scope.' : 'Operational, SLA, agent, client, and Jira execution reporting within your current access scope.' %></p>
  </div>
  <div class="hero-actions wrap-actions hero-actions-inline hero-quick-actions">
    <a class="button-link secondary quick-action" href="<%= currentUser && currentUser.role === 'client' ? `${basePath}/client/dashboard` : `${basePath}/dashboard` %>">Home</a>
    <a class="button-link secondary quick-action" href="<%= currentUser && currentUser.role === 'client' ? `${basePath}/client/issues` : `${basePath}/tickets` %>">Issues</a>
  </div>
</section>

<section class="card section-card reports-window-card">
  <div class="page-header compact-header">
    <div>
      <h2>Report window</h2>
      <% if (hasDateRange) { %>
        <p class="muted">Showing data from <strong><%= new Date(reports.since).toLocaleDateString() %></strong> to <strong><%= new Date(reports.until).toLocaleDateString() %></strong>.</p>
      <% } else { %>
        <p class="muted">Showing the last <strong><%= reports.appliedDays %></strong> day(s), starting <strong><%= new Date(reports.since).toLocaleDateString() %></strong>.</p>
      <% } %>
    </div>
    <div class="hero-actions wrap-actions hero-actions-inline reports-filter-inline">
      <a class="button-link secondary" href="<%= cardExportHref('summary') %>">Download summary</a>
    </div>
  </div>
</section>

<section class="card section-card reports-builder-card">
  <div class="section-title-row">
    <h2>SLA Report Builder</h2>
    <span class="pill brand-soft">All dropdowns are multi-select</span>
  </div>
  <form method="get" action="<%= basePath %>/reports" class="stack">
    <div class="grid-two reports-date-grid">
      <label>
        <span>Quick window</span>
        <select name="days">
          <% [1, 7, 14, 30, 60, 90, 180, 365].forEach((option) => { %>
            <option value="<%= option %>" <%= reports.appliedDays === option ? 'selected' : '' %>><%= option %> day<%= option === 1 ? '' : 's' %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>From date</span>
        <input type="date" name="fromDate" value="<%= selected.fromDate %>" />
      </label>
      <label>
        <span>To date</span>
        <input type="date" name="toDate" value="<%= selected.toDate %>" />
      </label>
      <div class="reports-filter-help muted small">Pick a quick window, or use exact from/to dates. If from/to is given, that exact range wins.</div>
    </div>

    <div class="grid-two reports-filter-matrix">
      <label>
        <span>Client / entity</span>
        <select name="clientId" multiple size="6">
          <% reports.filterOptions.entities.forEach((entity) => { %>
            <option value="<%= entity._id %>" <%= isSelected(selected.clientIds, String(entity._id)) ? 'selected' : '' %>><%= entity.path || entity.name %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>Severity</span>
        <select name="severity" multiple size="5">
          <% (reports.filterOptions.priorities || []).forEach((item) => { %>
            <option value="<%= item.value %>" <%= isSelected(selected.severities, item.value) ? 'selected' : '' %>><%= item.label %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>Type</span>
        <select name="requestType" multiple size="3">
          <% (reports.filterOptions.requestTypes || []).forEach((item) => { %>
            <option value="<%= item.value %>" <%= isSelected(selected.requestTypes, item.value) ? 'selected' : '' %>><%= item.label %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>Status</span>
        <select name="status" multiple size="8">
          <% reports.filterOptions.statuses.forEach((item) => { %>
            <option value="<%= item.value %>" <%= isSelected(selected.statuses, item.value) ? 'selected' : '' %>><%= item.label %></option>
          <% }) %>
        </select>
      </label>
      <% if (!isClientAudience) { %>
        <label>
          <span>Assigned agent</span>
          <select name="assignedToUserId" multiple size="6">
            <% reports.filterOptions.agents.forEach((agent) => { %>
              <option value="<%= agent._id %>" <%= isSelected(selected.assignedToUserIds, String(agent._id)) ? 'selected' : '' %>><%= agent.name %> (<%= agent.role %>)</option>
            <% }) %>
          </select>
        </label>
        <label>
          <span>Execution mode</span>
          <select name="executionMode" multiple size="2">
            <% ['NATIVE', 'JIRA'].forEach((item) => { %>
              <option value="<%= item %>" <%= isSelected(selected.executionModes, item) ? 'selected' : '' %>><%= item %></option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <label>
        <span>SLA state</span>
        <select name="slaState" multiple size="3">
          <% [['breached','Breached'], ['at_risk','At Risk'], ['met','Met']].forEach((item) => { %>
            <option value="<%= item[0] %>" <%= isSelected(selected.slaStates, item[0]) ? 'selected' : '' %>><%= item[1] %></option>
          <% }) %>
        </select>
      </label>
    </div>

    <div class="form-actions right wrap-actions">
      <a class="button-link secondary" href="<%= basePath %>/reports?days=30">Reset</a>
      <a class="button-link secondary" href="<%= issuesExportHref %>">Download issues</a>
      <button type="submit" class="reports-apply-button">Apply</button>
    </div>
  </form>
</section>

<section class="reports-card-head reports-section-gap">
  <div>
    <h2>Overview</h2>
    <p class="muted">These numbers reflect the exact filter selection above.</p>
  </div>
  <a class="button-link secondary" href="<%= cardExportHref('summary') %>">Download CSV</a>
</section>
<section class="stats-grid dashboard-primary-stats">
  <div class="stat-card"><h3>Total issues</h3><p class="big-number"><%= reports.stats.totalIssues %></p><p class="muted small">Inside your access scope</p></div>
  <div class="stat-card"><h3>Created in window</h3><p class="big-number"><%= reports.stats.createdInPeriod %></p><p class="muted small">Fresh demand in this period</p></div>
  <div class="stat-card"><h3>Open issues</h3><p class="big-number"><%= reports.stats.openIssues %></p><p class="muted small">Still active</p></div>
  <div class="stat-card"><h3>SLA breached</h3><p class="big-number"><%= reports.stats.slaBreached %></p><p class="muted small">Resolution breaches</p></div>
  <div class="stat-card"><h3>Waiting for client</h3><p class="big-number"><%= reports.stats.waitingForClient %></p><p class="muted small">Paused from SLA counting</p></div>
  <% if (!isClientAudience) { %>
    <div class="stat-card"><h3>Jira linked</h3><p class="big-number"><%= reports.stats.jiraLinked %></p><p class="muted small">Successfully pushed or linked</p></div>
  <% } %>
</section>

<section class="grid-two dashboard-secondary-grid reports-section-gap">
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>Issue volume by type</h2><p class="muted">Bug, CR, and Query distribution for the selected report window.</p></div><a class="button-link secondary" href="<%= cardExportHref('volume-by-type') %>">Download</a></div>
    <% if (!reports.volumeByType.length) { %><p class="muted">No issues created in the selected window.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Type</th><th>Count</th></tr></thead><tbody><% reports.volumeByType.forEach((row) => { %><tr><td><strong><%= row._id || 'UNSPECIFIED' %></strong></td><td><%= row.count %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>Issue volume by severity</h2><p class="muted">Business-facing severity mix in the selected report window.</p></div><a class="button-link secondary" href="<%= cardExportHref('volume-by-severity') %>">Download</a></div>
    <% if (!reports.volumeBySeverity.length) { %><p class="muted">No severity data available yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Severity</th><th>Count</th></tr></thead><tbody><% reports.volumeBySeverity.forEach((row) => { %><tr><td><strong><%= row._id || 'UNSPECIFIED' %></strong></td><td><%= row.count %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
</section>

<section class="card section-card reports-section-gap">
  <div class="page-header compact-header"><div><h2>Issue creation trend</h2><p class="muted">Daily created volume inside the selected period. Scroll horizontally for longer windows.</p></div><a class="button-link secondary" href="<%= cardExportHref('volume-trend') %>">Download</a></div>
  <% if (!reports.volumeTrend.length) { %>
    <p class="muted">No issue creation trend to display yet.</p>
  <% } else { %>
    <div class="reports-trend-scroll">
      <% reports.volumeTrend.forEach((row) => { %>
        <div class="reports-trend-point">
          <div class="reports-trend-date"><%= row._id %></div>
          <div class="reports-trend-value"><%= row.count %></div>
          <div class="muted small">created</div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="grid-two dashboard-secondary-grid reports-section-gap">
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>SLA compliance by severity</h2><p class="muted">Resolution SLA health across severities.</p></div><a class="button-link secondary" href="<%= cardExportHref('sla-by-severity') %>">Download</a></div>
    <% if (!reports.slaBySeverity.length) { %><p class="muted">No SLA-enabled issues in your current scope yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Severity</th><th>Total</th><th>Met</th><th>At risk</th><th>Breached</th></tr></thead><tbody><% reports.slaBySeverity.forEach((row) => { %><tr><td><strong><%= row._id %></strong></td><td><%= row.total %></td><td><%= row.met %></td><td><%= row.atRisk %></td><td><%= row.breached %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>Status aging</h2><p class="muted"><%= isClientAudience ? 'Aging grouped by the same statuses visible in the client portal.' : 'Where work is sitting and how long it has been there on average.' %></p></div><a class="button-link secondary" href="<%= cardExportHref('status-aging') %>">Download</a></div>
    <% if (!reports.statusAging.length) { %><p class="muted">No active issue aging data found.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Status</th><th>Open count</th><th>Avg age (hrs)</th><th>Oldest (hrs)</th></tr></thead><tbody><% reports.statusAging.forEach((row) => { %><tr><td><strong><%= row.label || row._id %></strong></td><td><%= row.count %></td><td><%= Number(row.avgAgeHours || 0).toFixed(1) %></td><td><%= Number(row.maxAgeHours || 0).toFixed(1) %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
</section>

<% if (!isClientAudience) { %>
<section class="grid-two dashboard-secondary-grid reports-section-gap">
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>Agent performance</h2><p class="muted">Assigned load, resolution output, and breach counts for all agents in scope.</p></div><a class="button-link secondary" href="<%= cardExportHref('agent-performance') %>">Download</a></div>
    <% if (!reports.agentPerformance.length) { %><p class="muted">No agent assignment data available yet.</p><% } else { %>
      <div class="table-wrap reports-scrollable-table"><table><thead><tr><th>Agent</th><th>Assigned</th><th>Resolved</th><th>Breached</th><th>Avg resolution (hrs)</th></tr></thead><tbody><% reports.agentPerformance.forEach((row) => { %><tr><td><strong><%= row.assigneeName %></strong></td><td><%= row.assignedCount %></td><td><%= row.resolvedCount %></td><td><%= row.breachedCount %></td><td><%= row.avgResolutionHours ? row.avgResolutionHours.toFixed(1) : '-' %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header"><div><h2>Jira execution</h2><p class="muted">Execution state breakdown for issues flowing into Jira.</p></div><a class="button-link secondary" href="<%= cardExportHref('jira-execution') %>">Download</a></div>
    <% if (!reports.jiraExecution.length) { %><p class="muted">No Jira execution records available yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Execution state</th><th>Total</th><th>Linked</th><th>Failed pushes</th></tr></thead><tbody><% reports.jiraExecution.forEach((row) => { %><tr><td><strong><%= row._id || 'UNSPECIFIED' %></strong></td><td><%= row.count %></td><td><%= row.pushed %></td><td><%= row.failed %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
</section>
<% } %>

<section class="grid-two dashboard-secondary-grid reports-section-gap">
  <article class="card section-card">
    <div class="page-header compact-header"><div><h2>Client / entity breakdown</h2><p class="muted">Demand, open work, and SLA pressure by visible entity.</p></div><a class="button-link secondary" href="<%= cardExportHref('client-breakdown') %>">Download</a></div>
    <% if (!reports.clientBreakdown.length) { %><p class="muted">No entity-level report data available yet.</p><% } else { %>
      <div class="table-wrap reports-scrollable-table"><table><thead><tr><th>Entity</th><th>Total</th><th>Open</th><th>Breached</th></tr></thead><tbody><% reports.clientBreakdown.forEach((row) => { %><tr><td><strong><%= row.entityPath || row.entityName %></strong></td><td><%= row.total %></td><td><%= row.open %></td><td><%= row.breached %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
  <article class="card section-card">
    <div class="page-header compact-header"><div><h2>Time spent in each stage</h2><p class="muted"><%= isClientAudience ? 'Client-visible stage buckets only. Waiting for Client time stays excluded from SLA-counted minutes.' : 'Waiting for Client time is automatically excluded from SLA-counted minutes.' %></p></div><a class="button-link secondary" href="<%= cardExportHref('stage-tracker') %>">Download</a></div>
    <% if (!reports.stageTracker.length) { %><p class="muted">No stage tracker data available yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Status</th><th>Visits</th><th>Total Minutes</th><th>Excluded Minutes</th><th>SLA-counted Minutes</th><th>Avg Minutes</th></tr></thead><tbody><% reports.stageTracker.forEach((row) => { %><tr><td><strong><%= row.label || row._id %></strong></td><td><%= row.visits %></td><td><%= row.totalMinutes %></td><td><%= row.excludedMinutes %></td><td><%= row.slaCountedMinutes %></td><td><%= Number(row.avgMinutes || 0).toFixed(1) %></td></tr><% }) %></tbody></table></div>
    <% } %>
  </article>
</section>
<script>
(function(){
  function initTokenMultiSelect(select){
    if(!select || select.dataset.tokenized) return; select.dataset.tokenized='1'; select.hidden=true;
    var root=document.createElement('div'); root.className='token-multiselect reports-token-multiselect'; root.setAttribute('data-multiselect','');
    select.parentNode.insertBefore(root, select); root.appendChild(select);
    var placeholder='Type to search and select';
    var control=document.createElement('div'); control.className='token-multiselect__control';
    var chips=document.createElement('div'); chips.className='token-multiselect__chips';
    var input=document.createElement('input'); input.type='text'; input.className='token-multiselect__input'; input.placeholder=placeholder; input.autocomplete='off';
    var menu=document.createElement('div'); menu.className='token-multiselect__menu'; menu.hidden=true;
    root.appendChild(control); root.appendChild(menu); control.appendChild(chips); control.appendChild(input);
    function opts(){return Array.from(select.options).map(function(o){return {value:o.value,label:o.textContent||o.value,selected:o.selected};});}
    function renderChips(){chips.innerHTML=''; opts().filter(function(o){return o.selected;}).forEach(function(o){var b=document.createElement('button'); b.type='button'; b.className='token-multiselect__chip'; b.innerHTML='<span>'+o.label+'</span><span class="token-multiselect__chip-close">×</span>'; b.onclick=function(){Array.from(select.options).forEach(function(x){if(x.value===o.value)x.selected=false;}); renderChips(); renderMenu(input.value);}; chips.appendChild(b);});}
    function renderMenu(q){q=String(q||'').toLowerCase().trim(); menu.innerHTML=''; var m=opts().filter(function(o){return !q || o.label.toLowerCase().includes(q) || o.value.toLowerCase().includes(q);}); if(!m.length){var e=document.createElement('div'); e.className='token-multiselect__hint'; e.textContent='No matches'; menu.appendChild(e); menu.hidden=false; return;} m.forEach(function(o){var r=document.createElement('button'); r.type='button'; r.className='token-multiselect__option'+(o.selected?' active':''); r.textContent=o.label; r.onclick=function(){Array.from(select.options).forEach(function(x){if(x.value===o.value)x.selected=!x.selected;}); renderChips(); renderMenu(input.value); input.focus();}; menu.appendChild(r);}); menu.hidden=false;}
    control.onclick=function(){input.focus(); renderMenu(input.value);}; input.onfocus=function(){renderMenu(input.value);}; input.oninput=function(){renderMenu(input.value);}; document.addEventListener('click',function(ev){if(!root.contains(ev.target))menu.hidden=true;}); renderChips();
  }
  document.querySelectorAll('.reports-builder-card select[multiple]').forEach(initTokenMultiSelect);
}());
</script>
