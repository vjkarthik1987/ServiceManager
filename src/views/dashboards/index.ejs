    var statusSeverityCanvas = document.getElementById('statusSeverityChart');
    function drawStatusSeverityChart() {
      if (!statusSeverityCanvas) return;
      var matrix = [];
      try { matrix = JSON.parse(statusSeverityCanvas.getAttribute('data-chart') || '[]'); } catch (error) { matrix = []; }
      matrix = matrix.filter(function (row) { return Number(row && row.total || 0) > 0; });
      if (!matrix.length) return;
      var shell = statusSeverityCanvas.parentElement;
      var width = Math.max(520, Math.floor(shell.clientWidth || 520));
      var height = Math.max(300, matrix.length * 44 + 48);
      withCanvasSize(statusSeverityCanvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 18, right: 22, bottom: 22, left: 150 };
        var chartWidth = widthPx - padding.left - padding.right;
        var rowHeight = Math.max(26, Math.floor((heightPx - padding.top - padding.bottom) / matrix.length) - 10);
        var gapY = 16;
        var maxValue = Math.max.apply(null, matrix.map(function (row) { return Number(row.total || 0); }).concat([1]));
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        ctx.lineWidth = 1;
        for (var i = 0; i <= 4; i += 1) {
          var xTick = padding.left + (chartWidth / 4) * i;
          ctx.beginPath();
          ctx.moveTo(xTick, padding.top);
          ctx.lineTo(xTick, heightPx - padding.bottom);
          ctx.stroke();
          var valueTick = Math.round((maxValue / 4) * i);
          ctx.fillText(String(valueTick), xTick - 8, heightPx - 4);
        }
        matrix.forEach(function (row, rowIndex) {
          var y = padding.top + rowIndex * (rowHeight + gapY);
          var currentX = padding.left;
          ctx.fillStyle = '#0f172a';
          ctx.textAlign = 'right';
          var label = String(row.label || row._id || 'Status');
          ctx.fillText(label.length > 24 ? label.slice(0, 24) + '…' : label, padding.left - 12, y + rowHeight * 0.72);
          ctx.textAlign = 'left';
          (row.severities || []).forEach(function (severity, severityIndex) {
            var value = Number(severity.count || 0);
            if (!value) return;
            var segmentWidth = Math.max((value / maxValue) * chartWidth, 3);
            ctx.fillStyle = getPalette(severityIndex);
            ctx.fillRect(currentX, y, segmentWidth, rowHeight);
            boxes.push({ x: currentX, y: y, width: segmentWidth, height: rowHeight, html: '<strong>' + (row.label || row._id || 'Status') + '</strong><div>' + (severity.label || severity._id || 'Severity') + ': ' + value + '</div><div>Total in status: ' + (row.total || 0) + '</div>' });
            currentX += segmentWidth;
          });
        });
        setHitboxes(statusSeverityCanvas, boxes);
      });
    }
    drawStatusSeverityChart();
    window.addEventListener('resize', drawStatusSeverityChart);

