<script>
  (function () {
    function initTokenMultiSelect(root) {
      var select = root.querySelector('select[multiple]');
      if (!select) return;
      var placeholder = root.getAttribute('data-placeholder') || 'Type to search';
      var minSearch = Number(root.getAttribute('data-min-search') || 0);
      var control = document.createElement('div');
      control.className = 'token-multiselect__control';
      var chips = document.createElement('div');
      chips.className = 'token-multiselect__chips';
      var input = document.createElement('input');
      input.type = 'text';
      input.className = 'token-multiselect__input';
      input.placeholder = placeholder;
      input.autocomplete = 'off';
      var menu = document.createElement('div');
      menu.className = 'token-multiselect__menu';
      menu.hidden = true;
      var hint = document.createElement('div');
      hint.className = 'token-multiselect__hint';
      hint.textContent = minSearch > 0 ? ('Type at least ' + minSearch + ' letters') : 'Click to choose';
      root.appendChild(control);
      root.appendChild(menu);
      control.appendChild(chips);
      control.appendChild(input);
      function getOptions() {
        return Array.from(select.options || []).map(function (option) {
          return { value: option.value, label: option.textContent || option.innerText || option.value, selected: option.selected };
        });
      }
      function selectedOptions() { return getOptions().filter(function (option) { return option.selected; }); }
      function renderChips() {
        chips.innerHTML = '';
        selectedOptions().forEach(function (option) {
          var chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'token-multiselect__chip';
          chip.innerHTML = '<span>' + option.label + '</span><span class="token-multiselect__chip-close">×</span>';
          chip.addEventListener('click', function () {
            Array.from(select.options).forEach(function (item) { if (item.value === option.value) item.selected = false; });
            renderChips();
            renderMenu(input.value);
            input.focus();
          });
          chips.appendChild(chip);
        });
      }
      function renderMenu(query) {
        var normalized = String(query || '').trim().toLowerCase();
        var allOptions = getOptions();
        menu.innerHTML = '';
        if (minSearch > 0 && normalized.length < minSearch) {
          menu.hidden = false;
          menu.appendChild(hint.cloneNode(true));
          return;
        }
        var matches = allOptions.filter(function (option) {
          if (!normalized) return true;
          return option.label.toLowerCase().includes(normalized) || option.value.toLowerCase().includes(normalized);
        });
        if (!matches.length) {
          var empty = document.createElement('div');
          empty.className = 'token-multiselect__hint';
          empty.textContent = 'No matches found';
          menu.appendChild(empty);
          menu.hidden = false;
          return;
        }
        matches.forEach(function (option) {
          var row = document.createElement('button');
          row.type = 'button';
          row.className = 'token-multiselect__option' + (option.selected ? ' active' : '');
          row.textContent = option.label;
          row.addEventListener('click', function () {
            Array.from(select.options).forEach(function (item) { if (item.value === option.value) item.selected = !item.selected; });
            renderChips();
            renderMenu(input.value);
            input.focus();
          });
          menu.appendChild(row);
        });
        menu.hidden = false;
      }
      control.addEventListener('click', function () { input.focus(); renderMenu(input.value); });
      input.addEventListener('focus', function () { renderMenu(input.value); });
      input.addEventListener('input', function () { renderMenu(input.value); });
      document.addEventListener('click', function (event) { if (!root.contains(event.target)) menu.hidden = true; });
      renderChips();
    }

    document.querySelectorAll('[data-multiselect]').forEach(initTokenMultiSelect);

    function getPalette(index) {
      return ['#7C3AED', '#00C2A8', '#FFE66D', '#4F46E5', '#FB7185', '#22C55E', '#F97316', '#06B6D4'][index % 8];
    }
    function colorForLabel(label, fallbackIndex) {
      var key = String(label || '').toUpperCase();
      if (key.indexOf('BREACHED') >= 0) return '#ef4444';
      if (key.indexOf('AT RISK') >= 0 || key.indexOf('RISK') >= 0) return '#f97316';
      if (key.indexOf('SAFE') >= 0 || key.indexOf('MET') >= 0 || key.indexOf('RESOLVED') >= 0 || key.indexOf('CLOSED') >= 0) return '#22c55e';
      if (key.indexOf('WAITING') >= 0) return '#eab308';
      if (key.indexOf('IN PROGRESS') >= 0 || key.indexOf('PROGRESS') >= 0) return '#3b82f6';
      if (key.indexOf('NEW') >= 0 || key.indexOf('OPEN') >= 0) return '#94a3b8';
      return getPalette(fallbackIndex || 0);
    }

    function withCanvasSize(canvas, width, height, draw) {
      var ratio = window.devicePixelRatio || 1;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      var ctx = canvas.getContext('2d');
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      draw(ctx, width, height);
    }

    var tooltip = document.createElement('div');
    tooltip.className = 'dashboard-chart-tooltip';
    tooltip.hidden = true;
    document.body.appendChild(tooltip);

    function attachTooltip(canvas) {
      if (!canvas || canvas.__tooltipBound) return;
      canvas.__tooltipBound = true;
      canvas.addEventListener('mousemove', function (event) {
        var rect = canvas.getBoundingClientRect();
        var x = event.clientX - rect.left;
        var y = event.clientY - rect.top;
        var hitboxes = canvas.__hitboxes || [];
        var active = null;
        hitboxes.some(function (box) {
          if (box.type === 'arc') {
            var dx = x - box.cx;
            var dy = y - box.cy;
            var distance = Math.sqrt(dx * dx + dy * dy);
            var angle = Math.atan2(dy, dx);
            if (angle < -Math.PI / 2) angle += Math.PI * 2;
            if (distance >= box.innerRadius && distance <= box.outerRadius && angle >= box.startAngle && angle <= box.endAngle) {
              active = box;
              return true;
            }
            return false;
          }
          if (x >= box.x && x <= box.x + box.width && y >= box.y && y <= box.y + box.height) {
            active = box;
            return true;
          }
          return false;
        });
        if (!active) {
          tooltip.hidden = true;
          return;
        }
        tooltip.innerHTML = active.html;
        tooltip.hidden = false;
        tooltip.style.left = (event.pageX + 14) + 'px';
        tooltip.style.top = (event.pageY - 12) + 'px';
      });
      canvas.addEventListener('mouseleave', function () { tooltip.hidden = true; });
    }

    function setHitboxes(canvas, boxes) {
      canvas.__hitboxes = boxes || [];
      attachTooltip(canvas);
    }

    var lineCanvas = document.getElementById('issueLifecycleTrendChart');
    var visibleSeries = { raised: true, closed: true, closedWithinSla: false, closedBreachedSla: false };
    function drawLineChart() {
      if (!lineCanvas) return;
      var series = [];
      try { series = JSON.parse(lineCanvas.getAttribute('data-chart') || '[]'); } catch (error) { series = []; }
      if (!series.length) return;
      var shell = lineCanvas.parentElement;
      var width = Math.max(640, Math.floor(shell.clientWidth || 640));
      var height = 336;
      withCanvasSize(lineCanvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 18, right: 18, bottom: 44, left: 42 };
        var chartWidth = widthPx - padding.left - padding.right;
        var chartHeight = heightPx - padding.top - padding.bottom;
        var considered = [];
        if (visibleSeries.raised) considered = considered.concat(series.map(function (row) { return Number(row.raised || 0); }));
        if (visibleSeries.closed) considered = considered.concat(series.map(function (row) { return Number(row.closed || 0); }));
        if (visibleSeries.closedWithinSla) considered = considered.concat(series.map(function (row) { return Number(row.closedWithinSla || 0); }));
        if (visibleSeries.closedBreachedSla) considered = considered.concat(series.map(function (row) { return Number(row.closedBreachedSla || 0); }));
        var maxValue = Math.max.apply(null, considered.concat([1]));
        var stepCount = 4;
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        ctx.lineWidth = 1;
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        for (var i = 0; i <= stepCount; i += 1) {
          var y = padding.top + (chartHeight / stepCount) * i;
          ctx.beginPath();
          ctx.moveTo(padding.left, y);
          ctx.lineTo(widthPx - padding.right, y);
          ctx.stroke();
          var tickValue = Math.round(maxValue - (maxValue / stepCount) * i);
          ctx.fillText(String(tickValue), 8, y + 4);
        }
        var xStep = series.length > 1 ? chartWidth / (series.length - 1) : chartWidth;
        var labelEvery = series.length > 12 ? Math.ceil(series.length / 6) : 1;
        function getPoint(index, key) {
          var value = Number(series[index][key] || 0);
          var x = padding.left + xStep * index;
          var y = padding.top + chartHeight - (value / maxValue) * chartHeight;
          return { x: x, y: y, value: value };
        }
        function drawLine(key, strokeStyle, label) {
          ctx.beginPath();
          series.forEach(function (_, index) {
            var point = getPoint(index, key);
            if (index === 0) ctx.moveTo(point.x, point.y);
            else ctx.lineTo(point.x, point.y);
          });
          ctx.strokeStyle = strokeStyle;
          ctx.lineWidth = 2.5;
          ctx.stroke();
          series.forEach(function (row, index) {
            var point = getPoint(index, key);
            ctx.beginPath();
            ctx.fillStyle = strokeStyle;
            ctx.arc(point.x, point.y, 4, 0, Math.PI * 2);
            ctx.fill();
            boxes.push({
              x: point.x - 10, y: point.y - 10, width: 20, height: 20,
              html: '<strong>' + label + '</strong><div>' + (row.date || '') + '</div><div>Value: ' + point.value + '</div>'
            });
          });
        }
        if (visibleSeries.raised) drawLine('raised', '#7C3AED', 'Issues raised');
        if (visibleSeries.closed) drawLine('closed', '#00C2A8', 'Issues closed');
        if (visibleSeries.closedWithinSla) drawLine('closedWithinSla', '#22c55e', 'Closed within SLA');
        if (visibleSeries.closedBreachedSla) drawLine('closedBreachedSla', '#ef4444', 'Closed breached SLA');
        ctx.fillStyle = '#64748b';
        series.forEach(function (row, index) {
          if (index % labelEvery !== 0 && index !== series.length - 1) return;
          var x = padding.left + xStep * index;
          var label = String(row.date || '').slice(5);
          ctx.fillText(label, x - 14, heightPx - 16);
        });
        setHitboxes(lineCanvas, boxes);
      });
    }
    document.querySelectorAll('[data-line-toggle] .legend-toggle-button').forEach(function (button) {
      button.addEventListener('click', function () {
        var key = button.getAttribute('data-series');
        if (!key) return;
        visibleSeries[key] = !visibleSeries[key];
        if (!visibleSeries.raised && !visibleSeries.closed && !visibleSeries.closedWithinSla && !visibleSeries.closedBreachedSla) visibleSeries[key] = true;
        button.classList.toggle('is-active', !!visibleSeries[key]);
        drawLineChart();
      });
    });
    drawLineChart();
    window.addEventListener('resize', drawLineChart);

    var doughnutCanvas = document.getElementById('severityMixChart');
    function drawDoughnut() {
      if (!doughnutCanvas) return;
      var severitySeries = [];
      try { severitySeries = JSON.parse(doughnutCanvas.getAttribute('data-chart') || '[]'); } catch (error) { severitySeries = []; }
      severitySeries = severitySeries.filter(function (row) { return Number(row && row.count || 0) > 0; });
      if (!severitySeries.length) return;
      var size = 220;
      withCanvasSize(doughnutCanvas, size, size, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var total = severitySeries.reduce(function (sum, row) { return sum + Number(row.count || 0); }, 0) || 1;
        var centerX = widthPx / 2;
        var centerY = heightPx / 2;
        var radius = Math.min(widthPx, heightPx) / 2 - 14;
        var innerRadius = radius * 0.62;
        var start = -Math.PI / 2;
        severitySeries.forEach(function (row, index) {
          var value = Number(row.count || 0);
          var angle = (value / total) * Math.PI * 2;
          var end = start + angle;
          ctx.beginPath();
          ctx.arc(centerX, centerY, radius, start, end);
          ctx.arc(centerX, centerY, innerRadius, end, start, true);
          ctx.closePath();
          ctx.fillStyle = getPalette(index);
          ctx.fill();
          boxes.push({
            type: 'arc', cx: centerX, cy: centerY, innerRadius: innerRadius, outerRadius: radius,
            startAngle: start < -Math.PI / 2 ? start + Math.PI * 2 : start,
            endAngle: end < -Math.PI / 2 ? end + Math.PI * 2 : end,
            html: '<strong>' + (row.label || row._id || 'Severity') + '</strong><div>Issues: ' + value + '</div><div>Share: ' + Math.round((value / total) * 100) + '%</div>'
          });
          start = end;
        });
        setHitboxes(doughnutCanvas, boxes);
      });
    }
    drawDoughnut();
    window.addEventListener('resize', drawDoughnut);

    function drawVerticalBarChart(canvas, config) {
      if (!canvas) return;
      var series = [];
      try { series = JSON.parse(canvas.getAttribute('data-chart') || '[]'); } catch (error) { series = []; }
      series = series.filter(function (row) { return Number(row && row.count || 0) > 0; });
      if (!series.length) return;
      var shell = canvas.parentElement;
      var width = Math.max(config.minWidth || 320, Math.floor(shell.clientWidth || (config.minWidth || 320)));
      var height = config.height || 260;
      withCanvasSize(canvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 20, right: 14, bottom: config.bottomPadding || 92, left: 42 };
        var chartWidth = widthPx - padding.left - padding.right;
        var chartHeight = heightPx - padding.top - padding.bottom;
        var maxValue = Math.max.apply(null, series.map(function (row) { return Number(row.count || 0); }).concat([1]));
        var stepCount = 4;
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        ctx.lineWidth = 1;
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        for (var i = 0; i <= stepCount; i += 1) {
          var y = padding.top + (chartHeight / stepCount) * i;
          ctx.beginPath();
          ctx.moveTo(padding.left, y);
          ctx.lineTo(widthPx - padding.right, y);
          ctx.stroke();
          var tickValue = Math.round(maxValue - (maxValue / stepCount) * i);
          ctx.fillText(String(tickValue), 8, y + 4);
        }
        var gap = series.length > 6 ? 10 : 14;
        var barWidth = Math.max(config.minBarWidth || 18, (chartWidth - gap * (series.length - 1)) / Math.max(series.length, 1));
        series.forEach(function (row, index) {
          var value = Number(row.count || 0);
          var x = padding.left + index * (barWidth + gap);
          var barHeight = Math.max((value / maxValue) * chartHeight, 6);
          var y = padding.top + chartHeight - barHeight;
          ctx.fillStyle = config.colorByLabel ? colorForLabel(row.label || row._id, index) : getPalette(index);
          ctx.fillRect(x, y, barWidth, barHeight);
          boxes.push({ x: x, y: y, width: barWidth, height: barHeight, html: '<strong>' + (row.label || row._id || config.label || 'Value') + '</strong><div>Issues: ' + value + '</div>' });
          ctx.fillStyle = '#0f172a';
          ctx.textAlign = 'center';
          ctx.fillText(String(value), x + barWidth / 2, y - 8);
          ctx.save();
          ctx.translate(x + barWidth / 2, heightPx - 12);
          ctx.rotate(-(config.labelAngle || Math.PI / 5));
          ctx.fillStyle = '#64748b';
          var label = String(row.label || row._id || config.label || 'Value');
          var maxLabelLength = config.maxLabelLength || 16;
          ctx.fillText(label.length > maxLabelLength ? label.slice(0, maxLabelLength) + '…' : label, 0, 0);
          ctx.restore();
          ctx.textAlign = 'left';
        });
        setHitboxes(canvas, boxes);
      });
    }

    var statusCanvas = document.getElementById('statusMixChart');
