    function drawHorizontalBarChart(canvas, config) {
      if (!canvas) return;
      var series = [];
      try { series = JSON.parse(canvas.getAttribute('data-chart') || '[]'); } catch (error) { series = []; }
      series = series.filter(function (row) { return Number(row && row.count || 0) > 0; });
      if (!series.length) return;
      var shell = canvas.parentElement;
      var width = Math.max(config.minWidth || 420, Math.floor(shell.clientWidth || (config.minWidth || 420)));
      var height = Math.max(config.height || 220, series.length * (config.rowStep || 40) + 36);
      withCanvasSize(canvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 18, right: 22, bottom: 22, left: config.leftPadding || 130 };
        var chartWidth = widthPx - padding.left - padding.right;
        var rowHeight = config.rowHeight || 18;
        var gapY = config.gapY || 20;
        var maxValue = Math.max.apply(null, series.map(function (row) { return Number(row.count || 0); }).concat([1]));
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        for (var i = 0; i <= 4; i += 1) {
          var xTick = padding.left + (chartWidth / 4) * i;
          ctx.beginPath();
          ctx.moveTo(xTick, padding.top);
          ctx.lineTo(xTick, heightPx - padding.bottom);
          ctx.stroke();
          var tickValue = Math.round((maxValue / 4) * i);
          ctx.fillText(String(tickValue), xTick - 8, heightPx - 4);
        }
        series.forEach(function (row, index) {
          var y = padding.top + index * (rowHeight + gapY);
          var value = Number(row.count || 0);
          var widthBar = Math.max((value / maxValue) * chartWidth, value > 0 ? 4 : 0);
          ctx.fillStyle = config.colorByLabel ? colorForLabel(label, index) : getPalette(index);
          ctx.fillRect(padding.left, y, widthBar, rowHeight);
          ctx.fillStyle = '#0f172a';
          ctx.textAlign = 'right';
          var label = String(row.label || row._id || config.label || 'Value');
          ctx.fillText(label.length > (config.maxLabelLength || 22) ? label.slice(0, config.maxLabelLength || 22) + '…' : label, padding.left - 12, y + rowHeight * 0.72);
          ctx.textAlign = 'left';
          ctx.fillStyle = '#475569';
          ctx.fillText(String(value), Math.min(padding.left + widthBar + 8, widthPx - 24), y + rowHeight * 0.72);
          boxes.push({ x: padding.left, y: y, width: widthBar, height: rowHeight, html: '<strong>' + label + '</strong><div>Issues: ' + value + '</div>' });
        });
        setHitboxes(canvas, boxes);
      });
    }

    function drawGroupedVerticalBarChart(canvas, config) {
      if (!canvas) return;
      var series = [];
      try { series = JSON.parse(canvas.getAttribute('data-chart') || '[]'); } catch (error) { series = []; }
      series = series.filter(function (row) { return Number(row && row[config.primaryKey] || 0) > 0 || Number(row && row[config.secondaryKey] || 0) > 0; });
      if (!series.length) return;
      var shell = canvas.parentElement;
      var width = Math.max(config.minWidth || 520, Math.floor(shell.clientWidth || (config.minWidth || 520)));
      var height = config.height || 300;
      withCanvasSize(canvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 20, right: 14, bottom: config.bottomPadding || 96, left: 42 };
        var chartWidth = widthPx - padding.left - padding.right;
        var chartHeight = heightPx - padding.top - padding.bottom;
        var maxValue = Math.max.apply(null, series.map(function (row) { return Math.max(Number(row[config.primaryKey] || 0), Number(row[config.secondaryKey] || 0)); }).concat([1]));
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        ctx.lineWidth = 1;
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        for (var i = 0; i <= 4; i += 1) {
          var y = padding.top + (chartHeight / 4) * i;
          ctx.beginPath(); ctx.moveTo(padding.left, y); ctx.lineTo(widthPx - padding.right, y); ctx.stroke();
          var tickValue = Math.round(maxValue - (maxValue / 4) * i);
          ctx.fillText(String(tickValue), 8, y + 4);
        }
        var clusterWidth = chartWidth / Math.max(series.length, 1);
        var barWidth = Math.max(12, Math.min(20, (clusterWidth - 10) / 2));
        series.forEach(function (row, index) {
          var baseX = padding.left + index * clusterWidth + Math.max((clusterWidth - (barWidth * 2 + 6)) / 2, 0);
          [config.primaryKey, config.secondaryKey].forEach(function (key, seriesIndex) {
            var value = Number(row[key] || 0);
            var x = baseX + seriesIndex * (barWidth + 6);
            var barHeight = value > 0 ? Math.max((value / maxValue) * chartHeight, 4) : 0;
            var y = padding.top + chartHeight - barHeight;
            ctx.fillStyle = seriesIndex === 0 ? '#7C3AED' : '#00C2A8';
            if (barHeight > 0) ctx.fillRect(x, y, barWidth, barHeight);
            boxes.push({ x: x, y: y, width: barWidth, height: Math.max(barHeight, 10), html: '<strong>' + (row.label || 'Item') + '</strong><div>' + (seriesIndex === 0 ? config.primaryLabel : config.secondaryLabel) + ': ' + value + '</div><div>Risk rate: ' + Math.round(Number(row.breachRate || 0) * 100) + '%</div>' });
          });
          ctx.save(); ctx.translate(padding.left + index * clusterWidth + clusterWidth / 2, heightPx - 12); ctx.rotate(-Math.PI / 5); ctx.fillStyle = '#64748b';
          var label = String(row.label || 'Item');
          ctx.textAlign = 'center';
          ctx.fillText(label.length > 14 ? label.slice(0, 14) + '…' : label, 0, 0);
          ctx.restore(); ctx.textAlign = 'left';
        });
        setHitboxes(canvas, boxes);
      });
    }

    function drawGroupedHorizontalBarChart(canvas, config) {
      if (!canvas) return;
      var series = [];
      try { series = JSON.parse(canvas.getAttribute('data-chart') || '[]'); } catch (error) { series = []; }
      series = series.filter(function (row) { return Number(row && row[config.primaryKey] || 0) > 0 || Number(row && row[config.secondaryKey] || 0) > 0; });
      if (!series.length) return;
      var shell = canvas.parentElement;
      var width = Math.max(config.minWidth || 520, Math.floor(shell.clientWidth || (config.minWidth || 520)));
      var height = Math.max(config.height || 280, series.length * 46 + 40);
      withCanvasSize(canvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 18, right: 24, bottom: 24, left: config.leftPadding || 170 };
        var chartWidth = widthPx - padding.left - padding.right;
        var rowGap = 20;
        var groupHeight = 22;
        var barHeight = 8;
        var maxValue = Math.max.apply(null, series.map(function (row) { return Math.max(Number(row[config.primaryKey] || 0), Number(row[config.secondaryKey] || 0)); }).concat([1]));
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        for (var i = 0; i <= 4; i += 1) {
          var xTick = padding.left + (chartWidth / 4) * i;
          ctx.beginPath(); ctx.moveTo(xTick, padding.top); ctx.lineTo(xTick, heightPx - padding.bottom); ctx.stroke();
          var tickValue = ((maxValue / 4) * i).toFixed(1);
          ctx.fillText(tickValue + (config.unitSuffix || ''), xTick - 10, heightPx - 4);
        }
        series.forEach(function (row, index) {
          var y = padding.top + index * (groupHeight + rowGap);
          var primary = Number(row[config.primaryKey] || 0);
          var secondary = Number(row[config.secondaryKey] || 0);
          var primaryWidth = primary > 0 ? Math.max((primary / maxValue) * chartWidth, 4) : 0;
          var secondaryWidth = secondary > 0 ? Math.max((secondary / maxValue) * chartWidth, 4) : 0;
          ctx.fillStyle = '#0f172a'; ctx.textAlign = 'right';
          var label = String(row.label || 'Stage');
          ctx.fillText(label.length > 26 ? label.slice(0, 26) + '…' : label, padding.left - 12, y + 13);
          ctx.textAlign = 'left';
          ctx.fillStyle = '#7C3AED'; if (primaryWidth > 0) ctx.fillRect(padding.left, y, primaryWidth, barHeight);
          ctx.fillStyle = '#00C2A8'; if (secondaryWidth > 0) ctx.fillRect(padding.left, y + 12, secondaryWidth, barHeight);
          boxes.push({ x: padding.left, y: y, width: Math.max(primaryWidth, 10), height: barHeight, html: '<strong>' + label + '</strong><div>' + config.primaryLabel + ': ' + primary.toFixed(1) + (config.unitSuffix || '') + '</div>' });
          boxes.push({ x: padding.left, y: y + 12, width: Math.max(secondaryWidth, 10), height: barHeight, html: '<strong>' + label + '</strong><div>' + config.secondaryLabel + ': ' + secondary.toFixed(1) + (config.unitSuffix || '') + '</div>' });
        });
        setHitboxes(canvas, boxes);
      });
    }

