<%
  const selected = reports.filters || {};
  const hasDateRange = reports.filterMode === 'date_range';
  const isSelected = (bucket, value) => Array.isArray(bucket) && bucket.includes(String(value));
  const dashboardAudience = dashboardRole || (currentUser?.role === 'client' ? 'client' : 'admin');
  const isAdminDashboard = dashboardAudience === 'admin';
  const isManagerDashboard = dashboardAudience === 'manager';
  const isAgentDashboard = dashboardAudience === 'agent';
  const isClientDashboard = dashboardAudience === 'client';
  const isInternalDashboard = !isClientDashboard;
  const showDistributionRow = isAdminDashboard;
  const showStatusSeverityMix = isAdminDashboard || isManagerDashboard;
  const showBacklogAndRisk = isInternalDashboard;
  const showWorkloadImbalance = isAdminDashboard || isManagerDashboard;
  const showFlowEfficiency = !isAgentDashboard;
  const showClosedSla = isAdminDashboard || isManagerDashboard;
  const audienceLabel = isAdminDashboard
    ? 'Admin view'
    : isManagerDashboard
      ? 'Manager view'
      : isAgentDashboard
        ? 'Agent view'
        : 'Client view';
  const audienceDescription = isAdminDashboard
    ? 'Full tenant-wide analytics with governance, distribution, workload, and flow visibility.'
    : isManagerDashboard
      ? 'Scoped operational visibility for the entities and teams you are responsible for.'
      : isAgentDashboard
        ? 'A sharper operational view focused on your queue, risk, and what needs attention now.'
        : 'A cleaner customer-facing view limited to your visible scope and statuses.';
  const isClientAudience = reports.audience === 'client';
  const lifecycleTrend = Array.isArray(reports.issueLifecycleTrend) ? reports.issueLifecycleTrend : [];
  const summaryWindowLabel = hasDateRange
    ? `${new Date(reports.since).toLocaleDateString()} → ${new Date(reports.until).toLocaleDateString()}`
    : `Last ${reports.appliedDays} day${reports.appliedDays === 1 ? '' : 's'}`;
  const totalRaised = lifecycleTrend.reduce((sum, row) => sum + Number(row.raised || 0), 0);
  const totalClosed = lifecycleTrend.reduce((sum, row) => sum + Number(row.closed || 0), 0);
  const totalClosedWithinSla = lifecycleTrend.reduce((sum, row) => sum + Number(row.closedWithinSla || 0), 0);
  const totalClosedBreachedSla = lifecycleTrend.reduce((sum, row) => sum + Number(row.closedBreachedSla || 0), 0);
  const pct = (value, total) => total ? Math.round((Number(value || 0) / total) * 100) : 0;
  const severityMix = Array.isArray(reports.volumeBySeverity) ? reports.volumeBySeverity : [];
  const totalSeverityCount = severityMix.reduce((sum, row) => sum + Number(row.count || 0), 0);
  const statusMix = Array.isArray(reports.statusCounts) ? reports.statusCounts : [];
  const statusSeverityMix = Array.isArray(reports.statusSeverityBreakdown) ? reports.statusSeverityBreakdown : [];
  const closedSla = reports.closedSla || { summary: {}, stages: [] };
  const closedSlaSummary = closedSla.summary || {};
  const closedSlaStages = Array.isArray(closedSla.stages) ? closedSla.stages : [];
  const distributions = reports.dashboardDistributions || {};
  const topClients = Array.isArray(distributions.topClients) ? distributions.topClients : [];
  const topAgents = Array.isArray(distributions.topAgents) ? distributions.topAgents : [];
  const productMix = Array.isArray(distributions.products) ? distributions.products : [];
  const regionMix = Array.isArray(distributions.regions) ? distributions.regions : [];
  const opsInsights = reports.operationalInsights || {};
  const backlogAging = Array.isArray(opsInsights.backlogAging) ? opsInsights.backlogAging : [];
  const openBacklogByStatus = Array.isArray(opsInsights.openBacklogByStatus) ? opsInsights.openBacklogByStatus : [];
  const slaRiskSplit = Array.isArray(opsInsights.slaRiskSplit) ? opsInsights.slaRiskSplit : [];
  const workloadImbalance = Array.isArray(opsInsights.workloadImbalance) ? opsInsights.workloadImbalance : [];
  const flowEfficiency = Array.isArray(opsInsights.flowEfficiency) ? opsInsights.flowEfficiency : [];
  const stageTracker = Array.isArray(reports.stageTracker) ? reports.stageTracker : [];
  const openBacklogTotal = backlogAging.reduce((sum, row) => sum + Number(row.count || 0), 0);
  const slaRiskTotal = slaRiskSplit.reduce((sum, row) => sum + Number(row.count || 0), 0);
%>

<section class="hero gradient-quirky dashboard-hero dashboard-hero-polished">
  <div>
    <div class="section-kicker">Dashboard studio</div>
    <h1>Dashboards</h1>
  </div>
</section>

<section class="card section-card dashboard-filter-shell dashboard-filter-shell-polished">
  <div class="page-header compact-header dashboard-filter-head">
    <div>
      <h2>Dashboard filters</h2>
      <p class="muted">Choose the window and scope first. All charts below refresh from the same filter set.</p>
    </div>
  </div>

  <form method="get" action="<%= basePath %>/dashboards" class="dashboard-filter-form stack">
    <div class="dashboard-quick-window-strip">
      <span class="filter-label">Quick window</span>
      <div class="pill-row compact-window-pills">
        <% [[1,'1D'], [7,'7D'], [14,'14D'], [30,'30D'], [60,'60D'], [90,'90D'], [180,'6M'], [365,'1Y']].forEach((option) => { %>
          <button class="pill-button <%= reports.appliedDays === option[0] && !hasDateRange ? 'active' : '' %>" type="submit" name="days" value="<%= option[0] %>"><%= option[1] %></button>
        <% }) %>
      </div>
    </div>

    <div class="dashboard-filter-row dashboard-filter-row-top dashboard-filter-row-no-window">
      <label>
        <span>From date</span>
        <input type="date" name="fromDate" value="<%= selected.fromDate || '' %>" />
      </label>
      <label>
        <span>To date</span>
        <input type="date" name="toDate" value="<%= selected.toDate || '' %>" />
      </label>
      <label class="dashboard-filter-grow">
        <span>Client / entity</span>
        <div class="token-multiselect" data-multiselect data-min-search="3" data-placeholder="Type 3 letters to find an entity">
          <select name="clientId" multiple hidden>
            <% (reports.filterOptions.entities || []).forEach((entity) => { %>
              <option value="<%= entity._id %>" <%= isSelected(selected.clientIds, String(entity._id)) ? 'selected' : '' %>><%= entity.path || entity.name %></option>
            <% }) %>
          </select>
        </div>
      </label>
      <label>
        <span>Severity</span>
        <div class="token-multiselect" data-multiselect data-min-search="0" data-placeholder="Choose severity">
          <select name="severity" multiple hidden>
            <% (reports.filterOptions.priorities || []).forEach((item) => { %>
              <option value="<%= item.value %>" <%= isSelected(selected.severities, item.value) ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </div>
      </label>
    </div>

    <div class="dashboard-filter-row dashboard-filter-row-bottom">
      <label>
        <span>Type</span>
        <div class="token-multiselect" data-multiselect data-min-search="0" data-placeholder="Choose type">
          <select name="requestType" multiple hidden>
            <% (reports.filterOptions.requestTypes || []).forEach((item) => { %>
              <option value="<%= item.value %>" <%= isSelected(selected.requestTypes, item.value) ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </div>
      </label>
      <label class="dashboard-filter-grow">
        <span>Status</span>
        <div class="token-multiselect" data-multiselect data-min-search="3" data-placeholder="Type 3 letters to find a status">
          <select name="status" multiple hidden>
            <% (reports.filterOptions.statuses || []).forEach((item) => { %>
              <option value="<%= item.value %>" <%= isSelected(selected.statuses, item.value) ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </div>
      </label>
      <% if (!isClientAudience) { %>
        <label class="dashboard-filter-grow">
          <span>Assigned agent</span>
          <div class="token-multiselect" data-multiselect data-min-search="3" data-placeholder="Type 3 letters to find an agent">
            <select name="assignedToUserId" multiple hidden>
              <% (reports.filterOptions.agents || []).forEach((agent) => { %>
                <option value="<%= agent._id %>" <%= isSelected(selected.assignedToUserIds, String(agent._id)) ? 'selected' : '' %>><%= agent.name %> (<%= agent.role %>)</option>
              <% }) %>
            </select>
          </div>
        </label>
      <% } %>
      <div class="dashboard-filter-actions">
        <a class="button-link secondary" href="<%= basePath %>/dashboards?days=30">Reset</a>
        <button type="submit" class="reports-apply-button">Apply</button>
      </div>
    </div>
  </form>
</section>




<%
  const v34WeeklyMap = new Map();
  const v34MonthlyMap = new Map();
  lifecycleTrend.forEach((row) => {
    const d = new Date(row.date + 'T00:00:00');
    const weekStart = new Date(d); weekStart.setDate(d.getDate() - d.getDay());
    const weekKey = weekStart.toISOString().slice(0,10);
    const monthKey = row.date ? row.date.slice(0,7) : 'Unknown';
    [{ map: v34WeeklyMap, key: weekKey }, { map: v34MonthlyMap, key: monthKey }].forEach((bucket) => {
      const item = bucket.map.get(bucket.key) || { label: bucket.key, raised: 0, closed: 0, within: 0, breached: 0 };
      item.raised += Number(row.raised || 0); item.closed += Number(row.closed || 0); item.within += Number(row.closedWithinSla || 0); item.breached += Number(row.closedBreachedSla || 0);
      bucket.map.set(bucket.key, item);
    });
  });
  const v34WeeklyRows = Array.from(v34WeeklyMap.values()).slice(-8).reverse();
  const v34MonthlyRows = Array.from(v34MonthlyMap.values()).slice(-6).reverse();
%>
<section class="grid-two dashboard-secondary-grid dashboard-section-gap">
  <article class="card section-card dashboard-period-table-card">
    <div class="section-title-row"><div><h2>Weekly SLA movement</h2><p class="muted small">Created, resolved, within SLA and breached SLA by week.</p></div><a class="button-link secondary chart-download-button icon-only" href="<%= basePath %>/reports/export/card.csv?<%= reports.reportQueryString %>&type=volume-trend" title="Download XLS-compatible CSV">▦</a></div>
    <div class="table-responsive"><table><thead><tr><th>Week</th><th>Created</th><th>Resolved</th><th>Within SLA</th><th>Breached SLA</th><th>SLA %</th></tr></thead><tbody><% v34WeeklyRows.forEach((row) => { %><tr><td><%= row.label %></td><td><%= row.raised %></td><td><%= row.closed %></td><td><span class="pill success-soft"><%= row.within %></span></td><td><span class="pill danger-soft"><%= row.breached %></span></td><td><%= row.closed ? Math.round((row.within / row.closed) * 100) : 0 %>%</td></tr><% }) %></tbody></table></div>
  </article>
  <article class="card section-card dashboard-period-table-card">
    <div class="section-title-row"><div><h2>Monthly SLA movement</h2><p class="muted small">Created, resolved, within SLA and breached SLA by month.</p></div><a class="button-link secondary chart-download-button icon-only" href="<%= basePath %>/reports/export/card.csv?<%= reports.reportQueryString %>&type=volume-trend" title="Download XLS-compatible CSV">▦</a></div>
    <div class="table-responsive"><table><thead><tr><th>Month</th><th>Created</th><th>Resolved</th><th>Within SLA</th><th>Breached SLA</th><th>SLA %</th></tr></thead><tbody><% v34MonthlyRows.forEach((row) => { %><tr><td><%= row.label %></td><td><%= row.raised %></td><td><%= row.closed %></td><td><span class="pill success-soft"><%= row.within %></span></td><td><span class="pill danger-soft"><%= row.breached %></span></td><td><%= row.closed ? Math.round((row.within / row.closed) * 100) : 0 %>%</td></tr><% }) %></tbody></table></div>
  </article>
</section>

<section class="dashboard-canvas-grid dashboard-section-gap">
  <article class="card section-card dashboard-span-8 dashboard-panel-card dashboard-card-tall dashboard-card-elevated">
    <div class="dashboard-panel-head">
      <div>
        <h2>Issues raised vs closed</h2>
        <p class="muted">Trend over the selected window. Click the legend pills to hide or show a line.</p>
      </div>
      <div class="dashboard-inline-stats">
        <div class="mini-stat mini-stat-soft"><span class="muted small">Raised</span><strong><%= totalRaised %></strong></div>
        <div class="mini-stat mini-stat-soft"><span class="muted small">Closed</span><strong><%= totalClosed %></strong></div>
        <button type="button" class="secondary chart-download-button icon-only" data-download-chart="issueLifecycleTrendChart" aria-label="Download chart" title="Download chart">⬇</button>
      </div>
    </div>
    <% if (!lifecycleTrend.length) { %>
      <p class="muted">No issue activity found for the selected filters.</p>
    <% } else { %>
      <div class="dashboard-chart-legend dashboard-line-toggle-legend" data-line-toggle>
        <button type="button" class="legend-toggle-button is-active" data-series="raised"><span class="legend-swatch legend-swatch-raised"></span>Issues raised</button>
        <button type="button" class="legend-toggle-button is-active" data-series="closed"><span class="legend-swatch legend-swatch-closed"></span>Issues closed</button>
        <button type="button" class="legend-toggle-button" data-series="closedWithinSla"><span class="legend-swatch legend-swatch-met"></span>Closed within SLA — <%= totalClosedWithinSla %> (<%= pct(totalClosedWithinSla, totalClosed) %>%)</button>
        <button type="button" class="legend-toggle-button" data-series="closedBreachedSla"><span class="legend-swatch legend-swatch-breached"></span>Closed breached SLA — <%= totalClosedBreachedSla %> (<%= pct(totalClosedBreachedSla, totalClosed) %>%)</button>
      </div>
      <div class="dashboard-chart-shell dashboard-chart-shell-grow dashboard-fixed-height-shell-lg">
        <canvas id="issueLifecycleTrendChart" class="dashboard-line-chart" data-chart='<%- JSON.stringify(lifecycleTrend) %>'></canvas>
      </div>
    <% } %>
  </article>

  <aside class="card section-card dashboard-span-4 dashboard-panel-card dashboard-card-tall dashboard-card-elevated dashboard-severity-card-compact">
    <div class="dashboard-panel-head dashboard-panel-head-tight">
      <div>
        <h2>Issues by severity</h2>
        <p class="muted">Reflects the currently configured severity catalog.</p>
      </div>
      <div class="dashboard-inline-stats"><div class="mini-stat mini-stat-highlight"><span class="muted small">Total</span><strong><%= totalSeverityCount %></strong></div><div class="mini-stat mini-stat-danger"><span class="muted small">Breached SLA</span><strong><%= reports.stats.slaBreached %></strong></div><button type="button" class="secondary chart-download-button icon-only" data-download-chart="severityMixChart" aria-label="Download chart" title="Download chart">⬇</button></div>
    </div>
    <% if (!severityMix.length || !totalSeverityCount) { %>
      <p class="muted">No severity data available for the selected filters.</p>
    <% } else { %>
      <div class="dashboard-donut-shell dashboard-fixed-height-shell-lg">
        <canvas id="severityMixChart" class="dashboard-donut-chart" data-chart='<%- JSON.stringify(severityMix) %>'></canvas>
        <div class="dashboard-donut-center-copy">
          <span class="muted small">Issues</span>
          <strong><%= totalSeverityCount %></strong>
        </div>
      </div>
      <div class="dashboard-donut-legend dashboard-donut-legend-compact">
        <% severityMix.filter((row) => Number(row.count || 0) > 0).forEach((row, index) => { %>
          <div class="dashboard-donut-legend-row dashboard-donut-legend-row-compact">
            <div class="dashboard-donut-label-wrap">
              <span class="legend-swatch severity-dot severity-swatch-<%= index % 8 %>"></span>
              <span><%= row.label || row._id %></span>
            </div>
            <div class="dashboard-donut-values">
              <strong><%= row.count %></strong>
              <span class="muted small"><%= totalSeverityCount ? Math.round((row.count / totalSeverityCount) * 100) : 0 %>%</span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </aside>
</section>



<section class="dashboard-canvas-grid dashboard-section-gap">
  <article class="card section-card <%= showStatusSeverityMix ? 'dashboard-span-6' : 'dashboard-span-12' %> dashboard-panel-card dashboard-card-medium dashboard-card-elevated">
    <div class="dashboard-panel-head">
      <div>
        <h2>Issues by status</h2>
        <p class="muted">Status distribution for the current filter window.</p>
      </div>
      <div class="dashboard-inline-stats"><div class="mini-stat mini-stat-soft"><span class="muted small">Statuses</span><strong><%= statusMix.filter((row) => Number(row.count || 0) > 0).length %></strong></div><div class="mini-stat mini-stat-soft"><span class="muted small">Issues</span><strong><%= statusMix.reduce((sum, row) => sum + Number(row.count || 0), 0) %></strong></div><div class="mini-stat mini-stat-danger"><span class="muted small">Breached SLA</span><strong><%= reports.stats.slaBreached %></strong></div><button type="button" class="secondary chart-download-button icon-only" data-download-chart="statusMixChart" aria-label="Download chart" title="Download chart">⬇</button></div>
    </div>
    <% if (!statusMix.length || !statusMix.some((row) => Number(row.count || 0) > 0)) { %>
      <p class="muted">No status data available for the selected filters.</p>
    <% } else { %>
      <div class="dashboard-chart-shell dashboard-chart-shell-grow dashboard-fixed-height-shell-md">
        <canvas id="statusMixChart" class="dashboard-line-chart dashboard-bar-chart" data-chart='<%- JSON.stringify(statusMix) %>'></canvas>
      </div>
    <% } %>
  </article>

  <% if (showStatusSeverityMix) { %>
