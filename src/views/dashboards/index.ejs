    </div>
    <% if (!statusSeverityMix.length || !statusSeverityMix.some((row) => Number(row.total || 0) > 0)) { %>
      <p class="muted">No status-severity data available for the selected filters.</p>
    <% } else { %>
      <div class="dashboard-chart-shell dashboard-chart-shell-grow dashboard-fixed-height-shell-md">
        <canvas id="statusSeverityChart" class="dashboard-line-chart dashboard-bar-chart" data-chart='<%- JSON.stringify(statusSeverityMix) %>'></canvas>
      </div>
      <div class="dashboard-chart-legend dashboard-chart-legend-tight">
        <% severityMix.filter((row) => Number(row.count || 0) > 0).forEach((row, index) => { %>
          <span class="legend-item"><span class="legend-swatch severity-swatch-<%= index % 8 %>"></span><%= row.label || row._id %></span>
        <% }) %>
      </div>
    <% } %>
  </article>
  <% } %>
</section>

