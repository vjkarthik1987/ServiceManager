    var slaCanvas = document.getElementById('closedSlaChart');
    function drawClosedSlaChart() {
      if (!slaCanvas) return;
      var stages = [];
      try { stages = JSON.parse(slaCanvas.getAttribute('data-chart') || '[]'); } catch (error) { stages = []; }
      stages = stages.filter(function (row) { return Number(row && row.avgMinutes || 0) > 0; });
      if (!stages.length) return;
      var shell = slaCanvas.parentElement;
      var width = Math.max(720, Math.floor(shell.clientWidth || 720));
      var height = Math.max(320, stages.length * 48 + 48);
      withCanvasSize(slaCanvas, width, height, function (ctx, widthPx, heightPx) {
        var boxes = [];
        var padding = { top: 18, right: 22, bottom: 24, left: 170 };
        var chartWidth = widthPx - padding.left - padding.right;
        var rowHeight = 24;
        var gapY = 20;
        var maxValue = Math.max.apply(null, stages.map(function (row) { return Number(row.avgMinutes || 0); }).concat([1]));
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#64748b';
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
        for (var i = 0; i <= 4; i += 1) {
          var xTick = padding.left + (chartWidth / 4) * i;
          ctx.beginPath();
          ctx.moveTo(xTick, padding.top);
          ctx.lineTo(xTick, heightPx - padding.bottom);
          ctx.stroke();
          var hours = (maxValue / 60 / 4) * i;
          ctx.fillText(hours.toFixed(1) + 'h', xTick - 10, heightPx - 4);
        }
        stages.forEach(function (row, index) {
          var y = padding.top + index * (rowHeight + gapY);
          var widthBar = Math.max((Number(row.avgMinutes || 0) / maxValue) * chartWidth, 4);
          ctx.fillStyle = '#7C3AED';
          ctx.fillRect(padding.left, y, widthBar, rowHeight);
          ctx.fillStyle = '#0f172a';
          ctx.textAlign = 'right';
          var label = String(row.label || row._id || 'Stage');
          ctx.fillText(label.length > 28 ? label.slice(0, 28) + '…' : label, padding.left - 12, y + rowHeight * 0.72);
          ctx.textAlign = 'left';
          ctx.fillStyle = '#475569';
          ctx.fillText((Number(row.avgHours || 0)).toFixed(1) + 'h', Math.min(padding.left + widthBar + 8, widthPx - 30), y + rowHeight * 0.72);
          boxes.push({ x: padding.left, y: y, width: widthBar, height: rowHeight, html: '<strong>' + (row.label || row._id || 'Stage') + '</strong><div>Average: ' + (Number(row.avgHours || 0)).toFixed(1) + 'h</div><div>Visits: ' + (row.visits || 0) + '</div>' });
        });
        setHitboxes(slaCanvas, boxes);
      });
    }
    drawClosedSlaChart();
    window.addEventListener('resize', drawClosedSlaChart);
  })();
    document.querySelectorAll('[data-download-chart]').forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.getAttribute('data-download-chart');
        var canvas = document.getElementById(id);
        if (!canvas) return;
        var link = document.createElement('a');
        link.download = (id || 'dashboard-chart') + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    });
    document.querySelectorAll('.dashboard-panel-card').forEach(function (card) {
      var canvas = card.querySelector('canvas[id]');
      var head = card.querySelector('.dashboard-panel-head');
      if (!canvas || !head || head.querySelector('[data-download-chart="' + canvas.id + '"]')) return;
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'secondary chart-download-button icon-only';
      btn.setAttribute('data-download-chart', canvas.id);
      btn.setAttribute('aria-label', 'Download chart');
      btn.setAttribute('title', 'Download chart');
      btn.textContent = '⬇';
      btn.addEventListener('click', function () {
        var link = document.createElement('a');
        link.download = canvas.id + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
      head.appendChild(btn);
    });

