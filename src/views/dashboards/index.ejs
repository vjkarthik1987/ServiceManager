<section class="dashboard-canvas-grid dashboard-section-gap">
  <article class="card section-card dashboard-span-6 dashboard-panel-card dashboard-card-elevated dashboard-card-medium">
    <div class="dashboard-panel-head">
      <div>
        <h2>Backlog intelligence</h2>
        <p class="muted">Open issues only. Shows what is aging and where work is stuck.</p>
      </div>
