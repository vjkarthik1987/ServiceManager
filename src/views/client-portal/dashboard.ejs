<section class="hero gradient-quirky client-dashboard-hero">
  <div>
    <div class="section-kicker">Client workspace</div>
    <h1>Welcome <%= currentUser && currentUser.name ? currentUser.name : 'back' %></h1>
    <% const scopeNames = (scopedEntities || []).slice(0, 6).map((entity) => entity.path || entity.name); %>
    <p class="muted welcome-scope-line"><strong>Your clients:</strong> <%= scopeNames.length ? scopeNames.join(', ') : 'No active client/entity assigned yet' %><%= (scopedEntities || []).length > 6 ? ` +${(scopedEntities || []).length - 6} more` : '' %></p>
    <p class="muted client-dashboard-subcopy">A calmer, clearer view of what needs your attention, what is moving, and where you may need to respond.</p>
  </div>
  <div class="hero-actions wrap-actions hero-actions-inline">
    <a class="button-link secondary" href="<%= basePath %>/client/issues">My Issues</a>
    <a class="button-link" href="<%= basePath %>/client/issues/new">Raise Issue</a>
  </div>
</section>

<section class="client-dashboard-overview-grid">
  <article class="card client-overview-card accent-mint">
    <div class="client-overview-eyebrow">Open across your scope</div>
    <div class="client-overview-value"><%= stats.myOpenIssues %></div>
    <div class="client-overview-meta">Issues that still need action or tracking</div>
  </article>
  <article class="card client-overview-card accent-yellow">
    <div class="client-overview-eyebrow">Waiting for your input</div>
    <div class="client-overview-value"><%= stats.waitingForMe %></div>
    <div class="client-overview-meta">Blocked until your team responds or confirms</div>
  </article>
  <article class="card client-overview-card accent-purple">
    <div class="client-overview-eyebrow">Resolved recently</div>
    <div class="client-overview-value"><%= stats.resolvedRecently %></div>
    <div class="client-overview-meta">Resolved, closed, or ready to close</div>
  </article>
  <article class="card client-overview-card accent-blue">
    <div class="client-overview-eyebrow">Touched today</div>
    <div class="client-overview-value"><%= stats.updatedToday %></div>
    <div class="client-overview-meta">Fresh movement since midnight</div>
  </article>
</section>

<section class="card section-card client-transparency-card">
  <div class="section-title-row">
    <div><h2>Client operational health</h2><p class="muted small">A transparent v35 score based on SLA breaches, reopened issues, and stale open items in your scope.</p></div>
    <span class="pill <%= stats.healthScore < 70 ? 'danger-soft' : stats.healthScore < 85 ? 'warning-soft' : 'success-soft' %>">Health <%= stats.healthScore %>/100</span>
  </div>
  <div class="dashboard-inline-stats">
    <div class="mini-stat mini-stat-danger"><span class="muted small">Breached SLA</span><strong><%= stats.slaBreached %></strong></div>
    <div class="mini-stat mini-stat-soft"><span class="muted small">Reopened</span><strong><%= stats.reopenedIssues %></strong></div>
    <div class="mini-stat mini-stat-soft"><span class="muted small">Stale open</span><strong><%= stats.staleOpen %></strong></div>
  </div>
</section>

<section class="card section-card client-recent-issues-card client-home-after-health">
  <div class="page-header">
    <div>
      <h2>Recent updates</h2>
      <p class="muted">Showing the latest 10 customer-visible issues across your scope.</p>
    </div>
    <a class="button-link secondary" href="<%= basePath %>/client/issues">View all</a>
  </div>
  <% if (!recentIssues.length) { %>
    <p class="muted">No customer-visible issues yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Issue</th>
            <th>Title</th>
            <th>Entity</th>
            <th>Customer Status</th>
            <th>Updated</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% recentIssues.forEach((issue) => { %>
            <tr>
              <td><a href="<%= basePath %>/tickets/<%= issue._id %>"><strong><%= issue.issueNumber %></strong></a></td>
              <td>
                <div class="client-issue-title-cell">
                  <span><%= issue.title %></span>
                  <% if (issue.isRecentlyUpdated) { %><span class="pill brand-soft">Updated today</span><% } %>
                </div>
              </td>
              <td><%= issue.entityId ? issue.entityId.path || issue.entityId.name : '-' %></td>
              <td>
                <span class="pill <%= issue.isWaitingForClient ? 'warning-soft' : (issue.clientStatusBucket === 'CLOSED' ? 'success-soft' : 'brand-soft') %>"><%= issue.customerStatusLabel %></span>
              </td>
              <td><%= issue.updatedAt ? new Date(issue.updatedAt).toLocaleString() : '-' %></td>
              <td><a href="<%= basePath %>/tickets/<%= issue._id %>">Open</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
