
<section class="hero gradient-quirky dashboard-hero product-module-hero">
  <div><div class="section-kicker">Product catalogue</div><h1>Products & Modules</h1><p class="muted">Keep product and module masters in one clean workspace for routing, reporting, SLA and AI context.</p></div>
  <div class="hero-actions wrap-actions"><a class="button-link" href="<%= basePath %>/admin/products/new">+ Product</a><a class="button-link secondary" href="<%= basePath %>/admin/modules/new">+ Module</a></div>
</section>
<section class="grid-two product-module-grid">
  <div class="card stack section-card taxonomy-card"><div class="section-title-row"><div><h2>Products</h2><p class="muted small">Reusable product options for entities and issues.</p></div><span class="pill brand-soft"><%= items.length %></span></div>
  <% if (!items.length) { %><p class="muted">No products configured yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Code</th><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody><% items.forEach((item)=>{ %><tr><td><strong><%= item.code %></strong></td><td><%= item.name %></td><td><%= item.description || '-' %></td><td><span class="pill <%= item.isActive ? 'brand-soft' : 'subtle' %>"><%= item.isActive ? 'ACTIVE' : 'INACTIVE' %></span></td><td><div class="inline-actions wrap-actions"><a href="<%= basePath %>/admin/products/<%= item._id %>/edit">Edit</a><form method="post" action="<%= basePath %>/admin/products/<%= item._id %>/status" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="isActive" value="<%= item.isActive ? 'false' : 'true' %>" /><button type="submit" class="link-button <%= item.isActive ? 'danger-link-button' : '' %>"><%= item.isActive ? 'Deactivate' : 'Activate' %></button></form></div></td></tr><% }) %></tbody></table></div><% } %></div>
  <div class="card stack section-card taxonomy-card"><div class="section-title-row"><div><h2>Modules</h2><p class="muted small">Functional modules for better ownership and issue intelligence.</p></div><span class="pill brand-soft"><%= (modules || []).length %></span></div>
  <% if (!(modules || []).length) { %><p class="muted">No modules configured yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Code</th><th>Name</th><th>Owner</th><th>Criticality</th><th>Status</th><th></th></tr></thead><tbody><% modules.forEach((item)=>{ %><tr><td><strong><%= item.code %></strong></td><td><%= item.name %></td><td><%= item.ownerTeam || '-' %></td><td><span class="pill"><%= item.criticality || 'MEDIUM' %></span></td><td><span class="pill <%= item.isActive ? 'brand-soft' : 'subtle' %>"><%= item.isActive ? 'ACTIVE' : 'INACTIVE' %></span></td><td><div class="inline-actions wrap-actions"><a href="<%= basePath %>/admin/modules/<%= item._id %>/edit">Edit</a><form method="post" action="<%= basePath %>/admin/modules/<%= item._id %>/status" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="isActive" value="<%= item.isActive ? 'false' : 'true' %>" /><button type="submit" class="link-button <%= item.isActive ? 'danger-link-button' : '' %>"><%= item.isActive ? 'Deactivate' : 'Activate' %></button></form></div></td></tr><% }) %></tbody></table></div><% } %></div>
</section>
