<section class="page-header"><div><h1>Agent Assignment</h1><p class="muted">Assign agent users and managers to client entities, and review current assignments in one place.</p></div><a class="button-link secondary" href="<%= basePath %>/users">Back to Users</a></section>
<div class="assignment-page-stack">
<section class="card form-card stack">
  <form method="post" action="<%= basePath %>/assignments/agent" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <label><span>Agent</span><select name="agentUserId" required><option value="">Select agent</option><% agents.forEach((agent) => { %><option value="<%= agent._id %>"><%= agent.name %> · <%= agent.email %> · <%= agent.role %></option><% }) %></select></label>
      <label><span>Client / entity</span><select name="entityId" required><option value="">Select entity</option><% entities.forEach((entity) => { %><option value="<%= entity._id %>"><%= entity.path %> (<%= entity.type %>)</option><% }) %></select></label>
    </div>
    <div class="form-actions right wrap-actions"><a class="button-link secondary" href="<%= basePath %>/users">Back to Users</a><button class="btn" type="submit">Save assignment</button></div>
  </form>
</section>

</section>

<section class="card section-card stack">
  <div class="page-header compact-header"><div><h2>Current agent assignments</h2><p class="muted">One row per agent, with all assigned clients and sub-clients shown clearly.</p></div></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Agent</th><th>Email</th><th>Role</th><th>Assigned clients / entities</th><th>Status</th></tr></thead>
      <tbody>
        <% (assignmentTable || []).forEach((row) => { %>
          <tr>
            <td><strong><%= row.name %></strong></td>
            <td><%= row.email %></td>
            <td><span class="pill"><%= row.role %></span></td>
            <td>
              <% if (!(row.entities || []).length) { %>
                <span class="muted">No client entities assigned yet.</span>
              <% } else { %>
                <div class="chip-stack assignment-chip-stack">
                  <% row.entities.forEach((entity) => { %>
                    <form method="post" action="<%= basePath %>/assignments/<%= entity.membershipId %>/remove" class="assignment-chip-form" onsubmit="return confirm('Remove this client/entity assignment from the agent?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <span class="pill subtle assignment-pill">
                        <span><%= entity.path || entity.name %><% if (entity.isPrimary) { %> · Primary<% } %></span>
                        <button type="submit" class="assignment-pill-remove" title="Remove assignment" aria-label="Remove assignment">×</button>
                      </span>
                    </form>
                  <% }) %>
                </div>
              <% } %>
            </td>
            <td><span class="pill <%= row.isActive ? 'success-soft' : 'danger-soft' %>"><%= row.isActive ? 'Active' : 'Inactive' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

</div>
