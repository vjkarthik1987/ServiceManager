<section class='page-header'><div><div class='section-kicker'>Operational taxonomy</div><h1>Modules</h1><p class='muted'>Reusable module master. Select these modules on entities and issues for better routing, SLA, RCA, and dashboard intelligence.</p></div><a class='button-link' href='<%= basePath %>/admin/modules/new'>+ Module</a></section>
<section class='card'>
<% if (!items.length) { %><p class='muted'>No modules configured yet.</p><% } else { %>
<div class='table-wrap'><table><thead><tr><th>Code</th><th>Name</th><th>Owner</th><th>Criticality</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody>
<% items.forEach((item)=>{ %><tr><td><strong><%= item.code %></strong></td><td><%= item.name %></td><td><%= item.ownerTeam || '-' %></td><td><span class='pill'><%= item.criticality || 'MEDIUM' %></span></td><td><%= item.description || '-' %></td><td><span class='pill <%= item.isActive ? 'brand-soft' : 'subtle' %>'><%= item.isActive ? 'ACTIVE' : 'INACTIVE' %></span></td><td><div class='inline-actions wrap-actions'><a href='<%= basePath %>/admin/modules/<%= item._id %>/edit'>Edit</a><form method='post' action='<%= basePath %>/admin/modules/<%= item._id %>/status' style='display:inline'><input type='hidden' name='_csrf' value='<%= csrfToken %>' /><input type='hidden' name='isActive' value='<%= item.isActive ? 'false' : 'true' %>' /><button type='submit' class='link-button <%= item.isActive ? 'danger-link-button' : '' %>'><%= item.isActive ? 'Deactivate' : 'Activate' %></button></form></div></td></tr><% }) %>
</tbody></table></div><% } %></section>