<section class="hero gradient-quirky dashboard-hero">
  <div>
    <div class="section-kicker">Workspace overview</div>
    <h1>Welcome <%= currentUser && currentUser.name ? currentUser.name : (tenant ? tenant.name : 'to Service Desk') %></h1>
    <% if (currentUser && currentUser.role !== 'superadmin') { %>
      <% const scopeNames = (scopedEntities || []).slice(0, 6).map((entity) => entity.path || entity.name); %>
      <p class="muted welcome-scope-line"><strong>Your clients:</strong> <%= scopeNames.length ? scopeNames.join(', ') : 'No active client/entity assigned yet' %><%= (scopedEntities || []).length > 6 ? ` +${(scopedEntities || []).length - 6} more` : '' %></p>
    <% } %>
    <p class="muted">Here is what needs your attention today across issues, Jira flow, and SLA health.</p>
  </div>
  <div class="hero-actions wrap-actions hero-actions-inline hero-quick-actions">
    <button type="button" class="button-link secondary quick-action today-watch-trigger" id="today-watch-hero-button" aria-haspopup="dialog">
      <span aria-hidden="true">🔔</span>
      <span>Today Watch</span>
      <strong class="today-watch-count" id="today-watch-count">0</strong>
    </button>
    <a class="button-link quick-action" href="<%= basePath %>/tickets/new">+ Issue</a>
    <% if (currentUser && ['superadmin', 'client', 'agent', 'agent_user', 'agent_manager'].includes(currentUser.role)) { %>
      <a class="button-link secondary quick-action" href="<%= basePath %>/entities/new<%= currentUser.role === 'client' ? '?type=subclient' : '' %>">+ Entity</a>
      <a class="button-link secondary quick-action" href="<%= basePath %>/users/new?role=client">+ Client User</a>
    <% } %>
  </div>
</section>

<section class="stats-grid dashboard-primary-stats">
  <a class="stat-card" href="<%= basePath %>/tickets"><h3>Issues</h3><p class="big-number"><%= stats.issuesCount %></p></a>
  <a class="stat-card" href="<%= basePath %>/tickets?status=NEW&status=OPEN&status=UNDER_REVIEW&status=IN_PROGRESS&status=WAITING_FOR_CLIENT&status=READY_TO_CLOSE"><h3>Open issues</h3><p class="big-number"><%= stats.openIssuesCount || 0 %></p><p class="muted small">Still active in the workspace</p></a>
  <a class="stat-card" href="<%= basePath %>/tickets?jiraLinked=YES"><h3>Jira linked</h3><p class="big-number"><%= stats.jiraLinkedIssuesCount || 0 %></p><p class="muted small">Already pushed and linked</p></a>
  <a class="stat-card" href="<%= basePath %>/tickets?sortBy=updatedAt&sortDir=desc"><h3>Updated today</h3><p class="big-number"><%= stats.updatedTodayCount || 0 %></p><p class="muted small">Fresh movement since midnight</p></a>
  <% if (currentUser.role === 'superadmin') { %>
    <a class="stat-card" href="<%= basePath %>/entities"><h3>Entities</h3><p class="big-number"><%= stats.entitiesCount %></p></a>
    <a class="stat-card" href="<%= basePath %>/users"><h3>Client Users</h3><p class="big-number"><%= stats.usersCount %></p></a>
    <a class="stat-card" href="<%= basePath %>/users?role=agent"><h3>Agents</h3><p class="big-number"><%= stats.agentsCount %></p></a>
    <a class="stat-card jira-queue-card" href="<%= basePath %>/tickets?jiraLinked=NO"><h3>Jira pending</h3><p class="big-number"><%= stats.jiraQueueCount || 0 %></p><p class="muted small">Queued or ready for push</p></a>
    <a class="stat-card" href="<%= basePath %>/tickets?slaStatus=AT_RISK"><h3>SLA at risk</h3><p class="big-number"><%= stats.slaAtRiskIssues || 0 %></p></a>
    <a class="stat-card" href="<%= basePath %>/tickets?slaStatus=BREACHED"><h3>SLA breached</h3><p class="big-number"><%= stats.slaBreachedIssues || 0 %></p></a>
  <% } else { %>
    <div class="stat-card"><h3>Your Scope</h3><p>Only tickets in authorized entities are shown.</p></div>
    <div class="stat-card"><h3>Workflow</h3><p>OPEN → IN_PROGRESS → WAITING_FOR_CLIENT → RESOLVED → CLOSED</p></div>
    <a class="stat-card jira-queue-card" href="<%= basePath %>/tickets?jiraLinked=NO"><h3>Jira pending</h3><p class="big-number"><%= stats.jiraQueueCount || 0 %></p><p class="muted small">Ready for push or waiting in queue</p></a>
    <a class="stat-card" href="<%= basePath %>/tickets?slaStatus=AT_RISK&slaStatus=BREACHED"><h3>SLA Watch</h3><p><%= stats.slaAtRiskIssues || 0 %> at risk · <%= stats.slaBreachedIssues || 0 %> breached</p></a>
  <% } %>
</section>

<div class="dashboard-section-divider" aria-hidden="true"></div>


<section class="dashboard-home-focus-grid">
  <article class="card stack section-card dashboard-ops-card dashboard-ops-redesign">
    <div class="page-header compact-header">
      <div>
        <h2>Immediate attention required</h2>
        <p class="muted">The most urgent operational items, sorted by SLA risk and action need.</p>
      </div>
      <button type="button" class="button-link secondary" id="today-watch-inline-button">🔔 Today watch</button>
    </div>
    <div class="attention-scroll-list">
      <% if (!(attentionItems || []).length) { %>
        <p class="muted">No immediate action items right now.</p>
      <% } else { %>
        <% (attentionItems || []).forEach((item) => { %>
          <a class="attention-item attention-<%= item.level %>" href="<%= basePath %>/tickets/<%= item._id %>">
            <div class="attention-main">
              <strong><%= item.issueNumber %></strong>
              <span><%= item.title %></span>
            </div>
            <div class="attention-meta">
              <span class="pill"><%= item.reason %></span>
              <span class="badge status-<%= String(item.status || '').toLowerCase() %>"><%= item.status %></span>
              <span class="muted small"><%= item.entity %></span>
              <span class="muted small">Owner: <%= item.assignee %></span>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
    <div class="hero-actions wrap-actions hero-actions-inline hero-quick-actions">
      <a class="button-link secondary quick-action" href="<%= basePath %>/tickets?slaStatus=AT_RISK&slaStatus=BREACHED">Open SLA watch</a>
      <a class="button-link secondary quick-action" href="<%= basePath %>/agent/workspace">Open agent workspace</a>
      <% if (currentUser && currentUser.role === 'superadmin') { %>
        <a class="button-link secondary quick-action" href="<%= basePath %>/admin/integrations/jira">Review Jira config</a>
      <% } %>
    </div>
  </article>

  <article class="card section-card v382-calendar-card">
    <div class="v382-calendar-header">
      <div>
        <h2>Resolution calendar</h2>
        <p class="muted small">Daily counts across SLA, closure and resolution signals.</p>
      </div>
      <div class="v382-calendar-controls">
        <button type="button" class="secondary tiny" id="calendar-prev">‹</button>
        <strong id="calendar-title">Calendar</strong>
        <button type="button" class="secondary tiny" id="calendar-next">›</button>
      </div>
    </div>
    <div class="v382-calendar-weekdays" aria-hidden="true">
      <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
    </div>
    <div class="v382-month-grid" id="resolution-month-grid"></div>
    <div class="v382-calendar-legend">
      <span><i class="dot due"></i> Due</span>
      <span><i class="dot closed"></i> Closed</span>
      <span><i class="dot within"></i> Within SLA</span>
      <span><i class="dot breached"></i> Breached</span>
    </div>
  </article>
</section>

<div class="v382-modal-backdrop" id="calendar-day-modal" hidden>
  <div class="v382-modal-card" role="dialog" aria-modal="true" aria-labelledby="calendar-day-title">
    <div class="page-header compact-header">
      <div><h2 id="calendar-day-title">Issues</h2><p class="muted small" id="calendar-day-summary"></p></div>
      <button type="button" class="secondary tiny" data-close-calendar-modal>Close</button>
    </div>
    <div class="stack" id="calendar-day-list"></div>
  </div>
</div>

<div class="v382-modal-backdrop" id="today-watch-modal" hidden>
  <div class="v382-modal-card" role="dialog" aria-modal="true" aria-labelledby="today-watch-title">
    <div class="page-header compact-header">
      <div><h2 id="today-watch-title">Today & tomorrow watch</h2><p class="muted small">Items that may need quick attention.</p></div>
      <button type="button" class="secondary tiny" data-close-watch-modal>Close</button>
    </div>
    <div class="stack" id="today-watch-list"></div>
  </div>
</div>

<section class="card section-card">
  <div class="page-header">
    <div><h2>Recent issues</h2><p class="muted">Showing the latest 15 issues in this workspace.</p></div>
    <a class="button-link secondary" href="<%= basePath %>/tickets">View all</a>
  </div>
  <% const jiraValidationPassed = jiraConnection && jiraConnection.lastValidationStatus === 'SUCCESS'; %>
  <% const intakeProjectKey = jiraConnection && jiraConnection.intake && jiraConnection.intake.projectKey ? jiraConnection.intake.projectKey : 'PTP'; %>
  <% const intakeIssueTypeName = jiraConnection && jiraConnection.intake && jiraConnection.intake.issueTypeName ? jiraConnection.intake.issueTypeName : 'Bug'; %>
  <% if (!recentIssues.length) { %><p class="muted">No issues yet.</p><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>Issue</th><th>Title</th><th>Entity</th><th>Created on</th><th>Status</th><th>Jira Status</th><th>Severity</th><th>SLA</th><th>Action</th></tr></thead><tbody>
  <% recentIssues.forEach((issue) => { %>
    <% const jiraStatusLabel = issue.jira && issue.jira.issueKey ? (issue.jira.currentStatusName || issue.jira.pushStatus || issue.executionState || 'PUSHED') : 'Not pushed'; %>
    <tr>
      <td><a href="<%= basePath %>/tickets/<%= issue._id %>"><strong><%= issue.issueNumber %></strong></a></td>
      <td><a href="<%= basePath %>/tickets/<%= issue._id %>"><%= issue.title %></a></td>
      <td><%= issue.entityId ? issue.entityId.name : '-' %></td>
      <td><%= issue.createdAt ? new Date(issue.createdAt).toLocaleDateString() : '-' %></td>
      <td><span class="badge status-<%= issue.status.toLowerCase() %>"><%= issue.status %></span></td>
      <td>
        <% if (issue.jira && issue.jira.issueKey) { %>
          <span class="pill brand-soft"><%= jiraStatusLabel %></span>
          <div class="muted small"><%= issue.jira.issueKey %></div>
        <% } else { %>
          <span class="pill subtle">Not pushed</span>
        <% } %>
      </td>
      <td><%= issue.priority %></td>
      <td><% if (issue.sla && issue.sla.hasPolicy) { %><span class="pill <%= issue.sla.resolutionStatus === 'BREACHED' ? 'danger-soft' : (issue.sla.resolutionStatus === 'AT_RISK' ? 'warning-soft' : 'brand-soft') %>"><%= issue.sla.resolutionStatus %></span><% } else { %><span class="pill subtle">NO_SLA</span><% } %></td>
      <td>
        <div class="dashboard-row-actions">
          <a href="<%= basePath %>/tickets/<%= issue._id %>">Open</a>
          <% if (!(issue.jira && issue.jira.issueKey) && currentUser && ['agent', 'superadmin'].includes(currentUser.role)) { %>
            <form method="post" action="<%= basePath %>/tickets/<%= issue.id || issue._id %>/push-to-jira" class="inline-form dashboard-jira-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="projectKey" value="<%= intakeProjectKey %>" />
              <input type="hidden" name="issueTypeName" value="<%= intakeIssueTypeName %>" />
              <button type="submit" class="button-link secondary mini-button" <%= jiraValidationPassed ? '' : 'disabled title="Validate Jira configuration before pushing."' %>>Push to Jira</button>
            </form>
          <% } %>
        </div>
      </td>
    </tr>
  <% }) %>
  </tbody></table></div>
  <% if (!jiraValidationPassed && currentUser && ['agent', 'superadmin'].includes(currentUser.role)) { %>
    <p class="muted small dashboard-help-note">Push to Jira stays disabled until Jira validation succeeds in the admin integration screen.</p>
  <% } %>
  <% } %>
</section>

<div class="dashboard-section-divider spacious" aria-hidden="true"></div>
<section class="dashboard-activity-fullrow">
  <article class="card stack section-card dashboard-ops-card">
    <div class="page-header compact-header">
      <div>
        <h2>Recent activity</h2>
        
      </div>
    </div>
    <div class="stack dashboard-activity-list">
      <% if (!recentIssues.length) { %>
        <p class="muted">No recent issue movement yet.</p>
      <% } else { %>
        <% recentIssues.slice(0, 4).forEach((issue) => { %>
          <div class="activity-row">
            <div class="activity-row-main">
              <strong><a href="<%= basePath %>/tickets/<%= issue._id %>"><%= issue.issueNumber %></a></strong>
              <span class="activity-title"><%= issue.title %></span>
            </div>
            <div class="activity-row-meta">
              <span class="badge status-<%= issue.status.toLowerCase() %>"><%= issue.status %></span>
              <% if (issue.jira && issue.jira.issueKey) { %>
                <span class="pill brand-soft"><%= issue.jira.issueKey %></span>
              <% } else { %>
                <span class="pill subtle">Service Desk only</span>
              <% } %>
              <span class="muted small"><%= issue.updatedAt ? new Date(issue.updatedAt).toLocaleString() : '-' %></span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </article>
</section>


<script>
(function () {
  const basePath = <%- JSON.stringify(basePath) %>;
  const calendarItems = <%- JSON.stringify(resolutionCalendar || []) %>;
  const attentionItems = <%- JSON.stringify(attentionItems || []) %>;
  const grid = document.getElementById('resolution-month-grid');
  const title = document.getElementById('calendar-title');
  const modal = document.getElementById('calendar-day-modal');
  const modalTitle = document.getElementById('calendar-day-title');
  const modalSummary = document.getElementById('calendar-day-summary');
  const modalList = document.getElementById('calendar-day-list');
  const watchModal = document.getElementById('today-watch-modal');
  const watchList = document.getElementById('today-watch-list');
  const today = new Date();
  let visibleMonth = new Date(today.getFullYear(), today.getMonth(), 1);

  function iso(date) { return date.toISOString().slice(0, 10); }
  function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char])); }
  function bucket(items) {
    return items.reduce((acc, item) => {
      const key = item.date;
      if (!acc[key]) acc[key] = [];
      acc[key].push(item);
      return acc;
    }, {});
  }
  function counts(items) {
    return {
      due: items.length,
      closed: items.filter((i) => i.isClosed).length,
      within: items.filter((i) => i.isWithinSla).length,
      breached: items.filter((i) => i.isBreached).length
    };
  }
  function itemRow(item) {
    return '<a class="v382-calendar-issue-row" href="' + basePath + '/tickets/' + encodeURIComponent(item._id) + '">' +
      '<strong>' + escapeHtml(item.issueNumber) + '</strong><span>' + escapeHtml(item.title) + '</span>' +
      '<em>' + escapeHtml(item.workflowStatus || item.status || '') + '</em></a>';
  }
  function openDay(dateKey, items) {
    const c = counts(items);
    modalTitle.textContent = new Date(dateKey + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
    modalSummary.textContent = c.due + ' due · ' + c.closed + ' closed · ' + c.within + ' within SLA · ' + c.breached + ' breached';
    modalList.innerHTML = items.length ? items.map(itemRow).join('') : '<p class="muted">No issues on this date.</p>';
    modal.hidden = false;
  }
  function render() {
    if (!grid) return;
    const byDate = bucket(calendarItems);
    const year = visibleMonth.getFullYear();
    const month = visibleMonth.getMonth();
    const first = new Date(year, month, 1);
    const start = new Date(year, month, 1 - first.getDay());
    const cells = [];
    if (title) title.textContent = visibleMonth.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
    for (let i = 0; i < 42; i += 1) {
      const d = new Date(start); d.setDate(start.getDate() + i);
      const key = iso(d);
      const items = byDate[key] || [];
      const c = counts(items);
      const other = d.getMonth() !== month;
      cells.push('<button type="button" class="v382-day-cell ' + (other ? 'other-month' : '') + ' ' + (key === iso(today) ? 'today' : '') + '" data-date="' + key + '">' +
        '<span class="day-num">' + d.getDate() + '</span>' +
        '<span class="day-counts">' +
          (c.due ? '<b class="due">' + c.due + '</b>' : '') +
          (c.closed ? '<b class="closed">' + c.closed + '</b>' : '') +
          (c.within ? '<b class="within">' + c.within + '</b>' : '') +
          (c.breached ? '<b class="breached">' + c.breached + '</b>' : '') +
        '</span></button>');
    }
    grid.innerHTML = cells.join('');
    Array.from(grid.querySelectorAll('[data-date]')).forEach((btn) => {
      btn.addEventListener('click', () => openDay(btn.dataset.date, byDate[btn.dataset.date] || []));
    });
  }
  document.getElementById('calendar-prev')?.addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1); render(); });
  document.getElementById('calendar-next')?.addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1); render(); });
  document.querySelector('[data-close-calendar-modal]')?.addEventListener('click', () => { modal.hidden = true; });
  modal?.addEventListener('click', (event) => { if (event.target === modal) modal.hidden = true; });
  const todayKeyForWatch = iso(today);
  const tomorrowForWatch = new Date(today); tomorrowForWatch.setDate(today.getDate() + 1);
  const tomorrowKeyForWatch = iso(tomorrowForWatch);
  function getWatchItems() {
    return calendarItems.filter((item) => item.date === todayKeyForWatch || item.date === tomorrowKeyForWatch || item.isBreached || item.isAtRisk).slice(0, 15);
  }
  function openTodayWatch() {
    const watchItems = getWatchItems();
    if (!watchList || !watchModal) return;
    watchList.innerHTML = watchItems.length ? watchItems.map(itemRow).join('') : '<p class="muted">Nothing urgent for today or tomorrow.</p>';
    watchModal.hidden = false;
  }
  const watchCount = document.getElementById('today-watch-count');
  const computedWatchCount = getWatchItems().length;
  if (watchCount) {
    watchCount.textContent = String(computedWatchCount);
    watchCount.hidden = computedWatchCount === 0;
    document.getElementById('today-watch-hero-button')?.classList.toggle('has-watch-items', computedWatchCount > 0);
  }
  document.getElementById('today-watch-hero-button')?.addEventListener('click', openTodayWatch);
  document.getElementById('today-watch-inline-button')?.addEventListener('click', openTodayWatch);
  document.querySelector('[data-close-watch-modal]')?.addEventListener('click', () => { watchModal.hidden = true; });
  watchModal?.addEventListener('click', (event) => { if (event.target === watchModal) watchModal.hidden = true; });
  render();
})();
</script>
