<section class="hero">
  <div>
    <div class="section-kicker">Service commitment engine</div>
    <h1>New Service Commitment Policy</h1>
    <p>Create SLA / OLA policies with a guided template first, then fine-tune only if needed.</p>
  </div>
</section>
<section class="card stack">
  <form method="post" action="<%= basePath %>/admin/sla-policies" class="stack" id="simpleSlaPolicyForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <section class="card stack" style="margin:0;">
      <div class="page-header">
        <div>
          <h2>Quick start</h2>
          <p class="muted">Use a support model template inspired by the SunTec support model and SLA matrix, then adjust only the parts you need.</p>
        </div>
      </div>
      <div class="grid-two">
        <label><span>Policy name</span><input type="text" name="name" required placeholder="e.g. AXIS Custom SLA" /></label>
        <label><span>Support package</span><input type="text" name="supportPackage" value="<%= defaults.supportPackage || 'Standard' %>" placeholder="Custom, Gold, Platinum" /></label>
        <label><span>Policy type</span><select name="agreementType" id="agreementTypeSelect"><% agreementTypes.forEach((item) => { %><option value="<%= item %>" <%= defaults.agreementType === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
        <label><span>Quick template</span><select id="simpleTemplateSelect" name="simpleTemplate"><option value="">Custom</option><% Object.entries(simpleSupportPresets || {}).forEach(([key, preset]) => { %><option value="<%= key %>" <%= defaults.simpleTemplate === key ? 'selected' : '' %> data-agreement-type="<%= preset.agreementType %>"><%= preset.label %></option><% }) %></select></label>
        <label><span>Entity scope</span><select name="entityId"><option value="">Global tenant default</option><% entities.forEach((entity) => { %><option value="<%= entity._id %>"><%= entity.path || entity.name %></option><% }) %></select></label>
        <label><span>Scope level</span><select name="scopeLevel"><% scopeLevels.forEach((item) => { %><option value="<%= item %>" <%= defaults.scopeLevel === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
        <label><span>Inheritance mode</span><select name="scopeBehavior"><% scopeBehaviors.forEach((item) => { %><option value="<%= item %>" <%= defaults.scopeBehavior === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
        <label><span>Category</span><input type="text" name="category" value="<%= defaults.category %>" /></label>
        <label><span>Execution mode</span><select name="executionMode"><% executionOptions.forEach((item) => { %><option value="<%= item %>" <%= defaults.executionMode === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
        <label><span>Priority filter</span><select name="priority"><% priorityOptions.forEach((item) => { %><option value="<%= item %>" <%= defaults.priority === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
        <label><span>Warning threshold (%)</span><input type="number" name="warningThresholdPercent" min="1" max="99" value="<%= defaults.warningThresholdPercent %>" required /></label>
        <label><span>Business hours mode</span><select name="businessHoursMode" id="businessHoursModeSelect"><option value="TWENTY_FOUR_SEVEN" <%= defaults.businessHoursMode === 'TWENTY_FOUR_SEVEN' ? 'selected' : '' %>>24 x 7</option><option value="BUSINESS_HOURS" <%= defaults.businessHoursMode === 'BUSINESS_HOURS' ? 'selected' : '' %>>Business hours</option></select></label>
        <label><span>Business hours start</span><input type="time" name="businessHoursStart" value="<%= defaults.businessHoursStart %>" /></label>
        <label><span>Business hours end</span><input type="time" name="businessHoursEnd" value="<%= defaults.businessHoursEnd %>" /></label>
        <label><span>Rank</span><input type="number" name="rank" min="1" value="<%= defaults.rank %>" required /></label>
        <label class="checkbox-row"><input type="checkbox" name="isActive" value="true" checked /><span>Policy is active</span></label>
        <label class="checkbox-row"><input type="checkbox" name="inheritsFromParent" value="true" checked /><span>Allow parent inheritance</span></label>
      </div>
      <label><span>Description</span><textarea name="description" placeholder="Who this policy is for and why it exists..."></textarea></label>
      <label><span>Status update expectation</span><textarea name="escalationNote" id="simpleStatusUpdateNote" placeholder="Daily, every 4 hours, twice a day, etc."><%= defaults.simpleStatusUpdate || '' %></textarea></label>
      <label><span>Escalation recipients</span><input type="text" name="escalationRecipients" placeholder="ops@suntec.com, delivery@suntec.com" /></label>
    </section>

    <section class="card stack" style="margin:0;">
      <div class="page-header">
        <div>
          <h2>Simple severity matrix</h2>
          <p class="muted">Set only the core commitments first. Additional metrics remain available under advanced options.</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Severity</th><th>Display name</th><th>Response time</th><th>Unit</th><th>Incident / workaround</th><th>Unit</th><th>Problem / permanent fix</th><th>Unit</th><th>Per-severity note</th></tr>
          </thead>
          <tbody>
            <% (severityLevels || []).forEach((severityOption) => { const severity = severityOption.value; const row = buildSeverityDefaults(defaults, severity); %>
              <tr data-severity-row="<%= severity %>">
                <td><strong><%= severityOption.label || severity %></strong></td>
                <td><input type="text" name="<%= severity %>_displayName" value="<%= row.displayName %>" placeholder="<%= severityOption.label || severity %>" /></td>
                <td>
                  <input type="number" min="0" step="0.5" data-metric-primary-value value="<%= row.ACKNOWLEDGEMENT?.value ?? row.FIRST_RESPONSE?.value ?? '' %>" />
                  <input type="hidden" name="<%= severity %>_FIRST_RESPONSE_value" value="<%= row.FIRST_RESPONSE?.value ?? '' %>" data-sync-first-response-value />
                  <input type="hidden" name="<%= severity %>_ACKNOWLEDGEMENT_value" value="<%= row.ACKNOWLEDGEMENT?.value ?? '' %>" data-sync-ack-value />
                </td>
                <td>
                  <select data-metric-primary-unit>
                    <% timeUnits.forEach((unit) => { const sel = row.ACKNOWLEDGEMENT?.unit || row.FIRST_RESPONSE?.unit || 'HOURS'; %>
                      <option value="<%= unit %>" <%= sel === unit ? 'selected' : '' %>><%= unit %></option>
                    <% }) %>
                  </select>
                  <input type="hidden" name="<%= severity %>_FIRST_RESPONSE_unit" value="<%= row.FIRST_RESPONSE?.unit ?? '' %>" data-sync-first-response-unit />
                  <input type="hidden" name="<%= severity %>_ACKNOWLEDGEMENT_unit" value="<%= row.ACKNOWLEDGEMENT?.unit ?? '' %>" data-sync-ack-unit />
                </td>
                <td><input type="number" min="0" step="0.5" name="<%= severity %>_WORKAROUND_value" value="<%= row.WORKAROUND?.value ?? row.RESOLUTION?.value ?? '' %>" /></td>
                <td><select name="<%= severity %>_WORKAROUND_unit"><% timeUnits.forEach((unit) => { %><option value="<%= unit %>" <%= (row.WORKAROUND?.unit || row.RESOLUTION?.unit || 'HOURS') === unit ? 'selected' : '' %>><%= unit %></option><% }) %></select></td>
                <td><input type="number" min="0" step="0.5" name="<%= severity %>_PERMANENT_FIX_value" value="<%= row.PERMANENT_FIX?.value ?? '' %>" /></td>
                <td><select name="<%= severity %>_PERMANENT_FIX_unit"><% timeUnits.forEach((unit) => { %><option value="<%= unit %>" <%= (row.PERMANENT_FIX?.unit || 'DAYS') === unit ? 'selected' : '' %>><%= unit %></option><% }) %></select><input type="hidden" name="<%= severity %>_RESOLUTION_value" value="<%= row.WORKAROUND?.value ?? row.RESOLUTION?.value ?? '' %>" /><input type="hidden" name="<%= severity %>_RESOLUTION_unit" value="<%= row.WORKAROUND?.unit ?? row.RESOLUTION?.unit ?? 'HOURS' %>" /></td>
                <td><input type="text" name="<%= severity %>_escalationNote" value="<%= row.statusUpdate || row.escalationNote || '' %>" placeholder="Optional guidance" /></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <details class="card stack" style="margin:0;">
      <summary><strong>Advanced options</strong> <span class="muted">Open only if you need more than simple response and resolution targets.</span></summary>
      <div class="stack">
        <% (severityLevels || []).forEach((severityOption) => { const severity = severityOption.value; %>
          <section class="card stack" style="margin: 0;">
            <div class="page-header"><div><h3><%= severityOption.label || severity %></h3><p class="muted">Optional advanced metrics like workaround, update frequency, or closure confirmation.</p></div></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Metric</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                  <% metricTypes.filter((metricType) => !['FIRST_RESPONSE','ACKNOWLEDGEMENT','RESOLUTION','WORKAROUND','PERMANENT_FIX'].includes(metricType)).forEach((metricType) => { %>
                    <tr>
                      <td><%= metricType.replace(/_/g, ' ') %></td>
                      <td><input type="number" min="0" step="0.5" name="<%= severity %>_<%= metricType %>_value" /></td>
                      <td><select name="<%= severity %>_<%= metricType %>_unit"><% timeUnits.forEach((unit) => { %><option value="<%= unit %>"><%= unit %></option><% }) %></select></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <label><span><%= severityOption.label || severity %> escalation recipients</span><input type="text" name="<%= severity %>_escalationRecipients" placeholder="lead@suntec.com, manager@suntec.com" /></label>
          </section>
        <% }) %>
      </div>
    </details>

    <div class="form-actions right"><button type="submit">Create Policy</button></div>
  </form>
</section>

<script>
  (function () {
    const presets = <%- JSON.stringify(simpleSupportPresets || {}) %>;
    window.__severityOptions = <%- JSON.stringify(severityLevels || []) %>;
    const form = document.getElementById('simpleSlaPolicyForm');
    if (!form) return;
    const templateSelect = document.getElementById('simpleTemplateSelect');
    const agreementTypeSelect = document.getElementById('agreementTypeSelect');
    const businessHoursModeSelect = document.getElementById('businessHoursModeSelect');
    const statusUpdate = document.getElementById('simpleStatusUpdateNote');

    function setField(name, value) {
      const el = form.querySelector(`[name="${name}"]`);
      if (!el) return;
      el.value = value == null ? '' : value;
    }

    function applyTemplate(key) {
      const preset = presets[key];
      if (!preset) return;
      if (agreementTypeSelect) agreementTypeSelect.value = preset.agreementType || 'SLA';
      if (businessHoursModeSelect && preset.businessHoursMode) businessHoursModeSelect.value = preset.businessHoursMode;
      setField('warningThresholdPercent', preset.warningThresholdPercent || 80);
      if (statusUpdate) statusUpdate.value = preset.defaultStatusUpdate || '';
      const templateRows = Object.values((preset && preset.severities) || {});
      (window.__severityOptions || []).forEach((severityEntry, index) => { const severity = severityEntry.value;
        const row = (preset.severities && (preset.severities[severity] || preset.severities[severityEntry.label])) || templateRows[index] || templateRows[templateRows.length - 1] || {};
        setField(`${severity}_displayName`, severityEntry.label || severity);
        const primary = preset.agreementType === 'OLA' ? (row.acknowledgement || row.firstResponse || null) : (row.firstResponse || row.acknowledgement || null);
        setField(`${severity}_FIRST_RESPONSE_value`, row.firstResponse ? row.firstResponse.value : (preset.agreementType === 'SLA' ? (primary && primary.value) : ''));
        setField(`${severity}_FIRST_RESPONSE_unit`, row.firstResponse ? row.firstResponse.unit : (preset.agreementType === 'SLA' ? (primary && primary.unit) : 'HOURS'));
        setField(`${severity}_ACKNOWLEDGEMENT_value`, row.acknowledgement ? row.acknowledgement.value : (preset.agreementType === 'OLA' ? (primary && primary.value) : ''));
        setField(`${severity}_ACKNOWLEDGEMENT_unit`, row.acknowledgement ? row.acknowledgement.unit : (preset.agreementType === 'OLA' ? (primary && primary.unit) : 'HOURS'));
        setField(`${severity}_WORKAROUND_value`, row.workaround ? row.workaround.value : (row.resolution ? row.resolution.value : ''));
        setField(`${severity}_WORKAROUND_unit`, row.workaround ? row.workaround.unit : (row.resolution ? row.resolution.unit : 'HOURS'));
        setField(`${severity}_RESOLUTION_value`, row.workaround ? row.workaround.value : (row.resolution ? row.resolution.value : ''));
        setField(`${severity}_RESOLUTION_unit`, row.workaround ? row.workaround.unit : (row.resolution ? row.resolution.unit : 'HOURS'));
        setField(`${severity}_PERMANENT_FIX_value`, row.permanentFix ? row.permanentFix.value : '');
        setField(`${severity}_PERMANENT_FIX_unit`, row.permanentFix ? row.permanentFix.unit : 'DAYS');
        const primaryValue = form.querySelector(`[data-severity-row="${severity}"] [data-metric-primary-value]`);
        const primaryUnit = form.querySelector(`[data-severity-row="${severity}"] [data-metric-primary-unit]`);
        if (primaryValue) primaryValue.value = primary && primary.value != null ? primary.value : '';
        if (primaryUnit) primaryUnit.value = primary && primary.unit ? primary.unit : 'HOURS';
      });
    }

    function syncPrimaryMetrics() {
      const type = agreementTypeSelect ? agreementTypeSelect.value : 'SLA';
      form.querySelectorAll('[data-severity-row]').forEach((row) => {
        const severity = row.getAttribute('data-severity-row');
        const primaryValue = row.querySelector('[data-metric-primary-value]');
        const primaryUnit = row.querySelector('[data-metric-primary-unit]');
        const firstValue = row.querySelector('[data-sync-first-response-value]');
        const firstUnit = row.querySelector('[data-sync-first-response-unit]');
        const ackValue = row.querySelector('[data-sync-ack-value]');
        const ackUnit = row.querySelector('[data-sync-ack-unit]');
        if (type === 'OLA') {
          if (ackValue) ackValue.value = primaryValue ? primaryValue.value : '';
          if (ackUnit) ackUnit.value = primaryUnit ? primaryUnit.value : 'HOURS';
          if (firstValue) firstValue.value = '';
        } else {
          if (firstValue) firstValue.value = primaryValue ? primaryValue.value : '';
          if (firstUnit) firstUnit.value = primaryUnit ? primaryUnit.value : 'HOURS';
          if (ackValue) ackValue.value = '';
        }
      });
    }

    if (templateSelect) {
      templateSelect.addEventListener('change', function () {
        if (this.value) applyTemplate(this.value);
        syncPrimaryMetrics();
      });
      if (templateSelect.value) applyTemplate(templateSelect.value);
    }
    if (agreementTypeSelect) agreementTypeSelect.addEventListener('change', syncPrimaryMetrics);
    form.addEventListener('input', function (event) {
      if (event.target.matches('[data-metric-primary-value], [data-metric-primary-unit]')) syncPrimaryMetrics();
    });
    syncPrimaryMetrics();
  })();
</script>
