
<section class="page-header">
  <div>
    <div class="section-kicker">Live operations</div>
    <h1>Ops Console</h1>
    <p class="muted">Use Ops Console to watch what is happening in the system right now: queue activity, failed notifications, recent audit movement, and issues that were touched recently. Use Admin Console for settings, master data, and governance.</p>
  </div>
</section>
<section class="grid-two">
  <div class="card stack section-card"><h2>Metrics</h2><pre class="code-block"><%= JSON.stringify(metrics, null, 2) %></pre></div>
  <div class="card stack section-card"><h2>Queue / DLQ</h2><div class="stack"><% jobs.forEach((job) => { %><div class="summary-detail-item"><span class="summary-label"><%= job.type %> · <%= job.status %></span><strong><%= job.attempts %>/<%= job.maxAttempts %></strong></div><% }) %></div></div>
  <div class="card stack section-card"><h2>Failed / queued notifications</h2><div class="stack"><% failedNotifications.forEach((item) => { %><div class="summary-detail-item"><span class="summary-label"><%= item.type %> · <%= item.status %></span><strong><%= item.recipientEmail || '-' %></strong></div><% }) %></div></div>
  <div class="card stack section-card"><h2>Recent audit</h2><div class="stack"><% recentAudits.forEach((entry) => { %><div class="summary-detail-item"><span class="summary-label"><%= entry.action %></span><strong><%= entry.entityType %></strong></div><% }) %></div></div>
</section>
<section class="card stack section-card ops-recent-issues-card">
  <div class="page-header compact-header" style="margin-bottom:0">
    <div>
      <h2>Recently touched issues</h2>
      <p class="muted">The latest issues that moved, changed, or were touched by the internal team.</p>
    </div>
  </div>
  <% if (!recentIssues || !recentIssues.length) { %><p class="muted">No issues yet.</p><% } else { %>
    <div class="table-wrap"><table><thead><tr><th>Issue</th><th>Title</th><th>Entity</th><th>Status</th><th>Updated</th></tr></thead><tbody>
      <% recentIssues.forEach((item) => { %><tr><td><a href="<%= basePath %>/tickets/<%= item._id %>"><%= item.issueNumber %></a></td><td><%= item.title %></td><td><%= item.entityId?.path || item.entityId?.name || '—' %></td><td><span class="pill"><%= item.status %></span></td><td><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString() : '—' %></td></tr><% }) %>
    </tbody></table></div>
  <% } %>
</section>
