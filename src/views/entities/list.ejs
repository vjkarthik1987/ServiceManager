<section class="page-header compact-header">
  <div>
    <h1>Entities</h1>
    <p class="muted">View the full client and subclient hierarchy across your accessible scope.</p>
  </div>
  <div class="header-actions wrap-actions">
    <% if (currentUser.role !== 'agent') { %>
      <a class="button-link" href="<%= basePath %>/entities/new">Create Entity</a>
    <% } %>
    <a class="button-link secondary" href="<%= basePath %>/entities/export<%= buildQueryString(filters) %>">Export</a>
  </div>
</section>

<form method="get" action="<%= basePath %>/entities" class="card filters-form stack better-filters-card">
  <div class="grid-auto-fit entity-filter-grid">
    <label><span>Search</span><input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Name, path, region, product" /></label>
    <label><span>Type</span><select name="type"><option value="">All types</option><option value="client" <%= filters.type === 'client' ? 'selected' : '' %>>Client</option><option value="subclient" <%= filters.type === 'subclient' ? 'selected' : '' %>>Subclient</option></select></label>
  </div>
  <div class="form-actions right wrap-actions"><a class="button-link secondary" href="<%= basePath %>/entities">Reset</a><button type="submit">Apply</button></div>
</form>

<section class="entity-tree">
  <% if (!entityTreeRoots || !entityTreeRoots.length) { %>
    <div class="entity-empty-row muted">No entities matched these filters.</div>
  <% } else { %>
    <% entityTreeRoots.forEach((entity) => { %>
      <%- include('../partials/entity-tree-node', { entity, level: 0, basePath, currentUser, csrfToken }) %>
    <% }) %>
    <%- include('../partials/pagination', { pager, baseUrl: `${basePath}/entities`, filters, buildQueryString }) %>
  <% } %>
</section>
