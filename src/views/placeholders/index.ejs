
<section class="page-header">
  <div>
    <% if (typeof pageKicker !== 'undefined' && pageKicker) { %><div class="section-kicker"><%= pageKicker %></div><% } %>
    <h1><%= pageTitle %></h1>
    <p class="muted"><%= pageDescription %></p>
  </div>
</section>

<section class="card stack narrow form-card placeholder-page-card">
  <div class="callout">
    <strong>Reserved page</strong>
    <p class="muted small">The navigation entry is now present so the product structure is ready, but the detailed features can be built later.</p>
  </div>
  <div class="form-actions right">
    <a class="button-link secondary" href="<%= ctaHref %>"><%= ctaLabel %></a>
  </div>
</section>
