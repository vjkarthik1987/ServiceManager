<section class="page-header compact-header">
  <div>
    <h1>Bulk Upload Issues</h1>
    <p class="muted">Use entity acronym or entity name. Do not use Mongo entity ids.</p>
  </div>
  <div class="header-actions wrap-actions">
    <a class="button-link secondary" href="<%= basePath %>/tickets/bulk-upload/template">Download Template</a>
    <a class="button-link secondary" href="<%= basePath %>/tickets">Back to Issues</a>
  </div>
</section>

<% if (result) { %>
  <section class="card stack form-card" style="margin-bottom: 18px;">
    <h2>Upload Result</h2>
    <p><strong><%= result.createdCount %></strong> issue(s) created.</p>
    <% if (result.rowErrors && result.rowErrors.length) { %>
      <div class="alert error"><%= result.rowErrors.join(' | ') %></div>
    <% } %>
    <% if (result.createdIssues && result.createdIssues.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Issue</th><th>Entity</th></tr></thead>
          <tbody>
            <% result.createdIssues.forEach((item) => { %>
              <tr><td><%= item.issueNumber %></td><td><%= item.entity %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% } %>

<section class="card form-card stack" style="margin-bottom: 18px;">
  <h2>Upload CSV</h2>
  <form method="post" action="<%= basePath %>/tickets/bulk-upload" enctype="multipart/form-data" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      <span>CSV file</span>
      <input type="file" name="bulkFile" accept=".csv" required>
    </label>
    <div class="form-actions right wrap-actions">
      <button type="submit">Upload Issues</button>
    </div>
  </form>
</section>

<section class="card form-card stack" style="margin-bottom: 18px;">
  <h2>Expected Columns</h2>
  <div class="grid-auto-fit">
    <div><strong>entityAcronym</strong><div class="muted small">Preferred. Example: C001</div></div>
    <div><strong>entityName</strong><div class="muted small">Optional fallback. Use only when unique.</div></div>
    <div><strong>title</strong><div class="muted small">Required</div></div>
    <div><strong>requestType</strong><div class="muted small"><%= requestTypes.join(', ') %></div></div>
    <div><strong>description</strong><div class="muted small">Required</div></div>
    <div><strong>priority</strong><div class="muted small"><%= priorities.join(', ') %></div></div>
    <div><strong>category</strong><div class="muted small"><%= categoryOptions.join(', ') %></div></div>
    <div><strong>source</strong><div class="muted small"><%= sourceOptions.join(', ') %></div></div>
  </div>
</section>

<section class="card form-card stack">
  <h2>Entity Reference</h2>
  <p class="muted">Use the acronym column in your CSV. That is the business-facing value meant for upload.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Acronym</th><th>Name</th><th>Path</th><th>Type</th></tr></thead>
      <tbody>
        <% entities.forEach((entity) => { %>
          <tr>
            <td><strong><%= entity.acronym %></strong></td>
            <td><%= entity.name %></td>
            <td><%= entity.path %></td>
            <td><%= entity.type %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
