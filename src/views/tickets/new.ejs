<% const uploadLimitSummary = uploadLimits.sizeSummary.slice(0, 6).map((item) => `${item.extension} ${item.maxSizeMb}MB`).join(' · '); %>
<% const taxonomy = requestTaxonomy || []; %>
<% const entityTaxonomyById = entityTaxonomyMap || {}; %>
<% const enabledTaxonomy = taxonomy.filter((item) => requestTypes.includes(item.key)); %>
<% const firstType = (defaults.requestType && requestTypes.includes(defaults.requestType)) ? defaults.requestType : ((enabledTaxonomy[0] || {}).key || 'BUG'); %>
<section class="page-header v38-intake-header">
  <div>
    <span class="section-kicker">Premium intake</span>
    <h1><%= portalMode === 'client' ? 'Raise a Request' : 'Create Request' %></h1>
    <p class="muted"><%= portalMode === 'client' ? 'Start with what you need. The form will adapt so you only answer what matters.' : 'Create a scoped request with the right operational context from the beginning.' %></p>
  </div>
</section>
<% if (!entities.length) { %>
  <div class="alert error">No authorized entity is available for this user. Please contact your administrator.</div>
<% } %>

<form method="post" action="<%= createAction %>" enctype="multipart/form-data" class="card stack form-card v38-intake-shell" id="v38-intake-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="requestType" id="requestType" value="<%= firstType %>" />

  <div class="v38-stepper" aria-label="Request creation steps">
    <span class="active" data-step-pill="1">1. Choose</span>
    <span data-step-pill="2">2. Details</span>
    <span data-step-pill="3">3. Review</span>
  </div>

  <section class="v38-intake-step active" data-intake-step="1">
    <div class="v38-intake-hero">
      <div>
        <h2>What would you like to raise?</h2>
        <p class="muted">Pick the closest match. This choice controls the questions, labels and routing context.</p>
      </div>
    </div>
    <div class="request-type-card-grid v38-request-type-grid" data-request-type-cards>
      <% enabledTaxonomy.forEach((item) => { %>
        <button type="button" class="request-type-card v38-request-type-card <%= firstType === item.key ? 'active' : '' %>" data-request-type-card="<%= item.key %>">
          <span class="v38-type-icon"><%= item.key === 'BUG' ? '!' : item.key === 'CR' ? '↗' : item.key === 'QUERY' ? '?' : '✓' %></span>
          <strong><%= item.label %></strong>
          <span class="muted small"><%= item.key === 'BUG' ? 'Something is broken, blocked, wrong, slow or not behaving as expected.' : item.key === 'CR' ? 'A change, enhancement, workflow update, report change or business capability.' : item.key === 'QUERY' ? 'A clarification, how-to question, explanation, or support guidance request.' : 'An operational service such as access, environment refresh, report extract or deployment help.' %></span>
          <em><%= item.key === 'BUG' ? 'Best for production or functional problems' : item.key === 'CR' ? 'Best for changes and improvements' : item.key === 'QUERY' ? 'Best for questions and clarifications' : 'Best for planned service assistance' %></em>
        </button>
      <% }) %>
    </div>
    <div class="form-actions right"><button type="button" class="primary" data-next-step>Next</button></div>
  </section>

  <section class="v38-intake-step" data-intake-step="2" hidden>
    <div class="v38-intake-hero compact">
      <div>
        <span class="section-kicker" id="selected-type-kicker">Request details</span>
        <h2 id="selected-type-heading">Tell us a little more</h2>
        <p class="muted" id="selected-type-subtitle">Only the relevant questions are shown.</p>
      </div>
      <button type="button" class="secondary" data-prev-step>Change request type</button>
    </div>

    <div class="v38-intake-layout">
      <div class="v38-intake-main stack">
        <label>
          <span>Entity</span>
          <select name="entityId" id="entityId" required data-jira-fields-url="<%= apiBasePath %>/entities/__ENTITY_ID__/jira-required-fields">
            <option value="">Select entity</option>
            <% entities.forEach((entity) => { %>
              <option value="<%= entity._id %>" <%= defaults.entityId && String(defaults.entityId) === String(entity._id) ? 'selected' : '' %>><%= entity.path %></option>
            <% }) %>
          </select>
          <% if (entities.length === 1) { %><span class="muted small">Only one authorized entity is available, so it has been preselected.</span><% } %>
        </label>

        <label>
          <span>Title</span>
          <input type="text" name="title" required maxlength="200" placeholder="A crisp one-line summary" />
        </label>

        <label class="v381-description-field">
          <span>Description</span>
          <div class="v381-description-toolbar">
            <button type="button" class="secondary tiny" id="voice-description-button">🎙 Voice input</button>
            <span class="muted small" id="voice-description-status">Optional. Works in supported browsers.</span>
          </div>
          <textarea name="description" id="issue-description" required placeholder="Describe the situation clearly. Add error text, expected outcome, examples or context where useful."></textarea>
        </label>

        <div class="v382-reassess-card card subtle-card stack" id="severity-reassess-card">
          <div class="section-title-row">
            <div>
              <strong id="severity-reassess-title">Need help choosing severity?</strong>
              <p class="muted small">Use the context you typed to suggest a sensible value. You stay in control.</p>
            </div>
            <button type="button" class="secondary" id="severity-reassess-button">Reassess</button>
          </div>
          <div id="severity-suggestion-result" class="v382-suggestion-result" hidden></div>
        </div>

        <% if (currentUser && ['agent', 'agent_user', 'agent_manager', 'support_head', 'superadmin'].includes(currentUser.role)) { %>
        <div class="v382-customer-visibility-card card subtle-card stack">
          <label>
            <span>Customer visibility</span>
            <select name="customerVisibility">
              <% customerVisibilities.forEach((visibility) => { %>
                <option value="<%= visibility %>" <%= defaults.customerVisibility === visibility ? 'selected' : '' %>><%= visibility %></option>
              <% }) %>
            </select>
          </label>
          <p class="muted small">Set <strong>INTERNAL_ONLY</strong> for requests that agents and superadmins should track without exposing them to client users.</p>
        </div>
        <% } else { %>
        <input type="hidden" name="customerVisibility" value="VISIBLE_TO_CUSTOMER" />
        <% } %>

        <div class="v382-attachment-card card subtle-card stack">
          <label>
            <span>Attachments</span>
            <input type="file" name="attachments" multiple accept="<%= uploadLimits.accept %>" data-file-preview-input="issue-create-files" />
            <span class="muted small">Up to <%= uploadLimits.maxFileCount %> files. <%= uploadLimitSummary %><%= uploadLimits.sizeSummary.length > 6 ? " · more via config" : "" %></span>
          </label>
          <div class="selected-files" data-file-preview-list="issue-create-files" hidden></div>
        </div>

        <div class="knowledge-solution-helper card subtle-card stack">
          <div class="section-title-row"><div><strong>Check knowledge before creating</strong><p class="muted small">Search existing solution guidance before creating the request.</p></div><div class="form-actions mini-actions"><button type="button" class="secondary" id="knowledge-solution-button">Find possible solution</button><button type="button" class="secondary" id="knowledge-copy-button" hidden>Copy solution</button></div></div>
          <div id="knowledge-solution-result" class="muted small" hidden></div>
        </div>
      </div>

      <aside class="v38-intake-side stack">
        <div class="grid-two">
          <label>
            <span id="priority-label">Severity</span>
            <select name="severity" id="severity-select" required>
              <option value="">Select</option>
              <% severities.forEach((priority) => { %>
                <option value="<%= priority %>" <%= (defaults.severity || defaults.priority) === priority ? 'selected' : '' %>><%= priority %></option>
              <% }) %>
            </select>
          </label>
          <label id="category-field">
            <span id="classification-label">Classification</span>
            <select name="category" id="request-category"></select>
            <span class="muted small" id="category-help">Choose the best classification if configured.</span>
          </label>
        </div>

        <label>
          <span>Tags</span>
          <input type="text" name="tags" placeholder="billing, login, urgency" />
        </label>

        <label>
          <span>Source</span>
          <select name="source" <%= currentUser && ['agent', 'agent_user', 'agent_manager', 'support_head', 'superadmin'].includes(currentUser.role) ? '' : 'disabled' %>>
            <% sourceOptions.forEach((item) => { %>
              <option value="<%= item %>" <%= defaults.source === item ? 'selected' : '' %>><%= item %></option>
            <% }) %>
          </select>
          <% if (!(currentUser && ['agent', 'agent_user', 'agent_manager', 'support_head', 'superadmin'].includes(currentUser.role))) { %><input type="hidden" name="source" value="portal" /><% } %>
        </label>

        <label class="v381-module-field">
          <span>Modules</span>
          <select name="modules" multiple size="5" <%= (modules || []).length === 1 ? 'data-single-module="true"' : '' %>>
            <% (modules || []).forEach((mod) => { %><option value="<%= mod.name %>" <%= (modules || []).length === 1 ? 'selected' : '' %>><%= mod.name %> (<%= mod.code %>)</option><% }) %>
          </select>
          <span class="muted small"><%= (modules || []).length === 1 ? 'Only one module is available, so it has been preselected.' : 'Select one or more modules. Hold Ctrl/Cmd for multiple selection.' %></span>
        </label>

        <section class="v38-question-card stack" data-question-set="BUG">
          <div><span class="section-kicker">Issue context</span><h3>Help us reproduce and assess impact</h3></div>
          <label><span>What exactly is not working?</span><textarea name="actualBehavior" placeholder="Describe the broken flow, error, wrong result or failure symptom."></textarea></label>
          <label><span>Steps to reproduce</span><textarea name="stepsToReproduce" placeholder="Step 1... Step 2... Step 3..."></textarea></label>
          <div class="grid-two">
            <label><span>Expected behavior</span><input type="text" name="expectedBehavior" placeholder="What should have happened?" /></label>
            <label><span>Since when?</span><input type="text" name="startedAtText" placeholder="Today 9 AM, since last release" /></label>
          </div>
          <div class="grid-two">
            <label><span>Environment</span><input type="text" name="environment" placeholder="Production, UAT, Sandbox" /></label>
            <label><span>Workaround available?</span><select name="workaroundAvailable"><option value="UNKNOWN">Unknown</option><option value="YES">Yes</option><option value="NO">No</option></select></label>
          </div>
          <label><span>Business impact</span><textarea name="businessImpact" placeholder="Revenue impact, operational blockage, affected process, deadline..."></textarea></label>
        </section>

        <section class="v38-question-card stack" data-question-set="CR" hidden>
          <div><span class="section-kicker">Change context</span><h3>Help us understand the business need</h3></div>
          <label><span>Business justification</span><textarea name="businessJustification" placeholder="Why is this change needed?"></textarea></label>
          <div class="grid-two">
            <label><span>Expected outcome</span><input type="text" name="expectedOutcome" placeholder="What should change after implementation?" /></label>
            <label><span>Timeline needed</span><input type="text" name="requestedTimeline" placeholder="Required by / target window" /></label>
          </div>
          <div class="grid-two">
            <label><span>Impacted modules / processes</span><input type="text" name="impactedModules" placeholder="Billing, onboarding, report, API" /></label>
            <label><span>Existing workaround</span><select name="workaroundAvailable"><option value="UNKNOWN">Unknown</option><option value="YES">Yes</option><option value="NO">No</option></select></label>
          </div>
          <label><span>Priority reason</span><textarea name="businessImpact" placeholder="Compliance, customer commitment, operational benefit, deadline..."></textarea></label>
        </section>

        <section class="v38-question-card stack" data-question-set="QUERY" hidden>
          <div><span class="section-kicker">Query context</span><h3>Help us answer clearly</h3></div>
          <label><span>What clarification is needed?</span><textarea name="clarificationNeeded" placeholder="Ask the question in your own words."></textarea></label>
          <div class="grid-two">
            <label><span>Reference screen, report, API, or process</span><input type="text" name="referenceContext" placeholder="Where are you seeing this?" /></label>
            <label><span>When do you need this clarified?</span><input type="text" name="queryUrgency" placeholder="Normal / today / before month-end" /></label>
          </div>
          <label><span>Extra context</span><input type="text" name="extraContext" placeholder="Screenshot reference, report name, transaction ID, example case" /></label>
        </section>

        <section class="v38-question-card stack" data-question-set="SERVICE_REQUEST" hidden>
          <div><span class="section-kicker">Service context</span><h3>Help us plan the service</h3></div>
          <div class="grid-two">
            <label><span>Service needed</span><input type="text" name="serviceRequestKind" placeholder="Access, environment refresh, report extract" /></label>
            <label><span>Required by date</span><input type="date" name="requiredByDate" /></label>
          </div>
          <div class="grid-two">
            <label><span>Environment / scope</span><input type="text" name="serviceEnvironment" placeholder="Production, UAT, client, module" /></label>
            <label><span>Dependency/reference</span><input type="text" name="serviceReference" placeholder="Change ticket, release, approval, project" /></label>
          </div>
          <label><span>Service request details</span><textarea name="serviceRequestDetails" placeholder="Describe exactly what service you need and constraints."></textarea></label>
          <label><span>Justification</span><textarea name="businessImpact" placeholder="Why is this needed and what happens if delayed?"></textarea></label>
        </section>

        <div class="grid-two common-intake-field" data-common-for="BUG CR">
          <label>
            <span>How many users are affected?</span>
            <select name="affectedUsers">
              <option value="Only me">Only me</option>
              <option value="Few users">Few users</option>
              <option value="Entire team">Entire team</option>
              <option value="Entire client / business">Entire client / business</option>
              <option value="Unknown">Unknown</option>
            </select>
          </label>
          <label>
            <span>Is this blocking usage?</span>
            <select name="isBlocking">
              <option value="">Select...</option>
              <option value="YES">Yes, fully blocking</option>
              <option value="PARTIAL">Partially blocking</option>
              <option value="NO">No, can continue</option>
            </select>
          </label>
        </div>
      </aside>
    </div>

    <section class="stack" id="jira-dynamic-section" hidden>
      <div>
        <h2 style="margin:0">Additional information required for processing</h2>
        <p class="muted small" id="jira-dynamic-hint">Only Jira-required fields are shown. Optional Jira fields are hidden.</p>
      </div>
      <div class="grid-two" id="jira-dynamic-fields"></div>
    </section>

    <div class="form-actions between"><button type="button" class="secondary" data-prev-step>Back</button><button type="button" class="primary" data-next-step>Review request</button></div>
  </section>

  <section class="v38-intake-step" data-intake-step="3" hidden>
    <div class="v38-intake-hero compact">
      <div>
        <span class="section-kicker">Final check</span>
        <h2>Review and create</h2>
        <p class="muted">Check the essentials before creating the request.</p>
      </div>
    </div>
    <div class="v38-review-card" id="v38-review-card"></div>
    <div class="form-actions between"><button type="button" class="secondary" data-prev-step>Back to details</button><button type="submit" class="primary">Create Request</button></div>
  </section>
</form>

<script>
  (function () {
    const requestTaxonomy = <%- JSON.stringify(taxonomy) %>;
    const entityTaxonomyMap = <%- JSON.stringify(entityTaxonomyById) %>;
    const requestTypeInput = document.getElementById('requestType');
    const categorySelect = document.getElementById('request-category');
    const categoryHelp = document.getElementById('category-help');
    const categoryLabel = document.getElementById('classification-label');
    const priorityLabel = document.getElementById('priority-label');
    const severitySelect = document.getElementById('severity-select');
    const requestCards = Array.from(document.querySelectorAll('[data-request-type-card]'));
    const steps = Array.from(document.querySelectorAll('[data-intake-step]'));
    const stepPills = Array.from(document.querySelectorAll('[data-step-pill]'));
    let currentStep = 1;

    const typeMeta = {
      BUG: { label: 'Issue', heading: 'Tell us what is not working', subtitle: 'Capture impact, reproduction details and the expected behavior.', priority: 'Severity', classification: 'Issue classification', placeholder: 'Select issue classification', optionPrefix: 'Severity' },
      CR: { label: 'Change Request', heading: 'Tell us about the change', subtitle: 'Capture the business need, expected outcome and target timeline.', priority: 'Business priority', classification: 'Change classification', placeholder: 'Select change classification', optionPrefix: 'Priority' },
      QUERY: { label: 'Query', heading: 'Tell us what you need clarified', subtitle: 'Capture the question, reference context and required response urgency.', priority: 'Urgency', classification: 'Query classification', placeholder: 'Select query classification', optionPrefix: 'Urgency' },
      SERVICE_REQUEST: { label: 'Service Request', heading: 'Tell us what service you need', subtitle: 'Capture the service, scope, dependency and required date.', priority: 'Request priority', classification: 'Service classification', placeholder: 'Select service classification', optionPrefix: 'Priority' }
    };

    const priorityText = {
      BUG: { CRITICAL: 'Critical', HIGH: 'High', MEDIUM: 'Medium', LOW: 'Low', S1: 'S1 - Critical', S2: 'S2 - High', S3: 'S3 - Medium', S4: 'S4 - Low' },
      CR: { CRITICAL: 'Critical business priority', HIGH: 'High business priority', MEDIUM: 'Medium business priority', LOW: 'Low business priority', S1: 'S1 - Critical business priority', S2: 'S2 - High business priority', S3: 'S3 - Medium business priority', S4: 'S4 - Low business priority' },
      QUERY: { CRITICAL: 'Urgent', HIGH: 'Urgent', MEDIUM: 'Normal', LOW: 'Low', S1: 'Urgent', S2: 'High urgency', S3: 'Normal', S4: 'Low' },
      SERVICE_REQUEST: { CRITICAL: 'Critical request priority', HIGH: 'High request priority', MEDIUM: 'Normal request priority', LOW: 'Low request priority', S1: 'S1 - Critical request priority', S2: 'S2 - High request priority', S3: 'Normal request priority', S4: 'Low request priority' }
    };

    function escapeHtml(value) { return String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char])); }
    function activeType() { return requestTypeInput ? requestTypeInput.value : 'BUG'; }
    function effectiveTaxonomy() {
      const entityId = document.getElementById('entityId') ? document.getElementById('entityId').value : '';
      const scoped = entityId && entityTaxonomyMap[entityId] ? entityTaxonomyMap[entityId] : requestTaxonomy;
      return Array.isArray(scoped) && scoped.length ? scoped : requestTaxonomy;
    }
    function activeTaxonomyItem() { return effectiveTaxonomy().find((item) => item.key === activeType()) || effectiveTaxonomy()[0] || null; }
    function meta() { return typeMeta[activeType()] || typeMeta.BUG; }

    function setStep(step) {
      currentStep = Math.max(1, Math.min(3, step));
      steps.forEach((section) => { const active = Number(section.getAttribute('data-intake-step')) === currentStep; section.hidden = !active; section.classList.toggle('active', active); });
      stepPills.forEach((pill) => pill.classList.toggle('active', Number(pill.getAttribute('data-step-pill')) === currentStep));
      if (currentStep === 3) renderReview();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderCategories() {
      const item = activeTaxonomyItem();
      const classifications = item && Array.isArray(item.classifications) ? item.classifications : [];
      const categoryField = document.getElementById('category-field');
      categorySelect.innerHTML = '';
      if (categoryLabel) categoryLabel.textContent = meta().classification;
      const mustAsk = !!(item && item.classificationRequired && classifications.length);
      if (!mustAsk) {
        const option = document.createElement('option');
        option.value = item ? item.label : 'General';
        option.textContent = item ? item.label : 'General';
        categorySelect.appendChild(option);
        categorySelect.required = false;
        if (categoryField) categoryField.hidden = true;
        if (categoryHelp) categoryHelp.textContent = 'Second-level classification is not required for this entity.';
        return;
      }
      if (categoryField) categoryField.hidden = false;
      categorySelect.required = true;
      const blank = document.createElement('option'); blank.value = ''; blank.textContent = meta().placeholder; categorySelect.appendChild(blank);
      classifications.forEach(function (classification) { const option = document.createElement('option'); option.value = classification; option.textContent = classification; categorySelect.appendChild(option); });
      if (categoryHelp) categoryHelp.textContent = 'This classification is required for the selected request type and entity.';
    }

    function relabelPriority() {
      if (!severitySelect) return;
      if (priorityLabel) priorityLabel.textContent = meta().priority;
      Array.from(severitySelect.options).forEach((option) => {
        if (!option.value) { option.textContent = 'Select ' + meta().priority.toLowerCase(); return; }
        const normalized = String(option.value || '').toUpperCase();
        option.textContent = (priorityText[activeType()] && priorityText[activeType()][normalized]) || option.value;
      });
    }

    function setSectionEnabled(section, enabled) {
      section.hidden = !enabled;
      section.querySelectorAll('input, select, textarea').forEach(function(field) { field.disabled = !enabled; });
    }

    function syncRequestTypeUi() {
      const scopedTaxonomy = effectiveTaxonomy();
      const enabledKeys = scopedTaxonomy.filter((item) => item.enabled !== false).map((item) => item.key);
      if (enabledKeys.length && enabledKeys.indexOf(activeType()) === -1 && requestTypeInput) requestTypeInput.value = enabledKeys[0];
      const value = activeType();
      requestCards.forEach((card) => {
        const key = card.getAttribute('data-request-type-card');
        const visible = enabledKeys.indexOf(key) !== -1;
        card.hidden = !visible;
        card.classList.toggle('active', key === value);
      });
      document.querySelectorAll('[data-question-set]').forEach((section) => setSectionEnabled(section, section.getAttribute('data-question-set') === value));
      document.querySelectorAll('[data-common-for]').forEach((section) => { const allowed = String(section.getAttribute('data-common-for') || '').split(/\s+/); setSectionEnabled(section, allowed.indexOf(value) !== -1); });
      const m = meta();
      const kicker = document.getElementById('selected-type-kicker');
      const heading = document.getElementById('selected-type-heading');
      const subtitle = document.getElementById('selected-type-subtitle');
      if (kicker) kicker.textContent = m.label;
      if (heading) heading.textContent = m.heading;
      if (subtitle) subtitle.textContent = m.subtitle;
      relabelPriority();
      renderCategories();
    }

    function valueOf(selector) {
      const el = document.querySelector(selector);
      if (!el) return '';
      if (el.tagName === 'SELECT' && el.multiple) return Array.from(el.selectedOptions).map((o) => o.textContent.trim()).join(', ');
      if (el.tagName === 'SELECT') return el.selectedOptions[0] ? el.selectedOptions[0].textContent.trim() : '';
      return el.value || '';
    }

    function renderReview() {
      const card = document.getElementById('v38-review-card');
      if (!card) return;
      const rows = [
        ['Request type', meta().label],
        ['Title', valueOf('input[name="title"]')],
        [meta().priority, valueOf('select[name="severity"]')],
        [meta().classification, valueOf('#request-category')],
        ['Entity', valueOf('#entityId')],
        ['Modules', valueOf('select[name="modules"]') || '-']
      ];
      const typeRows = {
        BUG: [['Impact', valueOf('textarea[name="businessImpact"]')], ['Environment', valueOf('input[name="environment"]')], ['Blocking?', valueOf('select[name="isBlocking"]')]],
        CR: [['Business justification', valueOf('textarea[name="businessJustification"]')], ['Timeline', valueOf('input[name="requestedTimeline"]')], ['Expected outcome', valueOf('input[name="expectedOutcome"]')]],
        QUERY: [['Clarification needed', valueOf('textarea[name="clarificationNeeded"]')], ['Reference', valueOf('input[name="referenceContext"]')]],
        SERVICE_REQUEST: [['Service needed', valueOf('input[name="serviceRequestKind"]')], ['Required by', valueOf('input[name="requiredByDate"]')], ['Scope', valueOf('input[name="serviceEnvironment"]')]]
      };
      const allRows = rows.concat(typeRows[activeType()] || []);
      card.innerHTML = '<div class="v38-review-grid">' + allRows.map(([label, value]) => '<div><span>' + escapeHtml(label) + '</span><strong>' + escapeHtml(value || '-') + '</strong></div>').join('') + '</div><div class="v38-review-description"><span>Description</span><p>' + escapeHtml(valueOf('textarea[name="description"]') || '-') + '</p></div>';
    }

    requestCards.forEach(function(card){ card.addEventListener('click', function(){ if (requestTypeInput) requestTypeInput.value = card.getAttribute('data-request-type-card'); syncRequestTypeUi(); }); });
    document.querySelectorAll('[data-next-step]').forEach((btn) => btn.addEventListener('click', () => {
      if (currentStep === 2) {
        const form = document.getElementById('v38-intake-form');
        if (form && !form.checkValidity()) { form.reportValidity(); return; }
      }
      setStep(currentStep + 1);
    }));
    document.querySelectorAll('[data-prev-step]').forEach((btn) => btn.addEventListener('click', () => setStep(currentStep - 1)));
    syncRequestTypeUi();

    const reassessButton = document.getElementById('severity-reassess-button');
    const suggestionBox = document.getElementById('severity-suggestion-result');
    function severitySuggestion() {
      const text = [
        document.querySelector('input[name="title"]')?.value || '',
        document.querySelector('textarea[name="description"]')?.value || '',
        document.querySelector('textarea[name="businessImpact"]')?.value || '',
        document.querySelector('textarea[name="actualBehavior"]')?.value || '',
        document.querySelector('textarea[name="businessJustification"]')?.value || '',
        document.querySelector('textarea[name="clarificationNeeded"]')?.value || '',
        document.querySelector('textarea[name="serviceRequestDetails"]')?.value || ''
      ].join(' ').toLowerCase();
      let value = 'S3';
      let reason = 'Normal priority based on the current context.';
      if (/production|prod|outage|down|blocked|blocking|critical|payment|billing|revenue|security|data loss|cannot login|all users|entire/.test(text)) { value = 'S1'; reason = 'The context suggests production/business impact or blocking language.'; }
      else if (/urgent|today|deadline|many users|multiple users|slow|failure|failed|error|month.?end|release/.test(text)) { value = 'S2'; reason = 'The context suggests urgency, errors, or multiple-user impact.'; }
      else if (/clarification|how to|question|query|minor|low|cosmetic/.test(text)) { value = activeType() === 'QUERY' ? 'S4' : 'S3'; reason = 'The context sounds non-blocking or clarification-oriented.'; }
      return { value, reason };
    }
    if (reassessButton && suggestionBox && severitySelect) {
      reassessButton.addEventListener('click', function () {
        const suggestion = severitySuggestion();
        const label = (priorityText[activeType()] && priorityText[activeType()][suggestion.value]) || suggestion.value;
        suggestionBox.hidden = false;
        suggestionBox.innerHTML = '<div><strong>Suggested ' + escapeHtml(meta().priority.toLowerCase()) + ': ' + escapeHtml(label) + '</strong><p class="muted small">' + escapeHtml(suggestion.reason) + '</p></div><button type="button" class="primary tiny" id="accept-severity-suggestion">Accept suggestion</button>';
        document.getElementById('accept-severity-suggestion')?.addEventListener('click', function () {
          severitySelect.value = suggestion.value;
          relabelPriority();
          suggestionBox.classList.add('accepted');
          this.textContent = 'Accepted';
        });
      });
    }

    const entitySelect = document.getElementById('entityId');
    const kbButton = document.getElementById('knowledge-solution-button');
    const kbResult = document.getElementById('knowledge-solution-result');
    const kbCopy = document.getElementById('knowledge-copy-button');
    const desc = document.getElementById('issue-description');
    if (kbButton && kbResult && desc) {
      kbButton.addEventListener('click', async function () {
        const q = [document.querySelector('input[name="title"]')?.value || '', desc.value || ''].join(' ').trim();
        kbResult.hidden = false;
        kbResult.textContent = q.length < 5 ? 'Add a title or description first, then search knowledge.' : 'Searching knowledge base…';
        if (q.length < 5) return;
        try {
          const response = await fetch('<%= basePath %>/knowledge/search?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } });
          const payload = await response.json();
          const items = payload.items || [];
          kbResult.innerHTML = '<strong>' + (payload.answer || 'Knowledge search complete') + '</strong>' + (items.length ? '<ul>' + items.map((item) => '<li><strong>' + escapeHtml(item.title) + '</strong><br><span>' + escapeHtml(item.snippet || '') + '</span></li>').join('') + '</ul>' : '');
          if (kbCopy) kbCopy.hidden = false;
        } catch (error) { kbResult.textContent = 'Knowledge search failed. You can still create the request.'; if (kbCopy) kbCopy.hidden = true; }
      });
      if (kbCopy) kbCopy.addEventListener('click', async function () {
        const text = kbResult.innerText || kbResult.textContent || '';
        try { await navigator.clipboard.writeText(text); kbCopy.textContent = 'Copied'; setTimeout(() => { kbCopy.textContent = 'Copy solution'; }, 1200); } catch (error) { kbCopy.textContent = 'Copy failed'; setTimeout(() => { kbCopy.textContent = 'Copy solution'; }, 1200); }
      });
    }

    const voiceButton = document.getElementById('voice-description-button');
    const voiceStatus = document.getElementById('voice-description-status');
    if (voiceButton && desc) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        voiceButton.hidden = true;
        if (voiceStatus) voiceStatus.textContent = 'Voice input is not supported in this browser. You can type normally.';
      } else {
        let recognition = null;
        let isListening = false;
        let lastTranscript = '';
        function setVoiceStatus(message) { if (voiceStatus) voiceStatus.textContent = message; }
        function stopVoiceSafely() {
          if (recognition && isListening) {
            try { recognition.stop(); } catch (error) {}
          }
          isListening = false;
          voiceButton.classList.remove('is-listening');
        }
        function createRecognition() {
          const instance = new SpeechRecognition();
          instance.lang = 'en-IN';
          instance.interimResults = false;
          instance.continuous = false;
          instance.onresult = function (event) {
            const text = Array.from(event.results || []).map((r) => r[0] && r[0].transcript).filter(Boolean).join(' ').trim();
            if (!text || text === lastTranscript) return;
            lastTranscript = text;
            const existing = desc.value.trim();
            desc.value = existing ? existing + '\n' + text : text;
            desc.dispatchEvent(new Event('input', { bubbles: true }));
            setVoiceStatus('Added voice input to description.');
          };
          instance.onerror = function (event) {
            isListening = false;
            voiceButton.classList.remove('is-listening');
            setVoiceStatus(event && event.error === 'not-allowed' ? 'Microphone permission was blocked. You can type normally.' : 'Voice input stopped. You can type normally.');
          };
          instance.onend = function () {
            isListening = false;
            voiceButton.classList.remove('is-listening');
            if (voiceStatus && voiceStatus.textContent === 'Listening…') setVoiceStatus('Voice input stopped.');
          };
          return instance;
        }
        voiceButton.addEventListener('click', function () {
          if (isListening) { stopVoiceSafely(); return; }
          recognition = createRecognition();
          try {
            isListening = true;
            voiceButton.classList.add('is-listening');
            setVoiceStatus('Listening…');
            recognition.start();
          } catch (error) {
            isListening = false;
            voiceButton.classList.remove('is-listening');
            setVoiceStatus('Voice input could not start. You can type normally.');
          }
        });
        document.querySelectorAll('[data-next-step], [data-prev-step], [data-request-type]').forEach((control) => {
          control.addEventListener('click', stopVoiceSafely);
        });
        window.addEventListener('beforeunload', stopVoiceSafely);
      }
    }

    const section = document.getElementById('jira-dynamic-section');
    const fieldsContainer = document.getElementById('jira-dynamic-fields');
    const hint = document.getElementById('jira-dynamic-hint');
    if (!entitySelect || !section || !fieldsContainer) return;

    function renderField(field) {
      const name = `jiraField__${field.fieldId}`;
      const required = field.required ? 'required' : '';
      const requiredMark = field.required ? '*' : '';
      const options = (field.allowedValues || []).map((option) => `<option value="${escapeHtml(option.id || option.value)}">${escapeHtml(option.name || option.value)}</option>`).join('');
      if (field.uiType === 'textarea') return `<label><span>${escapeHtml(field.name)} ${requiredMark}</span><textarea name="${escapeHtml(name)}" ${required}></textarea></label>`;
      if (field.uiType === 'select' || field.uiType === 'multiselect') return `<label><span>${escapeHtml(field.name)} ${requiredMark}</span><select name="${escapeHtml(name)}" ${required}><option value="">Select...</option>${options}</select></label>`;
      return `<label><span>${escapeHtml(field.name)} ${requiredMark}</span><input type="text" name="${escapeHtml(name)}" ${required} /></label>`;
    }

    async function loadFields() {
      const entityId = entitySelect.value;
      if (!entityId) { section.hidden = true; fieldsContainer.innerHTML = ''; return; }
      try {
        const response = await fetch(entitySelect.dataset.jiraFieldsUrl.replace('__ENTITY_ID__', entityId), { headers: { Accept: 'application/json' } });
        const payload = await response.json();
        const item = payload.item || {};
        const fields = item.fields || [];
        if (!fields.length) { section.hidden = true; fieldsContainer.innerHTML = ''; return; }
        hint.textContent = `Only required Jira fields for ${(item.jiraConfig && item.jiraConfig.projectKey) || ''} / ${(item.jiraConfig && item.jiraConfig.issueTypeName) || ''}`;
        fieldsContainer.innerHTML = fields.map(renderField).join('');
        section.hidden = false;
      } catch (error) { section.hidden = true; fieldsContainer.innerHTML = ''; }
    }

    entitySelect.addEventListener('change', function () { syncRequestTypeUi(); loadFields(); });
    if (entitySelect.value) loadFields();
  })();
</script>
