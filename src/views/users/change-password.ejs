<section class="page-header compact-password-header">
  <div>
    <div class="section-kicker">Account security</div>
    <h1>Change Password</h1>
    <p class="muted">Use a password you can remember. You will be asked to sign in again after changing it.</p>
  </div>
</section>

<section class="card stack change-password-card">
  <form method="post" action="<%= basePath %>/users/account/change-password" class="stack" id="change-password-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="password-field"><span>Current password</span><div class="password-input-wrap"><input type="password" name="currentPassword" id="currentPassword" required autocomplete="current-password" /><button type="button" class="password-eye" data-target="currentPassword" aria-label="Show current password">👁</button></div></label>
    <label class="password-field"><span>New password</span><div class="password-input-wrap"><input type="password" name="newPassword" id="newPassword" minlength="8" required autocomplete="new-password" /><button type="button" class="password-eye" data-target="newPassword" aria-label="Show new password">👁</button></div><small class="muted">Minimum 8 characters.</small></label>
    <label class="password-field"><span>Confirm new password</span><div class="password-input-wrap"><input type="password" name="confirmPassword" id="confirmPassword" minlength="8" required autocomplete="new-password" /><button type="button" class="password-eye" data-target="confirmPassword" aria-label="Show confirm password">👁</button></div><small id="password-match-hint" class="muted password-match-hint">Enter the same password again.</small></label>
    <div class="form-actions right wrap-actions">
      <a class="button-link secondary" href="<%= currentUser && currentUser.role === 'client' ? basePath + '/client/dashboard' : basePath + '/dashboard' %>">Back</a>
      <button type="submit" id="change-password-submit">Change Password</button>
    </div>
  </form>
</section>
<script>
  (() => {
    document.querySelectorAll('.password-eye').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        btn.textContent = input.type === 'password' ? '👁' : '🙈';
      });
    });
    const next = document.getElementById('newPassword');
    const confirm = document.getElementById('confirmPassword');
    const hint = document.getElementById('password-match-hint');
    function syncMatch() {
      const a = next.value || '';
      const b = confirm.value || '';
      if (!b) { hint.textContent = 'Enter the same password again.'; hint.className = 'muted password-match-hint'; return; }
      if (a === b && a.length >= 8) { hint.textContent = '✓ Passwords match'; hint.className = 'password-match-hint success'; return; }
      hint.textContent = 'Passwords do not match yet'; hint.className = 'password-match-hint danger';
    }
    next?.addEventListener('input', syncMatch);
    confirm?.addEventListener('input', syncMatch);
  })();
</script>
