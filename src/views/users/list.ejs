<section class="page-header">
  <div><h1>Users</h1><p class="muted">Visible users are restricted to your administrative scope.</p></div>
  <div class="header-actions wrap-actions"><a class="button-link secondary" href="<%= basePath %>/users/export<%= buildQueryString(filters) %>">Download Excel</a><% if (currentUser.role === 'superadmin') { %><a class="button-link secondary" href="<%= basePath %>/users/approved">Approved Pool</a><% } %><a class="button-link" href="<%= basePath %>/users/new">Create User</a></div>
</section>
<form method="get" action="<%= basePath %>/users" class="card filters-form stack">
  <div class="grid-two">
    <label><span>Search</span><input type="text" name="q" value="<%= filters.q %>" placeholder="Name, email, entity" /></label>
    <label>
      <span>Role</span>
      <select name="role">
        <option value="">All roles</option>
        <option value="superadmin" <%= filters.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
        <option value="agent_manager" <%= filters.role === 'agent_manager' ? 'selected' : '' %>>Agent Manager</option>
        <option value="agent_user" <%= filters.role === 'agent_user' ? 'selected' : '' %>>Agent User</option>
        <option value="regional_head" <%= filters.role === 'regional_head' ? 'selected' : '' %>>Regional Head</option>
            <option value="support_head" <%= filters.role === 'support_head' ? 'selected' : '' %>>Support Head</option>
            <option value="engagement_manager" <%= filters.role === 'engagement_manager' ? 'selected' : '' %>>Engagement Manager</option>
        <option value="client" <%= filters.role === 'client' ? 'selected' : '' %>>Client User</option>
      </select>
    </label>
  </div>
  <div class="form-actions right wrap-actions"><a class="button-link secondary" href="<%= basePath %>/users">Reset</a><button type="submit">Apply Filters</button></div>
</form>
<section class="card">
  <% if (!users.length) { %>
    <p class="muted">No users available.</p>
  <% } else { %>
    <div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Entity Access</th></tr></thead><tbody><% users.forEach(({ user, memberships }) => { %><tr><td><% if (currentUser.role === 'superadmin') { %><a href="<%= basePath %>/users/<%= user._id %>"><%= user.name %></a><% } else { %><%= user.name %><% } %></td><td><%= user.email %></td><td><span class="pill"><%= user.role === 'client' ? 'CLIENT_USER' : user.role.toUpperCase() %></span></td><td><%= memberships.length ? memberships.map((m) => `${m.entityId ? m.entityId.path : 'Unknown'}`).join(', ') : 'All entities' %></td></tr><% }) %></tbody></table></div><%- include('../partials/pagination', { pager, baseUrl: `${basePath}/users`, filters, buildQueryString }) %>
  <% } %>
</section>
