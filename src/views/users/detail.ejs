<section class="page-header">
  <div><h1><%= user.name %></h1><p class="muted"><%= user.email %> · <%= user.role === 'client' ? 'CLIENT_USER' : user.role.toUpperCase() %></p></div>
</section>
<section class="grid-two">
  <article class="card stack">
    <h2>Edit user</h2>
    <form method="post" action="<%= basePath %>/users/<%= user._id %>/edit" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="grid-two">
        <label><span>Name</span><input type="text" name="name" value="<%= user.name %>" required /></label>
        <label><span>Email</span><input type="email" name="email" value="<%= user.email %>" required /></label>
        <label>
          <span>User Type</span>
          <select name="role" id="role-select">
            <option value="superadmin" <%= user.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
            <option value="agent_manager" <%= user.role === 'agent_manager' ? 'selected' : '' %>>Agent Manager</option>
            <option value="agent_user" <%= user.role === 'agent_user' || user.role === 'agent' ? 'selected' : '' %>>Agent User</option>
            <option value="regional_head" <%= user.role === 'regional_head' ? 'selected' : '' %>>Regional Head</option>
            <option value="support_head" <%= user.role === 'support_head' ? 'selected' : '' %>>Support Head</option>
            <option value="engagement_manager" <%= user.role === 'engagement_manager' ? 'selected' : '' %>>Engagement Manager</option>
            <option value="client" <%= user.role === 'client' ? 'selected' : '' %>>Client User</option>
          </select>
        </label>
        <label><span>Active</span><select name="isActive"><option value="true" <%= user.isActive ? 'selected' : '' %>>Active</option><option value="false" <%= !user.isActive ? 'selected' : '' %>>Inactive</option></select></label>
      </div>
      <label><span>Reset password</span><input type="password" name="password" placeholder="Leave blank to keep current password" /></label>

      <label id="entity-access-field">
        <span>Client / Entity access</span>
        <select name="entityIds" id="entity-access-select" multiple size="10">
          <% entities.forEach((item) => { const selected = memberships.some((m) => String(m.entityId?._id || m.entityId) === String(item._id)); %>
            <option value="<%= item._id %>" <%= selected ? 'selected' : '' %>><%= item.path %></option>
          <% }) %>
        </select>
        <small class="muted">Hold Ctrl/Cmd to select the clients or entities this user should access. Superadmin does not require entity access.</small>
      </label>
      <div class="form-actions right"><button type="submit">Save User</button></div>
    </form>
  </article>
  <article class="card">
    <h2>Memberships</h2>
    <% if (!memberships.length) { %><p class="muted">No explicit memberships.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Entity</th><th>Access</th><th>Status</th></tr></thead><tbody>
        <% memberships.forEach((item) => { %><tr><td><%= item.entityId?.path || '—' %></td><td>Assigned</td><td><%= item.status %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </article>
</section>
<script>
(function(){
  var roleSelect=document.getElementById('role-select');
  var entityField=document.getElementById('entity-access-field');
  var entitySelect=document.getElementById('entity-access-select');
  if(!roleSelect || !entityField || !entitySelect)return;
  function syncVisibility(){
    var role=roleSelect.value;
    var needsEntities = role !== 'superadmin';
    entityField.style.display=needsEntities?'':'none';
    entitySelect.required=needsEntities;
    entitySelect.disabled=!needsEntities;
  }
  roleSelect.addEventListener('change', syncVisibility);
  syncVisibility();
})();
</script>
