<section class="page-header">
  <div>
    <h1>Knowledge Hub</h1>
    <p class="muted">Manage issue databases, KB articles, client signals, uploaded mails, RCA libraries and operational memory used by the chatbot.</p>
  </div>
</section>

<% if (canManageKnowledge) { %>
<section class="grid-two knowledge-admin-grid">
  <div class="card stack form-card">
    <h2>Upload knowledge file</h2>
    <form method="post" action="<%= basePath %>/knowledge" enctype="multipart/form-data" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label><span>Title</span><input type="text" name="title" placeholder="ING historical issues export" /></label>
      <label><span>Source type</span><select name="sourceType"><option value="ISSUE_DATABASE">Issue database</option><option value="JIRA_EXPORT">Jira export</option><option value="RCA_LIBRARY">RCA library</option><option value="KB_ARTICLE">KB article</option><option value="MAIL_UPLOAD">Mail upload</option><option value="CLIENT_SIGNAL">Client signal</option><option value="OTHER">Other</option></select></label>
      <label><span>Tags</span><input type="text" name="tags" placeholder="payments, upload, production" /></label>
      <label><span>Who can use this knowledge?</span><select name="visibilityScope" data-knowledge-scope><option value="INTERNAL_ONLY">Internal users only</option><option value="ALL_CUSTOMERS">All customers + internal users</option><option value="SPECIFIC_CUSTOMERS">Specific customers/entities only</option></select></label>
      <label data-knowledge-entities style="display:none;"><span>Specific customer/entity scope</span><select name="scopedEntityIds" multiple size="6"><% (entities || []).forEach((entity) => { %><option value="<%= entity._id %>"><%= entity.path || entity.name %></option><% }) %></select></label>
      <label><span>Review status</span><select name="knowledgeStatus"><option value="DRAFT">Draft</option><option value="REVIEWED">Reviewed</option><option value="PUBLISHED">Published</option></select></label>
      <label><span>File</span><input type="file" name="knowledgeFile" required accept=".csv,.txt,.json,.log,.eml" /></label>
      <div class="form-actions right"><button type="submit">Upload Knowledge</button></div>
    </form>
  </div>

  <div class="card stack form-card">
    <h2>Add client / operational note</h2>
    <p class="muted small">Use this for general comments, meeting notes, mail summaries, tags, mood gauge, client context, or engagement signals.</p>
    <form method="post" action="<%= basePath %>/knowledge/note" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label><span>Title</span><input type="text" name="title" placeholder="Client mood after May release" /></label>
      <label><span>Type</span><select name="sourceType"><option value="CLIENT_SIGNAL">Client signal / mood gauge</option><option value="MAIL_UPLOAD">Mail summary</option><option value="KB_ARTICLE">Knowledge note</option><option value="OTHER">Other</option></select></label>
      <label><span>Tags</span><input type="text" name="tags" placeholder="ING, escalation, positive, release" /></label>
      <label><span>Scope</span><select name="visibilityScope" data-knowledge-scope><option value="INTERNAL_ONLY">Internal users only</option><option value="ALL_CUSTOMERS">All customers + internal users</option><option value="SPECIFIC_CUSTOMERS">Specific customers/entities only</option></select></label>
      <label data-knowledge-entities style="display:none;"><span>Specific customer/entity scope</span><select name="scopedEntityIds" multiple size="6"><% (entities || []).forEach((entity) => { %><option value="<%= entity._id %>"><%= entity.path || entity.name %></option><% }) %></select></label>
      <label><span>Comment / mail / signal</span><textarea name="rawText" required placeholder="Paste customer mail, meeting comment, engagement note, sentiment, recurring complaint, etc."></textarea></label>
      <div class="form-actions right"><button type="submit">Save Knowledge Note</button></div>
    </form>
  </div>
</section>
<% } else { %>
<section class="card stack section-card"><h2>Available knowledge</h2><p class="muted">These are the customer-visible or scoped knowledge items available to your role.</p></section>
<% } %>

<section class="card stack section-card">
  <div class="section-title-row"><h2>Knowledge bases</h2><span class="pill subtle"><%= docs.length %></span></div>
  <% if (!docs.length) { %><p class="muted">No knowledge items are available yet.</p><% } %>
  <% docs.forEach((doc) => { %>
    <details class="comment-card knowledge-item-card">
      <summary class="comment-meta-row"><strong><%= doc.title %></strong><span class="pill brand-soft"><%= doc.knowledgeStatus || doc.learningStatus %></span></summary>
      <p class="muted small"><%= doc.originalName || 'Manual note' %> · <%= doc.sourceType %> · <%= doc.visibilityScope || 'INTERNAL_ONLY' %> · <%= doc.rowsIngested || 0 %> row(s) · updated <%= doc.updatedAt ? new Date(doc.updatedAt).toLocaleString() : '-' %></p>
      <% if (doc.visibilityScope === 'SPECIFIC_CUSTOMERS' && doc.scopedEntityIds && doc.scopedEntityIds.length) { %><p class="small"><strong>Scope:</strong> <%= doc.scopedEntityIds.map((entity) => entity.path || entity.name).join(', ') %></p><% } %>
      <% if (doc.tags && doc.tags.length) { %><div class="tag-row"><% doc.tags.forEach((tag) => { %><span class="pill subtle"><%= tag %></span><% }) %></div><% } %>
      <p class="body-copy"><%= (doc.rawText || '').slice(0, 900) %><%= doc.rawText && doc.rawText.length > 900 ? '…' : '' %></p>
      <% if (canManageKnowledge) { %>
        <form method="post" action="<%= basePath %>/knowledge/<%= doc._id %>/update" class="stack knowledge-edit-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label><span>Title</span><input type="text" name="title" value="<%= doc.title %>" /></label>
          <label><span>Tags</span><input type="text" name="tags" value="<%= (doc.tags || []).join(', ') %>" /></label>
          <label><span>Status</span><select name="knowledgeStatus"><% ['DRAFT','REVIEWED','PUBLISHED','ARCHIVED'].forEach((st) => { %><option value="<%= st %>" <%= doc.knowledgeStatus === st ? 'selected' : '' %>><%= st %></option><% }) %></select></label>
          <label><span>Scope</span><select name="visibilityScope"><% ['INTERNAL_ONLY','ALL_CUSTOMERS','SPECIFIC_CUSTOMERS'].forEach((scope) => { %><option value="<%= scope %>" <%= doc.visibilityScope === scope ? 'selected' : '' %>><%= scope %></option><% }) %></select></label>
          <label><span>Specific entity scope</span><select name="scopedEntityIds" multiple size="5"><% (entities || []).forEach((entity) => { const selected = (doc.scopedEntityIds || []).some((e) => String(e._id || e) === String(entity._id)); %><option value="<%= entity._id %>" <%= selected ? 'selected' : '' %>><%= entity.path || entity.name %></option><% }) %></select></label>
          <label><span>Knowledge text</span><textarea name="rawText"><%= doc.rawText || '' %></textarea></label>
          <div class="form-actions right"><button type="submit">Update</button></div>
        </form>
        <form method="post" action="<%= basePath %>/knowledge/<%= doc._id %>/delete" onsubmit="return confirm('Delete this knowledge item?')" class="form-actions right">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="secondary danger-soft">Delete</button>
        </form>
      <% } %>
    </details>
  <% }) %>
</section>

<script>
  (function(){
    document.querySelectorAll('[data-knowledge-scope]').forEach(function(scope){
      const wrap = scope.closest('form').querySelector('[data-knowledge-entities]');
      if(!wrap) return; const sync=function(){wrap.style.display = scope.value === 'SPECIFIC_CUSTOMERS' ? 'block' : 'none';};
      scope.addEventListener('change', sync); sync();
    });
  }());
</script>
