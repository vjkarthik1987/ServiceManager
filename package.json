{
  "name": "service-desk-v25",
  "version": "25.0.0",
  "private": true,
  "description": "Service Manager v25.0.0 \u2014 live Jira API workflow rebuild for Incident, Change Request, Problem and Maintenance; Service Request deferred.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,org,identity,request -c white,green,yellow,cyan \"npm run dev -w @service-desk/web\" \"npm run dev -w @service-desk/organization-service\" \"npm run dev -w @service-desk/identity-service\" \"npm run dev -w @service-desk/request-service\"",
    "start": "concurrently -k -n web,org,identity,request -c white,green,yellow,cyan \"npm run start -w @service-desk/web\" \"npm run start -w @service-desk/organization-service\" \"npm run start -w @service-desk/identity-service\" \"npm run start -w @service-desk/request-service\"",
    "health": "node scripts/check-services.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "configure:xelerate-tasks": "node scripts/configure-xelerate-workflow-tasks.mjs",
    "provision:suntecsds-service-model": "node scripts/provision-suntecsds-service-model.mjs",
    "bootstrap:suntec": "node scripts/bootstrap-suntec-cloud.mjs",
    "provision:v23:dry": "node scripts/provision-v23-saas-service-model.mjs --dry-run",
    "verify:v23-guard": "node scripts/verify-v23-normal-incident-guard.mjs",
    "test:v23": "node --test tests/v23-service-model.test.mjs tests/v23-db-discovery.test.mjs",
    "v23:preflight": "node scripts/v23-preflight.mjs",
    "v23:dry": "node scripts/provision-v23-saas-service-model.mjs --dry-run",
    "v23:test": "node --test tests/v23-service-model.test.mjs tests/v23-db-discovery.test.mjs",
    "test:v23.1": "node --test tests/v23.1-taxonomy.test.mjs",
    "test:all": "node --test tests/v23-service-model.test.mjs tests/v23-db-discovery.test.mjs tests/v23.1-taxonomy.test.mjs tests/v23.1.1-seed-catalogue.test.mjs tests/v23.1.1-ui.test.mjs tests/v23.1.2-sla-calendar.test.mjs tests/v23.1.2-uat-readiness.test.mjs tests/v23.1.3-uat-fixes.test.mjs tests/v23.1.4-uat-fixes.test.mjs tests/v23.1.5-home-ack-hotfix.test.mjs tests/v23.1.6-uat-comments-intake.test.mjs tests/v23.1.7-audit-visibility.test.mjs tests/v24-service-model.test.mjs tests/v24.1-intake-regressions.test.mjs tests/v24.1-status-sla-config.test.mjs tests/v24.2-ux-config.test.mjs tests/v24.2.1-edit-maintenance.test.mjs tests/v25-jira-workflow-source-truth.test.mjs",
    "setup:users": "node scripts/setup-suntec-users.mjs",
    "setup:taxonomy": "node scripts/setup-request-taxonomy.mjs",
    "test:v23.1.1": "node --test tests/v23.1.1-seed-catalogue.test.mjs tests/v23.1.1-ui.test.mjs",
    "seed:uat:master": "node scripts/seed-uat-master-data.mjs",
    "seed:uat:users-slas": "node scripts/seed-uat-users-slas.mjs",
    "seed:uat:support": "node scripts/seed-uat-support-model.mjs",
    "test:v23.1.2": "node --test tests/v23.1.2-sla-calendar.test.mjs tests/v23.1.2-uat-readiness.test.mjs",
    "test:v23.1.3": "node --test tests/v23.1.3-uat-fixes.test.mjs",
    "test:v23.1.4": "node --test tests/v23.1.4-uat-fixes.test.mjs",
    "test:v23.1.5": "node --test tests/v23.1.5-home-ack-hotfix.test.mjs",
    "test:v23.1.6": "node --test tests/v23.1.6-uat-comments-intake.test.mjs",
    "provision:v24:dry": "node scripts/provision-v24-saas-service-model.mjs --dry-run",
    "provision:v24": "node scripts/provision-v24-saas-service-model.mjs --apply",
    "validate:v24": "node scripts/validate-v24-config.mjs",
    "test:v24": "node --test tests/v24-service-model.test.mjs",
    "test:v24.1": "node --test tests/v24.1-intake-regressions.test.mjs tests/v24.1-status-sla-config.test.mjs",
    "test:v24.2": "node --test tests/v24.2-ux-config.test.mjs",
    "test:v24.2.1": "node --test tests/v24.2.1-edit-maintenance.test.mjs",
    "test:v24.2.2": "node --test tests/v24.2.2-workflow-alignment.test.mjs",
    "test:v24.2.3": "node --test tests/v24.2.3-workflow-source-truth.test.mjs",
    "migrate:v24.2.3:dry": "node scripts/migrate-suntecgroup-to-v24.2.3-workflows.mjs --workspace=suntecgroup",
    "migrate:v24.2.3": "node scripts/migrate-suntecgroup-to-v24.2.3-workflows.mjs --workspace=suntecgroup --apply",
    "sync:v24.2.3:dry": "node scripts/sync-open-requests-to-v24.2.3-workflows.mjs --workspace=suntecgroup",
    "sync:v24.2.3": "node scripts/sync-open-requests-to-v24.2.3-workflows.mjs --workspace=suntecgroup --apply",
    "test:v24.2.4": "node --test tests/v24.2.4-jira-workflow-source-truth.test.mjs",
    "migrate:v24.2.4:dry": "node scripts/migrate-suntecgroup-to-v24.2.4-jira-workflows.mjs --workspace=suntecgroup",
    "migrate:v24.2.4": "node scripts/migrate-suntecgroup-to-v24.2.4-jira-workflows.mjs --workspace=suntecgroup --apply",
    "sync:v24.2.4:dry": "node scripts/sync-open-requests-to-v24.2.4-workflows.mjs --workspace=suntecgroup",
    "sync:v24.2.4": "node scripts/sync-open-requests-to-v24.2.4-workflows.mjs --workspace=suntecgroup --apply",
    "build:v25:workflows": "node scripts/build-v25-workflows-from-jira.mjs",
    "test:v25": "node --test tests/v25-jira-workflow-source-truth.test.mjs",
    "migrate:v25:dry": "node scripts/migrate-suntecgroup-to-v25-jira-workflows.mjs --workspace=suntecgroup",
    "migrate:v25": "node scripts/migrate-suntecgroup-to-v25-jira-workflows.mjs --workspace=suntecgroup --apply",
    "sync:v25:dry": "node scripts/sync-open-requests-to-v25-workflows.mjs --workspace=suntecgroup",
    "sync:v25": "node scripts/sync-open-requests-to-v25-workflows.mjs --workspace=suntecgroup --apply"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
